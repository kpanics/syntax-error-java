// The programs' own resources (build.rs compiles this with rc.exe): her icon, the name Windows shows for them
// (the taskbar, the task manager). The manifest is not here — build.rs puts it in the loader alone: only the
// program a player opens is asked for administrator, and the game it starts rides along under it.
1 ICON "../icons/recode.ico"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Lunuca"
            VALUE "FileDescription", "Cursed Recode"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "Cursed Recode"
            VALUE "LegalCopyright", "Lunuca"
            VALUE "ProductName", "Cursed Recode"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
