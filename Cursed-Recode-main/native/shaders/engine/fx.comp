        } else if (kind == BOX) {
            vec3 lo3 = s.v[0].xyz;
            vec3 hi3 = s.v[1].xyz;
            vec3 d = vec3(abs(rd.x) < 1e-7 ? 1e-7 : rd.x, abs(rd.y) < 1e-7 ? 1e-7 : rd.y, abs(rd.z) < 1e-7 ? 1e-7 : rd.z);
            vec3 ta = lo3 / d;
            vec3 tb = hi3 / d;
            vec3 tmin = min(ta, tb);
            vec3 tmax = max(ta, tb);
            float tn = max(max(tmin.x, tmin.y), tmin.z);
            float tf = min(min(tmax.x, tmax.y), tmax.z);
            if (tn > tf || tn <= 0.0) {
                continue;
            }
            float sn = seen_at(tn, far, xray);
            if (sn <= 0.0) {
                continue;
            }
            vec3 m = vec3(tmin.x >= tn ? 1.0 : 0.0, tmin.y >= tn && tmin.x < tn ? 1.0 : 0.0, tmin.z >= tn && tmin.x < tn && tmin.y < tn ? 1.0 : 0.0);
            vec3 nrm = -sign(d) * m;
            float fres = pow(1.0 - abs(dot(nrm, rd)), 3.0);
