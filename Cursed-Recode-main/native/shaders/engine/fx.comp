            if (cracks > 0.0) {
                // cracks of light over the face: its cells' borders, each lit as the cracking passes it
                float per = max(s.v[2].w, 1.0);
                vec2 fc = (m.x > 0.5 ? vec2(q.z * sz.z, q.y * sz.y) : m.y > 0.5 ? vec2(q.x * sz.x, q.z * sz.z) : vec2(q.x * sz.x, q.y * sz.y)) * per;
                fc += dot(m, vec3(17.0, 31.0, 53.0)) + (dot(nrm, vec3(1.0)) > 0.0 ? 7.0 : 0.0);
