            float along = mix(s.v[2].w, s.v[3].w, u);
            // the sheet: faint in its middle, brighter toward its edges; streaks flowing back along it
            float body = 0.26 + 0.74 * pow(abs(y), 4.0);
            float flow = glow_k > 0.0 ? 0.5 + 0.5 * sin(along * 5.0 - t_sec * 6.0 + y * 2.0) : 0.5;
            float edge = line_core(1.0 - abs(y), 0.06, pr) * 1.4;
            float fres = pow(1.0 - abs(dn), 2.0);
            lit += k * sn * inside * (kc * (body * (0.7 + 0.6 * flow) * (0.55 + 0.45 * fres)) + mix(kc, vec3(1.0), 0.45) * edge);
        } else if (kind == STAMP) {
            // v[0] its middle and its size, v[1] the way it goes (a unit, level) and how far up and down it lies on
            // what is there, v[2].x 1 for a left foot
            if (!surface) {
                continue;
            }
            vec3 q = scene - s.v[0].xyz;
            float band = s.v[1].w;
            float fade_v = 1.0 - smoothstep(band * 0.5, band, abs(q.y));
            if (fade_v <= 0.0) {
                continue;
            }
            float size = max(s.v[0].w, 1e-3);
            vec2 fw2 = normalize(s.v[1].xz + vec2(1e-6, 0.0));
            vec2 rt2 = vec2(-fw2.y, fw2.x) * (s.v[2].x > 0.5 ? -1.0 : 1.0);
            vec2 lq = vec2(dot(q.xz, rt2), dot(q.xz, fw2)) / size;
            if (dot(lq, lq) > 2.0) {
                continue;
