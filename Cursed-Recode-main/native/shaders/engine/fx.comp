            float y0 = s.v[0].x;
            float y1 = s.v[0].y;
            float t_end = surface ? far : 400.0;
            float ta;
            float tb;
            if (abs(rd.y) < 1e-5) {
                bool in_slab = y0 <= 0.0 && y1 >= 0.0;
                ta = 0.0;
                tb = in_slab ? t_end : 0.0;
            } else {
                float t0 = y0 / rd.y;
                float t1 = y1 / rd.y;
                ta = max(min(t0, t1), 0.0);
                tb = min(max(t0, t1), t_end);
            }
            float len = min(tb - ta, 40.0);
            if (len <= 0.0) {
                continue;
            }
            // thicker low in it; in wisps (at the middle of the way through it, the wind's drift taken off)
            float mid = (ta + tb) * 0.5;
            float hy = clamp((rd.y * mid - y0) / max(y1 - y0, 0.1), 0.0, 1.0);
            vec2 wxz = vec2(CamBlock.xz) + CamFrac.xz + rd.xz * mid - s.v[1].xz;
            float scale_w = max(s.v[1].y, 0.5);
            float wisp = noise2(wxz / scale_w) * 0.65 + noise2(wxz / (scale_w * 0.37) + 17.0) * 0.35;
            float dens = s.v[0].z * (1.15 - hy) * (0.35 + 1.3 * wisp);
