            vec4 r0 = Frames[int(s.v[0].w + 0.5)];
            vec4 r1 = Frames[int(s.v[1].w + 0.5)];
            // the level: the frame's texels across a pixel here
            float px_across = length(uu) / max(t * pa, 1e-6);
            float tex_across = (r0.z - r0.x) * PartsInfo.x;
            float lod = clamp(log2(max(tex_across / max(px_across, 1e-3), 1.0)), 0.0, PartsInfo.z);
            vec2 at = vec2(su, sv);
            vec4 c = textureLod(Parts, mix(r0.xy, r0.zw, at), lod);
            if (s.v[2].w > 0.0) {
