            // a footprint: its sole curving in toward the other foot, its heel behind
            vec2 sp = lq - vec2(0.05 + 0.08 * lq.y, 0.22);
            float sole = length(sp / vec2(0.3, 0.48)) - 1.0;
            float heel = length((lq - vec2(-0.02, -0.5)) / vec2(0.24, 0.26)) - 1.0;
            float d = min(sole * 0.3, heel * 0.24);
            float pf = far * pa / size;
            float edge = 1.0 - smoothstep(0.0, 0.035 + pf * 1.5, abs(d));
            float fill = 1.0 - smoothstep(-pf, pf, d);
            lit += k * fade_v * (mix(kc, vec3(1.0), 0.4) * edge + kc * fill * 0.35 * (glow_k + 0.3));
        } else if (kind == TEXT) {
            // v[0] its top left corner and its atlas x, v[1] the way across (its whole width) and its atlas y, v[2] the way
            // down (its whole height) and its atlas width, v[3].w its atlas height
            if (Spare.x <= 0.0) {
                continue;
            }
            vec3 o = s.v[0].xyz;
            vec3 uu = s.v[1].xyz;
            vec3 vv = s.v[2].xyz;
            vec3 nrm = cross(uu, vv);
            float nl = length(nrm);
            if (nl < 1e-9) {
                continue;
            }
            nrm /= nl;
            float dn = dot(rd, nrm);
            if (abs(dn) < 1e-5) {
                continue;
            }
            float t = dot(o, nrm) / dn;
            if (t <= 0.0) {
                continue;
            }
            float sn = seen_at(t, far, xray);
            if (sn <= 0.0) {
                continue;
            }
            vec3 h = rd * t - o;
            float su = dot(h, uu) / dot(uu, uu);
            float sv = dot(h, vv) / dot(vv, vv);
            if (su < 0.0 || su > 1.0 || sv < 0.0 || sv > 1.0) {
                continue;
            }
            bool page1 = (flags & PAGE1) != 0;
            vec2 apx = vec2(s.v[0].w + su * s.v[2].w, s.v[1].w + sv * s.v[3].w);
            float raw = page1 ? textureLod(Letters1, apx / Spare.zw, 0.0).r : textureLod(Letters0, apx / Spare.xy, 0.0).r;
            // the distance to the letter's edge in atlas px (inside above 0), as the menu reads it
            float d = (raw * 255.0 - 128.0) / 127.0 * 12.0;
            // screen px to an atlas px here
            float kpx = (length(uu) / max(s.v[2].w, 1.0)) / max(t * pa, 1e-6);
            float cov = clamp(0.5 + d * kpx, 0.0, 1.0);
            float g = smoothstep(-12.0, 0.0, d);
