        } else if (kind == SPRITE) {
            vec3 c = s.v[0].xyz;
            float t = dot(c, rd);
            if (t <= 0.05) {
                continue;
            }
            float sn = seen_at(t, far, xray);
            if (sn <= 0.0) {
                continue;
            }
            vec3 o = rd * t - c;
            vec2 q = vec2(dot(o, Right.xyz), dot(o, Up.xyz));
            float size = max(s.v[0].w, 1e-4);
            float rot = s.v[1].y;
            vec2 rq = vec2(cos(rot) * q.x - sin(rot) * q.y, sin(rot) * q.x + cos(rot) * q.y) / size;
            // narrowed across (v[1].z, 0: not): a leaf turned edge on, a flake lying flat seen from the side, a streak
            if (s.v[1].z > 0.0) {
                rq.x /= max(s.v[1].z, 0.06);
            }
            int shp = int(s.v[1].x + 0.5);
            float pf = t * pa / size;
            float a = 0.0;
            if (shp == 1) {
                // a leaf: pointed at both ends, a vein down it
                float e = length(vec2(rq.x * 2.2, rq.y)) + abs(rq.y) * 0.25;
                a = (1.0 - smoothstep(0.85 - pf, 0.95 + pf, e)) * (0.82 + 0.18 * smoothstep(0.02, 0.06 + pf, abs(rq.x)));
            } else if (shp == 2) {
                // a flake: six arms
                float ang = atan(rq.y, rq.x);
                float arms = pow(abs(cos(ang * 3.0)), 10.0);
                float r = length(rq);
                a = exp(-r * 5.0) * 0.6 + arms * (1.0 - smoothstep(0.6, 1.0 + pf, r)) * 0.8;
            } else if (shp == 3) {
                // an ember: a hot core, its glow
                float r2 = dot(rq, rq);
                a = exp(-r2 * 9.0) * 1.4 + exp(-r2 * 1.6) * 0.35;
            } else if (shp == 4) {
                // a puff of dust: soft, thinning to its edge
                float r2 = dot(rq, rq);
                a = exp(-r2 * 2.6) * 0.75;
            } else if ((flags & SOLID) != 0) {
                // a grain: a little round thing, its edge sharp
                a = 1.0 - smoothstep(0.82 - pf, 0.9 + pf, length(rq));
            } else {
                float r2 = dot(rq, rq);
                a = exp(-r2 * 3.5);
            }
            // smaller than a pixel: its light kept, spread over the pixel
            float small = clamp(1.0 / max(pf, 1.0), 0.0, 1.0);
            if ((flags & SOLID) != 0) {
                // lit from above as a little round thing is
                float shade = shp == 4 ? 1.0 + 0.15 * clamp(rq.y, -1.0, 1.0) : 0.7 + 0.6 * clamp(rq.y * 0.8 + 0.4, 0.0, 1.0);
                float cov = clamp(k * sn * a * mix(small, 1.0, small), 0.0, 1.0);
                over = vec4(over.rgb * (1.0 - cov) + kc * shade * cov, over.a + cov * (1.0 - over.a));
            } else {
                lit += k * sn * kc * a * mix(small, 1.0, small);
            }
        }
    }

    if (dot(warp, warp) > 1e-12) {
        col = to_linear(textureLod(Scene, uv + warp, 0.0).rgb);
    }
    if (glass_a > 0.0) {
        col = mix(col, glass, glass_a);
    }
    // matter lit as what is behind it is (dust at night as dark as the night)
    float behind_light = clamp(dot(col, vec3(0.2126, 0.7152, 0.0722)) * 2.6 + 0.05, 0.08, 1.1);
    col = col * (1.0 - over.a) + over.rgb * behind_light;
    col = col * (1.0 - part.a) + part.rgb;
    if (!blurred && glass_a <= 0.0 && dot(lit, lit) <= 1e-8 && rim <= 1e-4 && dot(warp, warp) <= 1e-12 && over.a <= 1e-4 && part.a <= 1e-4) {
        return;
    }
    col *= 1.0 - 0.38 * rim;
    col += lit;
    imageStore(Canvas, px, vec4(to_srgb(min(col, vec3(1.0))), c4.a));
}
