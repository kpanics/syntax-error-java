                rgb = Recolour.rgb * max(rgb.r, max(rgb.g, rgb.b));
            }
            if ((flags & PART_SATURATE) != 0) {
                rgb = min(rgb, vec3(1.0));
            }
            float a = c.a;
            if ((flags & PART_REMAP) != 0) {
                a = smoothstep(s.v[3].z, s.v[3].w, a);
            }
            a *= k;
            if ((flags & PART_TRAIL) != 0) {
                rgb *= mix(vec3(1.0), unpacked(s.v[3].z), sv);
                a *= mix(1.0, s.v[3].w, sv);
            }
            a = clamp(a * sn, 0.0, 1.0);
            if ((flags & PART_ADD) != 0) {
                lit += rgb * a;
            } else {
                part = vec4(rgb * a + part.rgb * (1.0 - a), a + part.a * (1.0 - a));
            }
        } else if (kind == BLUR) {
            // v[0].x how long the shutter is (of a 60th of a second), y how many samples, z 1: only the turn (the
            // camera's move left out), w the longest smear (of the frame's width)
            if (Motion.w <= 0.0) {
                continue;
            }
            vec3 pw = surface ? scene : rd * 2000.0;
            vec3 was = pw + (s.v[0].z > 0.5 ? vec3(0.0) : Motion.xyz);
            vec4 pc = PrevViewProj * vec4(was, 1.0);
            if (pc.w <= 0.05) {
                continue;
            }
            vec2 puv = pc.xy / pc.w * 0.5 + 0.5;
            vec2 vel = (uv - puv) * s.v[0].x * Motion.w * k;
            float vl = length(vel * Info.zw);
            float most = s.v[0].w * Info.z;
            if (vl > most) {
                vel *= most / vl;
                vl = most;
            }
            if (vl < 0.75) {
                continue;
            }
            int n = int(clamp(s.v[0].y, 4.0, 32.0));
            vec3 acc = vec3(0.0);
            // along the smear, centred on the pixel, a little jittered (no bands)
            float jit = hash12(vec2(px) + fract(t_sec) * 37.0);
            for (int i = 0; i < n; i++) {
                float f = (float(i) + jit) / float(n) - 0.5;
