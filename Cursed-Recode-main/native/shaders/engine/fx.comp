            lit += k * sn * add;
        } else if (kind == RIBBON) {
            // v[0] its start and its half-width there, v[1] its end and its half-width there, v[2] the way across (a
            // unit) and how far along the whole ribbon its start is, v[3].w how far its end is (blocks)
            vec3 p0 = s.v[0].xyz;
            vec3 ax = s.v[1].xyz - p0;
            vec3 dv = s.v[2].xyz;
            vec3 nrm = cross(ax, dv);
            float nl = length(nrm);
            if (nl < 1e-7) {
                continue;
            }
            nrm /= nl;
            float dn = dot(rd, nrm);
            if (abs(dn) < 1e-5) {
                continue;
            }
            float t = dot(p0, nrm) / dn;
            if (t <= 0.0) {
                continue;
            }
            float sn = seen_at(t, far, xray);
            if (sn <= 0.0) {
                continue;
            }
            vec3 h = rd * t - p0;
            float a11 = dot(ax, ax);
            float a12 = dot(ax, dv);
            float b1 = dot(h, ax);
            float b2 = dot(h, dv);
            float det = a11 - a12 * a12;
            if (det < 1e-9) {
                continue;
            }
            float u = (b1 - a12 * b2) / det;
            if (u < 0.0 || u > 1.0) {
                continue;
            }
            float hw = max(mix(s.v[0].w, s.v[1].w, u), 1e-4);
            float pf = t * pa;
            float y = ((a11 * b2 - a12 * b1) / det) / hw;
            float pr = pf / hw;
            float inside = 1.0 - smoothstep(1.0 - pr, 1.0 + pr, abs(y));
            if (inside <= 0.0) {
                continue;
