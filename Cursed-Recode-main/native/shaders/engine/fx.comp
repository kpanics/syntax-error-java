            rim = max(rim, min(k, 1.0) * sn * (1.0 - cov) * smoothstep(-7.0, -0.5, d));
        } else if (kind == PART) {
            if (PartsInfo.w <= 0.0) {
                continue;
            }
            vec3 o = s.v[0].xyz;
            vec3 uu = s.v[1].xyz;
            vec3 vv = s.v[2].xyz;
            vec3 nrm = cross(uu, vv);
            float nl = length(nrm);
            if (nl < 1e-12) {
                continue;
            }
            nrm /= nl;
            float dn = dot(rd, nrm);
            if (abs(dn) < 1e-6) {
                continue;
            }
            float t = dot(o, nrm) / dn;
            if (t <= 0.02) {
                continue;
            }
            vec3 h = rd * t - o;
            float su = dot(h, uu) / dot(uu, uu);
            float sv = dot(h, vv) / dot(vv, vv);
            if (su < 0.0 || su > 1.0 || sv < 0.0 || sv > 1.0) {
                continue;
            }
            float sn = seen_at(t, far, false);
