            vec3 sz = max(hi3 - lo3, vec3(1e-4));
            vec3 q = (rd * tn - lo3) / sz;
            float level = s.v[2].x;
            if (level > 0.0) {
                // a fill rising: up the sides, then over the top from its edges in (v[1].w its light, v[2].y its
                // edge's)
                float h = m.y > 0.5 ? (nrm.y > 0.0 ? 0.75 + 0.25 * (1.0 - 2.0 * max(abs(q.x - 0.5), abs(q.z - 0.5))) : 0.0) : 0.75 * q.y;
                float filled = 1.0 - smoothstep(level - 0.012, level + 0.012, h);
                float edge = (h - level) / 0.03;
