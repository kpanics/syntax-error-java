#version 450
// The glow of glowing blocks (engine/upscale.rs): lava, glowstone, torches, lanterns light the air round them on
// screen. Opaque terrain marks how much each pixel glows in the picture's alpha (terrain.fsh: 1 none, 0.5 down to 0
// from barely to full; what is blended over it — clouds, water — only raises the alpha, so it never glows).
// Mode 0 takes the glowing part of the picture at half its size; 1 halves a level into the next; 2 adds the next,
// smoothed, back into a level. The frames put together add the first level in (taa.comp).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D Source;
layout(set = 0, binding = 1) uniform sampler2D Depth;
layout(set = 0, binding = 2, rgba16f) uniform image2D Level;

layout(push_constant) uniform Step {
    // x: the mode; y, z: this level's size.
    ivec4 Info;
};

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= Info.y || q.y >= Info.z) {
        return;
    }
    vec2 size = vec2(Info.yz);
    vec2 uv = (vec2(q) + 0.5) / size;
    if (Info.x == 0) {
        // The 2x2 of the picture under this texel: how much of it glows, and how bright that is.
        vec3 sum = vec3(0.0);
        vec2 texel = 1.0 / vec2(textureSize(Source, 0));
        for (int i = 0; i < 4; i++) {
            vec2 at = uv + (vec2(i & 1, i >> 1) - 0.5) * texel;
            vec4 c = textureLod(Source, at, 0.0);
            float z = textureLod(Depth, at, 0.0).r;
            float glows = z > 0.0 && c.a < 0.5 ? clamp(1.0 - c.a * 2.0, 0.0, 1.0) : 0.0;
            sum += c.rgb * c.rgb * glows;
        }
        imageStore(Level, q, vec4(sum * 0.25, 1.0));
    } else if (Info.x == 1) {
        // Four taps of the level above, each the mean of a 2x2: a smooth half.
        vec2 texel = 1.0 / vec2(textureSize(Source, 0));
        vec3 c = textureLod(Source, uv + vec2(-1.0, -1.0) * texel, 0.0).rgb
               + textureLod(Source, uv + vec2(1.0, -1.0) * texel, 0.0).rgb
               + textureLod(Source, uv + vec2(-1.0, 1.0) * texel, 0.0).rgb
               + textureLod(Source, uv + vec2(1.0, 1.0) * texel, 0.0).rgb;
        imageStore(Level, q, vec4(c * 0.25, 1.0));
    } else {
        // The smaller level, spread with a tent of nine taps, added to this one.
        vec2 texel = 1.0 / vec2(textureSize(Source, 0));
        vec3 c = textureLod(Source, uv, 0.0).rgb * 4.0;
        c += (textureLod(Source, uv + vec2(texel.x, 0.0), 0.0).rgb + textureLod(Source, uv - vec2(texel.x, 0.0), 0.0).rgb
            + textureLod(Source, uv + vec2(0.0, texel.y), 0.0).rgb + textureLod(Source, uv - vec2(0.0, texel.y), 0.0).rgb) * 2.0;
        c += textureLod(Source, uv + texel, 0.0).rgb + textureLod(Source, uv - texel, 0.0).rgb
           + textureLod(Source, uv + vec2(texel.x, -texel.y), 0.0).rgb + textureLod(Source, uv + vec2(-texel.x, texel.y), 0.0).rgb;
        vec3 here = imageLoad(Level, q).rgb;
        imageStore(Level, q, vec4(here + c / 16.0, 1.0));
    }
}
