#version 450
// Hitboxes (engine/hitboxes.rs, the menu's module "hitboxes"; the game's F3+B shows them so too): the boxes of what is
// round the player, the client's way.
//   Box: its twelve edges lines of light (a core as thick as it is, never thinner than a pixel's worth of light: a far
//     one is fainter, not thicker; a glow round it), a light running along each, the ones behind the box's own front
//     fainter (it reads as a box, not a tangle); a touch of its colour on the faces.
//   Corners: only its corners, each three strokes of light out along its edges, a lamp at the corner.
//   Glass: the faces glass the world bends through (what is behind shifted by the face's slope, more the thicker the
//     glass is there), tinted by its colour, brighter at a grazing look, a light caught and a sheen crossing it; its
//     edges lines of light.
// For each: the eyes' height as a line round the box, the eyes' look as a ray out of them (narrowing, a light going
// out along it, a lamp at its end); a flash when it is hit, brighter when aimed at; fading in and out. All of it hidden
// where the level is nearer (never through a wall).
// Over a copy of the frame's rectangle that holds all of it (Rect), laid back after; the frame itself read for what the
// glass bends. Each group of 8 by 8 pixels first keeps the boxes whose rectangle reaches it.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform image2D Canvas;
layout(set = 0, binding = 1) uniform sampler2D Depth;
layout(set = 0, binding = 2) uniform sampler2D Scene;
layout(std140, set = 0, binding = 3) uniform U {
    mat4 ViewProj;
    mat4 InvViewProj;
    // x seconds, y how many boxes, z the frame's width, w its height
    vec4 Info;
    // the rectangle drawn: lowest pixel x, y, past the highest
    ivec4 Rect;
    // x pixels a block is at a block's distance, y the style (0 Box, 1 Corners, 2 Glass), z the line's width, w the glow
    vec4 Look;
    // x the faces' fill, y the running light's speed (0 none), z the back edges shown (1), w the corners' length (of an
    // edge)
    vec4 More;
    // the glass: x its tint, y how much it bends, z its shine, w its edges' strength
    vec4 Glass;
    // the eyes' line: its colour, w 1 shown
    vec4 EyeCol;
    // the eyes' ray: its colour, w its length (0 none)
    vec4 LookCol;
    // xyz the way the camera looks, w the corners' lamps (1)
    vec4 Forward;
    // x the glass frosted (1), y the one aimed at brighter (1)
    vec4 Extra;
    vec4 Spare;
    // the boxes, five each: lowest corner (from the camera) and how far in (alpha), highest corner and its flash, its
    // colour and whether aimed at, its look (a unit) and its eyes' height, its rectangle on the frame (pixels)
    vec4 Boxes[128 * 5];
};
layout(push_constant) uniform P {
    int Stage;
};

const uint MOST = 128u;
const uint KEEP = 32u;
// a line's core radius in blocks at a line width of 1
const float CORE = 0.0082;

shared uint kept;
shared uint keep[KEEP];

vec3 to_linear(vec3 c) {
    return pow(max(c, 0.0), vec3(2.2));
}

vec3 to_srgb(vec3 c) {
    return pow(max(c, 0.0), vec3(1.0 / 2.2));
}

vec3 ray_at(vec2 px, float dz) {
    vec2 uv = px / Info.zw;
    vec4 wp = InvViewProj * vec4(uv * 2.0 - 1.0, max(dz, 1e-7), 1.0);
    return wp.xyz / wp.w;
}

// The ray from the camera along `rd` and the segment a..b: how far apart at their nearest (blocks), how far along the
// ray (t), where along the segment (u, 0..1).
float apart(vec3 rd, vec3 a, vec3 b, out float t, out float u) {
    vec3 ab = b - a;
    float e = dot(ab, ab);
    float k = dot(rd, ab);
    float c = dot(rd, a);
    float f = dot(ab, a);
    float den = e - k * k;
    u = den > 1e-9 ? clamp((c * k - f) / den, 0.0, 1.0) : 0.0;
    t = max(c + u * k, 0.0);
    u = e > 1e-12 ? clamp((t * k - f) / e, 0.0, 1.0) : 0.0;
    vec3 q = a + ab * u;
    t = max(dot(q, rd), 0.0);
    return length(rd * t - q);
}

// The ray and a box (lo..hi, from the camera): where it enters and leaves (tn > tf: it misses), the way out of the face
// it enters by.
void box_hit(vec3 rd, vec3 lo, vec3 hi, out float tn, out float tf, out vec3 n) {
    vec3 d = vec3(abs(rd.x) < 1e-7 ? 1e-7 : rd.x, abs(rd.y) < 1e-7 ? 1e-7 : rd.y, abs(rd.z) < 1e-7 ? 1e-7 : rd.z);
    vec3 t0 = lo / d;
    vec3 t1 = hi / d;
    vec3 a = min(t0, t1);
    vec3 b = max(t0, t1);
    tn = max(max(a.x, a.y), a.z);
    tf = min(min(b.x, b.y), b.z);
    vec3 m = vec3(a.x >= tn ? 1.0 : 0.0, a.y >= tn && a.x < tn ? 1.0 : 0.0, a.z >= tn && a.x < tn && a.y < tn ? 1.0 : 0.0);
    n = -sign(d) * m;
}

// The light of one segment at this pixel, added to `lit` in `col`: `r` its core radius as made (blocks) at a, `taper`
// what of it is left at b, `pa` a pixel's width at a block's distance, `far` where the level is along the ray, `front`
// where the ray enters this box (the segment behind it is a back edge), `run` the running light's place along it (-1
// none).
void segment(vec3 rd, vec3 a, vec3 b, float r, float taper, float pa, float far, float front, float back_k, float run, vec3 col, float bright,
             inout vec3 lit) {
    float t, u;
    float d = apart(rd, a, b, t, u);
    r *= mix(1.0, taper, u);
    float px = max(t, 0.05) * pa;
    float rc = max(r, px * 0.75);
    float reach = rc * (2.5 + 5.0 * Look.w) + px * 2.0;
    if (d > reach) {
        return;
    }
    // hidden where the level is nearer
    float seen = 1.0 - smoothstep(far - 0.03, far + 0.14, t);
    if (seen <= 0.0) {
        return;
    }
    // behind the box's own front: a back edge, fainter (none when they are not shown)
    if (t > front + 0.025) {
        seen *= back_k;
    }
    float k = bright * seen;
    // a light running along it
    float pulse = 0.0;
    if (run >= 0.0) {
        float x = fract(u - run) - 0.5;
        pulse = exp(-x * x * 140.0);
    }
    float core = (r / rc) * (1.0 - smoothstep(rc - px * 0.5, rc + px * 0.5, d)) * (1.0 + 2.4 * pulse);
    float g = d / (rc * (1.0 + 2.2 * Look.w) + px * 1.5);
    float glow = Look.w * (0.2 * exp(-g * g * 1.6) + 0.04 * exp(-d / (rc * 5.0 + px * 3.0))) * (1.0 + 3.2 * pulse);
    lit += k * (mix(col, vec3(1.0), 0.55) * core + col * glow);
}

void main() {
    uint li = gl_LocalInvocationIndex;
    if (li == 0u) {
        kept = 0u;
    }
    barrier();
    vec2 lo = vec2(Rect.xy + ivec2(gl_WorkGroupID.xy * 8u));
    vec2 hi = lo + 8.0;
    uint n = min(uint(Info.y), MOST);
    for (uint i = li; i < n; i += 64u) {
        vec4 r = Boxes[i * 5u + 4u];
        if (r.x < hi.x && r.z > lo.x && r.y < hi.y && r.w > lo.y && Boxes[i * 5u].w > 0.002) {
            uint at = atomicAdd(kept, 1u);
            if (at < KEEP) {
                keep[at] = i;
            }
        }
    }
    barrier();

    ivec2 px = Rect.xy + ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= Rect.z || px.y >= Rect.w) {
        return;
    }
    uint count = min(kept, KEEP);
    if (count == 0u) {
        return;
    }
    vec2 uv = (vec2(px) + 0.5) / Info.zw;
    // (the level's depth, maybe smaller than the frame: World resolution; 0 the sky)
    float dz = textureLod(Depth, uv, 0.0).r;
    vec3 scene = ray_at(vec2(px) + 0.5, dz);
    float far = dz <= 0.0 ? 1e6 : length(scene);
    vec3 rd = normalize(dz <= 0.0 ? ray_at(vec2(px) + 0.5, 0.5) : scene);
    float pa = length(normalize(ray_at(vec2(px) + vec2(1.5, 0.5), 0.5)) - normalize(ray_at(vec2(px) + 0.5, 0.5)));
    float t_sec = Info.x;
    int style = int(Look.y + 0.5);
    float back_k = More.z > 0.5 ? 0.3 : 0.0;

    vec4 c4 = imageLoad(Canvas, px);
    vec3 col = to_linear(c4.rgb);
    vec3 lit = vec3(0.0);
    // the glass's nearest face over this pixel, drawn once under the lines
    float glass_t = 1e9;
    vec3 glass = vec3(0.0);
    float glass_a = 0.0;

    for (uint j = 0u; j < count; j++) {
        uint i = keep[j];
        vec4 b0 = Boxes[i * 5u];
        vec4 b1 = Boxes[i * 5u + 1u];
        vec4 b2 = Boxes[i * 5u + 2u];
        vec4 b3 = Boxes[i * 5u + 3u];
        float alpha = b0.w;
        float flash = b1.w;
        vec3 kc = b2.rgb;
        float aimed = b2.w * Extra.y;
        // a flash swells it a touch
        vec3 size = b1.xyz - b0.xyz;
        float big = max(max(size.x, size.y), size.z);
        vec3 grow = vec3(flash * 0.035 * big);
        vec3 bl = b0.xyz - grow;
        vec3 bh = b1.xyz + grow;
        float bright = alpha * (1.0 + 1.6 * flash) * (1.0 + 0.6 * aimed);
        kc = mix(kc, vec3(1.0), 0.5 * flash);
        float r = CORE * Look.z * (1.0 + 0.25 * aimed) * clamp(big / 1.8, 0.35, 1.8);

        float tn, tf;
        vec3 nrm;
        box_hit(rd, bl, bh, tn, tf, nrm);
        bool hit = tn <= tf && tf > 0.0;
        float front = hit ? max(tn, 0.0) : 1e9;
        bool face_seen = hit && tn > 0.0 && tn < far;

        // the faces: a touch of its colour (Box, Corners), or glass
        if (face_seen) {
            float cosv = abs(dot(nrm, rd));
            float fres = pow(1.0 - cosv, 4.0);
            if (style == 2) {
                if (tn < glass_t) {
                    glass_t = tn;
                    vec3 at = rd * tn;
                    float thick = clamp((min(tf, far) - tn) / max(big, 0.3), 0.0, 1.5);
                    // what is behind, shifted by the face's slope as it is seen (and the more the thicker)
                    vec4 cn = ViewProj * vec4(at + nrm * 0.25, 1.0);
                    vec4 ca = ViewProj * vec4(at, 1.0);
                    vec2 dir = cn.w > 0.05 && ca.w > 0.05 ? (cn.xy / cn.w - ca.xy / ca.w) : vec2(0.0);
                    float l = length(dir);
                    dir = l > 1e-5 ? dir / l : vec2(0.0);
                    vec2 shift = dir * Glass.y * (0.006 + 0.012 * thick) * (0.4 + 0.6 * (1.0 - cosv));
                    vec3 behind;
                    if (Extra.x > 0.5) {
                        // frosted: what is behind softened
                        vec2 s = vec2(2.5) / Info.zw * (1.0 + 2.0 * thick);
                        behind = 0.25 * (textureLod(Scene, uv + shift + vec2(s.x, s.y), 0.0).rgb + textureLod(Scene, uv + shift + vec2(-s.x, s.y), 0.0).rgb
                            + textureLod(Scene, uv + shift + vec2(s.x, -s.y), 0.0).rgb + textureLod(Scene, uv + shift + vec2(-s.x, -s.y), 0.0).rgb);
                    } else {
                        behind = textureLod(Scene, uv + shift, 0.0).rgb;
                    }
                    vec3 g = to_linear(behind) * mix(vec3(1.0), kc * 1.15, Glass.x * (0.55 + 0.45 * min(thick, 1.0)));
                    // brighter at a grazing look, a light caught, a sheen crossing it
                    vec3 L = normalize(vec3(0.35, 0.85, 0.25));
                    float spec = pow(max(dot(reflect(rd, nrm), L), 0.0), 70.0);
                    float x = fract(dot(at, vec3(0.55, 0.35, 0.25)) * 0.8 - t_sec * 0.22) - 0.5;
                    float sheen = exp(-x * x * 160.0);
                    g += kc * (0.08 + 0.75 * fres) * Glass.z + vec3(spec * 1.4 + sheen * 0.12) * Glass.z;
                    glass = g;
                    glass_a = alpha;
                }
            } else if (More.x > 0.0) {
                lit += kc * More.x * (0.05 + 0.35 * fres) * alpha;
            }
        }

        // the edges, or the corners
        float run_base = More.y > 0.0 ? t_sec * More.y * 0.55 : -1e9;
        float edge_k = style == 2 ? Glass.w * 0.7 : 1.0;
        vec3 c[8];
        for (int k = 0; k < 8; k++) {
            c[k] = vec3((k & 1) == 1 ? bh.x : bl.x, (k & 2) == 2 ? bh.y : bl.y, (k & 4) == 4 ? bh.z : bl.z);
        }
        // the ray misses the box grown by its lines' reach: no edge of it to look at here
        float tm = max(length((bl + bh) * 0.5), 0.05);
        float m = r * (3.5 + 6.0 * Look.w) + tm * pa * 3.0 + 0.02;
        float mn, mf;
        vec3 mnrm;
        box_hit(rd, bl - m, bh + m, mn, mf, mnrm);
        bool near_box = mn <= mf && mf > 0.0;
        if (style != 1 && near_box) {
            for (int e = 0; e < 12; e++) {
                int axis = e >> 2;
                int rest = e & 3;
                // the corner with bit `axis` clear, its other bits from `rest`
                int lo_bit = axis == 0 ? (rest << 1) : (axis == 1 ? ((rest & 1) | ((rest & 2) << 1)) : rest);
                int a = lo_bit;
                int bb = lo_bit | (1 << axis);
                float run = More.y > 0.0 ? fract(run_base + float(e) * 0.37) : -1.0;
                segment(rd, c[a], c[bb], r, 1.0, pa, far, front, back_k, run, kc, bright * edge_k, lit);
            }
        } else {
            float f = More.w * (1.0 + 0.06 * sin(t_sec * 2.4 + float(i)));
            float stroke = f * big + r * 3.0;
            for (int k = 0; k < 8; k++) {
                // a corner whose strokes and glow cannot reach this pixel: none of it to look at
                float tc = max(dot(c[k], rd), 0.05);
                float rc = max(r * 1.45, tc * pa * 0.75);
                if (length(c[k] - rd * tc) > stroke + rc * (2.5 + 5.0 * Look.w) + tc * pa * 2.0) {
                    continue;
                }
                for (int ax = 0; ax < 3; ax++) {
                    vec3 other = c[k ^ (1 << ax)];
                    vec3 end = c[k] + (other - c[k]) * f;
                    float run = More.y > 0.0 ? fract(run_base * 0.8 + float(k) * 0.29) : -1.0;
                    segment(rd, c[k], end, r * 1.15, 1.0, pa, far, front, back_k, run, kc, bright, lit);
                }
                if (Forward.w > 0.5) {
                    // the corner's lamp
                    segment(rd, c[k], c[k], r * 1.45, 1.0, pa, far, front, back_k, -1.0, kc, bright * 0.55, lit);
                }
            }
        }

        // the eyes: their height round the box, their look out of them
        float eye = b3.w;
        if (EyeCol.w > 0.5 && near_box && eye > bl.y && eye < bh.y) {
            float o = 0.012 + r;
            vec3 e0 = vec3(bl.x - o, eye, bl.z - o);
            vec3 e1 = vec3(bh.x + o, eye, bl.z - o);
            vec3 e2 = vec3(bh.x + o, eye, bh.z + o);
            vec3 e3 = vec3(bl.x - o, eye, bh.z + o);
            vec3 ec = EyeCol.rgb;
            segment(rd, e0, e1, r * 0.7, 1.0, pa, far, front, back_k, -1.0, ec, bright * 0.8, lit);
            segment(rd, e1, e2, r * 0.7, 1.0, pa, far, front, back_k, -1.0, ec, bright * 0.8, lit);
            segment(rd, e2, e3, r * 0.7, 1.0, pa, far, front, back_k, -1.0, ec, bright * 0.8, lit);
            segment(rd, e3, e0, r * 0.7, 1.0, pa, far, front, back_k, -1.0, ec, bright * 0.8, lit);
        }
        if (LookCol.w > 0.0 && eye >= bl.y) {
            vec3 from = vec3((bl.x + bh.x) * 0.5, eye, (bl.z + bh.z) * 0.5);
            vec3 to = from + b3.xyz * LookCol.w;
            // narrowing out of the eyes, a light going out along it, a lamp at its end
            vec3 lc = LookCol.rgb;
            float go = fract(t_sec * 0.8 + float(i) * 0.13);
            segment(rd, from, to, r * 0.95, 0.4, pa, far, 1e9, 1.0, go, lc, bright * 0.9, lit);
            segment(rd, to, to, r * 1.5, 1.0, pa, far, 1e9, 1.0, -1.0, lc, bright * 0.8, lit);
        }
    }

    if (glass_a > 0.0) {
        col = mix(col, glass, glass_a);
    }
    if (glass_a <= 0.0 && dot(lit, lit) <= 1e-8) {
        return;
    }
    col += lit;
    imageStore(Canvas, px, vec4(to_srgb(min(col, vec3(1.0))), c4.a));
}
