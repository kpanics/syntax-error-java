#version 450
// The chams' ink laid over the frame (engine/ink.rs): the half-size picture of it (ink_draw.comp) brought up to the
// frame's size, each pixel taking the half-size pixels whose depth is like its own (the ink stops sharp at a body's or a
// block's edge, not smeared over it), then the world behind dimmed by the ink and its light added.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8) uniform image2D Frame;
layout(set = 0, binding = 1) uniform sampler2D InkPic;
layout(set = 0, binding = 2) uniform sampler2D Depth;
// the specks' strokes: their darkness per pixel of the frame, 4096 to one (ink_part.comp)
layout(std430, set = 0, binding = 3) readonly buffer Splat {
    uint splat[];
};
// which tiles of the frame (8 by 8 pixels) a brick with ink covers (ink_part.comp stage 4): elsewhere the picture of the
// ink is empty, and only the threads are laid over
layout(std430, set = 0, binding = 4) readonly buffer Tiles {
    uint tiles[];
};

layout(push_constant) uniform Sizes {
    // the frame's size (xy), the ink picture's (zw)
    ivec4 S;
    // how much light a block of ink at 1 takes out, per colour (the dye's); the dye against the one it was made with
    vec4 Takes;
    vec4 Tint;
};

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, S.xy))) {
        return;
    }
    vec2 uv = (vec2(px) + 0.5) / vec2(S.xy);
    vec4 ink = vec4(0.0);
    // the picture of the ink is empty in a tile no brick with ink covers (at half the frame's size too: the tiles reach
    // three pixels round what the bricks cover)
    if (tiles[(px.y >> 3) * ((S.x + 7) >> 3) + (px.x >> 3)] != 0u || S.z < 0) {
        float here = textureLod(Depth, uv, 0.0).r;
        // the four ink pixels round this one, weighed by how far and how alike their depth is
        vec2 f = uv * vec2(S.zw) - 0.5;
        vec2 base = floor(f);
        vec2 w = f - base;
        vec4 sum = vec4(0.0);
        float total = 0.0;
        for (int k = 0; k < 4; k++) {
            vec2 o = vec2(k & 1, k >> 1);
            vec2 q = (base + o + 0.5) / vec2(S.zw);
            float bw = (o.x > 0.5 ? w.x : 1.0 - w.x) * (o.y > 0.5 ? w.y : 1.0 - w.y);
            float dq = textureLod(Depth, q, 0.0).r;
            // reversed depth: compare as distance (1/z)
            float a = 1.0 / max(here, 1e-7);
            float b = 1.0 / max(dq, 1e-7);
            float alike = exp(-abs(a - b) / max(a, b) * 24.0);
            float wt = bw * alike + 1e-4 * bw;
            sum += textureLod(InkPic, q, 0.0) * wt;
            total += wt;
        }
        ink = sum / max(total, 1e-6);
    }
    if (S.z < 0) {
        // dev (CURSED_DEV_INKDEBUG=2): the frame red where this pass reaches
        vec4 c0 = imageLoad(Frame, px);
        imageStore(Frame, px, vec4(1.0, c0.g * 0.3, c0.b * 0.3, 1.0));
        return;
    }
    float threads = float(splat[px.y * S.x + px.x]) / 4096.0;
    if (S.w < 0) {
        // dev (CURSED_DEV_INKDEBUG=3): the specks' threads alone
        ink = vec4(0.0);
    }
    if (ink.a < 1e-4 && dot(ink.rgb, vec3(1.0)) < 1e-5 && threads <= 0.0) {
        return;
    }
    vec4 c = imageLoad(Frame, px);
    // the threads take the light as the ink does (their darkness is its blue's), a hint of blue left where they are thin
    vec3 through = exp(-Takes.rgb * ink.a - (Takes.rgb / max(max(Takes.r, Takes.g), Takes.b) * 1.79) * threads);
    vec3 thin = vec3(0.012, 0.018, 0.04) * Tint.rgb * (1.0 - exp(-threads * 0.6));
    imageStore(Frame, px, vec4(c.rgb * through + ink.rgb + thin, c.a));
}
