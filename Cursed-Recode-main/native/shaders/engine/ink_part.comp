#version 450
// The chams' ink's threads (engine/ink.rs): the grid (ink_sim.comp) is too coarse for ink's finest detail, so tracer
// specks are carried by its flow — let go where the ink comes out (pores on the bodies, their hands), each living a few
// seconds. The specks let go one after another from one source make a thread (a streak line): each knows the one let go
// before it, and a line is drawn between the two, its darkness added into a buffer the size of the frame
// (ink_comp.comp takes it over the world). A speck's ink is spread along its piece of the line: where the flow draws a
// thread out it grows thin and pale, where it bunches up, dark. The stage is the push constant:
//  0 let new ones go (serials Emit.x.. Emit.x + Emit.y; a speck's place is its serial round the ring), each linked to
//    the one let go before it from the same source;
//  1 carried along the flow (RK2) and the water's own fine swirls, pushed out of its source at first, sinking (ink is
//    heavier than water), sliding along blocks, older;
//  2 drawn: the curve through the one before it — a strand a centimetre thick when new, spreading as dye does in water (wider,
//    paler: as much ink across) as it ages, as wide as that is on the screen, soft across — behind nothing nearer (the
//    world's depth); the hands' strands darker than the pores';
//  3 each source's last speck noted (the next frame's first links to it);
//  4 the tiles of the frame the bricks with ink cover (each brick's box on the screen, cut at the near plane where it
//    reaches behind the camera): where none is, the ray meets no ink and is not cast (ink_draw.comp).

layout(local_size_x = 256) in;

struct Speck {
    // where (world cells), its age in seconds (below 0: none)
    vec4 pos;
    // how long it lives (w)
    vec4 life;
    // how it was pushed out (cells a second, fading), how fast it sinks (cells a second)
    vec4 push;
    // the serial of the one before it on its thread, its own serial, its source
    uvec4 link;
};

layout(std430, set = 0, binding = 0) buffer Specks {
    Speck specks[];
};
layout(set = 0, binding = 1) uniform sampler3D VelIn;
layout(set = 0, binding = 2) uniform usampler2DArray CursedVoxels;
layout(set = 0, binding = 3) uniform sampler2D Depth;
layout(std430, set = 0, binding = 4) buffer Splat {
    uint splat[];
};

struct Body {
    vec4 feet;
    vec4 vel;
    vec4 handA;
    vec4 handB;
    // where the feet and the hands were the frame before (the specks of a frame are let go along the way between)
    vec4 feetFrom;
    // how much its hands let go (w: 0 a mob's), how wide it is against a player (handBFrom.w)
    vec4 handAFrom;
    vec4 handBFrom;
};

layout(std140, set = 0, binding = 5) uniform Part {
    // round the camera (blocks) to clip space, the frame as drawn
    mat4 ViewProj;
    // the camera (world cells), seconds
    vec4 Camera;
    // the grid's world origin (cells)
    ivec4 Origin;
    // the voxel window: its lowest block (xyz), width; its height
    ivec4 Window;
    ivec4 WindowSize;
    // the first serial to let go (its bits), how many, how many places (a power of two), how many bodies
    ivec4 Emit;
    // the frame's size (xy)
    ivec4 Sizes;
    // the frame's time (seconds, x), its number (y), how dark the threads (z: 1 as made)
    vec4 Step;
    Body Bodies[8];
};

// each source's last serial (stage 3 writes it, stage 0 reads it the next frame); ~0 none yet
layout(std430, set = 0, binding = 6) buffer Last {
    uint last[];
};
// the curl of a gradient noise repeating every 8 of its lattice (xyz; ink_sim.comp stage 9)
layout(set = 0, binding = 7) uniform sampler3D Noise;
// the most ink in each brick (ink_sim.comp stage 8), and which tiles of the frame (8 by 8 pixels) a brick with ink
// covers: the ray is cast there alone (stage 4)
layout(set = 0, binding = 8) uniform sampler3D Bricks;
layout(std430, set = 0, binding = 9) buffer Tiles {
    uint tiles[];
};

layout(push_constant) uniform Stage {
    int stage;
};

const ivec3 SIZE = ivec3(128, 64, 128);
const vec3 SIZEF = vec3(SIZE);
const float B = 16.0;

uint hashu(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float rnd(uint i, uint salt) {
    return float(hashu(i * 9781u + salt * 6271u + 1u) & 0xFFFFFFu) / 16777215.0;
}

// Where ink comes out of a body: its hands (sources 0..15, half each, a little apart round the hand: a bundle of
// threads dripping off it) and pores over its trunk, each open a few seconds, then another somewhere else.
const uint HANDS = 16u;
const uint PORES = 40u;
const uint SOURCES = HANDS + PORES;

// A source's place with the body's feet and hands where given (now, or the frame before); `wide` how wide the body is
// against a player.
vec3 source(vec3 feet, float height, vec3 handA, vec3 handB, float wide, uint body, uint k, float seconds) {
    if (k < HANDS) {
        uint key = k + body * 61u;
        vec3 round_ = vec3(rnd(key, 41u), rnd(key, 42u), rnd(key, 43u)) - 0.5;
        return ((k & 1u) == 0u ? handA : handB) + round_ * (0.1 * B);
    }
    uint pore = k - HANDS + body * 61u;
    float span = 2.5 + 3.5 * rnd(pore, 31u);
    float epoch = floor(seconds / span + rnd(pore, 32u));
    uint key = pore * 977u + uint(epoch) * 131071u;
    float a = rnd(key, 6u) * 6.2831853;
    float up = mix(0.14, 0.94, rnd(key, 7u)) * height;
    float out_ = (0.28 + 0.04 * rnd(key, 8u)) * B * wide;
    return feet + vec3(cos(a) * out_, up, sin(a) * out_);
}

bool inside(vec3 c) {
    return all(greaterThanEqual(c, vec3(Origin.xyz))) && all(lessThanEqual(c, vec3(Origin.xyz + SIZE - 1)));
}

// The water's own swirls finer than the grid: the curl of a slowly changing noise (no source, no sink — threads next to
// each other curl together), cells a second. Wide and gentle: tighter ones wind a thread into a coil. A gradient
// noise's (a value noise's lattice turned the threads at its squares' sides).
vec3 swirl(vec3 c, float t) {
    vec3 q = c * (1.3 / B) + vec3(0.0, t * 0.13, t * 0.07);
    return textureLod(Noise, q / 8.0, 0.0).xyz * (0.35 * B);
}

vec3 flow(vec3 c) {
    return inside(c) ? textureLod(VelIn, (c + 0.5) / SIZEF, 0.0).xyz : vec3(0.0);
}

bool solid(vec3 c) {
    ivec3 b = ivec3(floor(c / B));
    ivec3 r = b - Window.xyz;
    if (r.x < 0 || r.z < 0 || r.y < 0 || r.x >= Window.w || r.z >= Window.w || r.y >= WindowSize.x) {
        return false;
    }
    uint v = texelFetch(CursedVoxels, ivec3(b.x & 255, b.z & 255, b.y - Window.y), 0).r & 15u;
    if (v == 1u || v == 5u || v == 8u || v == 11u) {
        return true;
    }
    float fy = fract(c.y / B);
    return (v == 2u && fy < 0.5) || (v == 3u && fy >= 0.5);
}

// The world cells (the water's) a brick's texel holds on one axis: its brick within the window (`o` its lowest cell,
// `size` its cells). Where the window does not start on a brick, the brick at its start holds its far end too: the whole
// window then (a box too big rather than too small).
vec2 brick_span(int b, int o, int size) {
    int ob = o >> 2;
    int wb = ob + ((b - ob) & (size / 4 - 1));
    if ((o & 3) != 0 && wb == ob) {
        return vec2(float(o), float(o + size));
    }
    return vec2(max(float(wb * 4), float(o)), min(float(wb * 4 + 4), float(o + size)));
}

// Gauss's error function (Abramowitz and Stegun 7.1.26: within 1.5e-7).
float erf_(float x) {
    float t = 1.0 / (1.0 + 0.3275911 * abs(x));
    float y = 1.0 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-x * x);
    return sign(x) * y;
}

// Which source a speck let go this frame comes from: the bodies in turn, each one's sources in turn (from a different
// one each frame: none left out when there are fewer specks than sources).
uint offset_now() {
    return (uint(Step.y) * 23u) % SOURCES;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint total = uint(Emit.z);
    uint bodies = uint(Emit.w);
    if (stage == 0) {
        if (id >= uint(Emit.y) || bodies == 0u) {
            return;
        }
        uint serial = uint(Emit.x) + id;
        uint i = serial & (total - 1u);
        uint body = id % bodies;
        uint q = id / bodies;
        uint k = (q + offset_now()) % SOURCES;
        // the one before it from the same source: this frame's (a round of sources back), else the last frame's
        uint before = q >= SOURCES ? serial - bodies * SOURCES : last[body * SOURCES + k];
        Body b = Bodies[body];
        vec3 now = source(b.feet.xyz, b.feet.w, b.handA.xyz, b.handB.xyz, b.handBFrom.w, body, k, Camera.w);
        vec3 from = source(b.feetFrom.xyz, b.feet.w, b.handAFrom.xyz, b.handBFrom.xyz, b.handBFrom.w, body, k, Camera.w);
        // this source's specks this frame (as many rounds as the frame was long: a slow frame lets go as many as fast
        // ones) spread along the way it came since the last frame, from where it was then (else a moving body's threads
        // come out dotted, or as long straight pieces with corners)
        uint q0 = q % SOURCES;
        uint top = (uint(Emit.y) - 1u - body) / bodies;
        uint many = (top - q0) / SOURCES + 1u;
        if (distance(from, now) > 0.4 * B) {
            // a jump (another pore opened, a teleport): from here on
            from = now;
        }
        vec3 p = mix(from, now, float(q / SOURCES + 1u) / float(many));
        // out of a pore: away from the trunk, a little down; off a hand: dripping down
        vec3 out_ = p - b.feet.xyz;
        out_.y = 0.0;
        vec3 push = k < HANDS ? vec3(0.0, -0.2 * B, 0.0) : (normalize(out_ + 1e-3) * 0.32 + vec3(0.0, -0.03, 0.0)) * B;
        // a mob has no hands to let threads go from: its hands' specks none
        // a body that lets go of nothing (one's own unseen, for its traces alone): none either
        specks[i].pos = vec4(p, (k < HANDS && b.handAFrom.w < 0.5) || b.vel.w < 0.01 ? -1.0 : 0.0);
        specks[i].life = vec4(0.0, 0.0, 0.0, mix(4.0, 8.0, rnd(k + body * 61u, 9u)));
        specks[i].push = vec4(push, mix(0.03, 0.07, rnd(k + body * 61u, 10u)) * B);
        specks[i].link = uvec4(before, serial, k, 0u);
    } else if (stage == 3) {
        // the last speck each source let go this frame
        if (id >= bodies * SOURCES) {
            return;
        }
        uint n = uint(Emit.y);
        uint body = id / SOURCES;
        uint k = id % SOURCES;
        uint q0 = (k + SOURCES - offset_now()) % SOURCES;
        if (body + bodies * q0 >= n) {
            return;
        }
        uint top = (n - 1u - body) / bodies;
        uint q = q0 + SOURCES * ((top - q0) / SOURCES);
        last[id] = uint(Emit.x) + body + bodies * q;
    } else if (stage == 1) {
        if (id >= total) {
            return;
        }
        vec4 s = specks[id].pos;
        if (s.w < 0.0) {
            return;
        }
        float dt = Step.x;
        vec3 p = s.xyz;
        vec4 push = specks[id].push;
        // its own way: pushed out at first (fading in a second), then only sinking
        vec3 own = push.xyz * exp(-s.w * 2.2) - vec3(0.0, push.w, 0.0);
        vec3 v1 = flow(p) + swirl(p, Camera.w) + own;
        vec3 m = p + v1 * dt * 0.5;
        vec3 v2 = flow(m) + swirl(m, Camera.w) + own;
        vec3 next = p + v2 * dt;
        float age = s.w + dt;
        if (solid(next)) {
            // along the block's top or side rather than into it; settled ink soon gone (into the ground's stain)
            vec3 flat_ = vec3(next.x, p.y, next.z);
            next = solid(flat_) ? p : flat_;
            age += dt * 10.0;
        }
        // a speck gone wrong (its place not a number) is let go of
        bool lost = any(isnan(next)) || any(isinf(next));
        specks[id].pos = vec4(lost ? p : next, age > specks[id].life.w || lost ? -1.0 : age);
    } else if (stage == 2) {
        if (id >= total) {
            return;
        }
        vec4 s = specks[id].pos;
        if (s.w < 0.0) {
            return;
        }
        // the one before it, if it is still there (its place may hold a newer one by now)
        uvec4 link = specks[id].link;
        uint j = link.x & (total - 1u);
        vec4 o = specks[j].pos;
        if (specks[j].link.y != link.x || o.w < 0.0) {
            return;
        }
        vec3 d = o.xyz - s.xyz;
        // a source moved on (another pore opened): the thread ends here
        if (dot(d, d) > (0.4 * B) * (0.4 * B)) {
            return;
        }
        // the one before that: the thread drawn as a curve through them all (from the middle of the piece before this
        // one, bent at the speck before, to the middle of this piece), not straight pieces meeting at corners
        uint jj = specks[j].link.x & (total - 1u);
        vec4 oo = specks[jj].pos;
        vec3 m0 = o.xyz;
        if (specks[jj].link.y == specks[j].link.x && oo.w >= 0.0 && distance(oo.xyz, o.xyz) < 0.4 * B) {
            m0 = 0.5 * (oo.xyz + o.xyz);
        }
        vec3 m1 = 0.5 * (o.xyz + s.xyz);
        float age = s.w / specks[id].life.w;
        // fading in at once, thinning out over its life
        float strength = smoothstep(0.0, 0.03, age) * (1.0 - age) * (1.0 - age);
        if (strength <= 0.002) {
            return;
        }
        vec2 size = vec2(Sizes.xy);
        vec4 c0 = ViewProj * vec4((m0 - Camera.xyz) / B, 1.0);
        vec4 cb = ViewProj * vec4((o.xyz - Camera.xyz) / B, 1.0);
        vec4 c1 = ViewProj * vec4((m1 - Camera.xyz) / B, 1.0);
        if (c0.w <= 0.05 || cb.w <= 0.05 || c1.w <= 0.05) {
            return;
        }
        vec3 n0 = c0.xyz / c0.w;
        vec3 nb = cb.xyz / cb.w;
        vec3 n1 = c1.xyz / c1.w;
        vec2 p0 = (n0.xy * 0.5 + 0.5) * size;
        vec2 pb = (nb.xy * 0.5 + 0.5) * size;
        vec2 p1 = (n1.xy * 0.5 + 0.5) * size;
        // its width: a centimetre new, spread to six as it ages; on the screen a pixel at least, a few near
        float dist = c1.w;
        float perBlock = abs(ViewProj[1][1]) * 0.5 * size.y / dist;
        float thick = mix(0.01, 0.06, sqrt(age));
        float width = clamp(thick * perBlock, 1.0, 7.0);
        // how dark across its middle: its ink spread along its piece of the thread (drawn out by the flow, paler) and
        // across it (as it spreads)
        float stretch = 0.03 / max(length(d) / B, 0.03);
        float dark = (link.z < HANDS ? 0.5 : 0.22) * strength * stretch * (0.01 / thick) * Step.z;
        // too pale to see
        if (dark < 0.004) {
            return;
        }
        // soft across (a Gaussian, its weight about one in all), within a circle round each point of it where the
        // weight comes down to nothing (cut off where it was still a little, each point showed as a square)
        float spread = 0.36 * width * width;
        float R = max(floor(width * 1.3 + 0.5), 1.0);
        // wholly off the frame: nothing to draw
        vec2 lo_ = min(min(p0, pb), p1) - R;
        vec2 hi_ = max(max(p0, pb), p1) + R;
        if (hi_.x < 0.0 || hi_.y < 0.0 || lo_.x > size.x || lo_.y > size.y) {
            return;
        }
        // its ink along the curve, as two straight pieces through its middle, each laid down whole: every pixel near a
        // piece takes all it gets from it at once — the soft discs of every point along it, summed in closed form (the
        // same sum as a disc at each pixel of its length, without going over the same pixels again and again)
        float lambda = dark * width / (3.14159 * spread);
        float cut = exp(-R * R / spread);
        float rs = sqrt(spread);
        vec2 pm = 0.25 * p0 + 0.5 * pb + 0.25 * p1;
        float zm = 0.25 * n0.z + 0.5 * nb.z + 0.25 * n1.z;
        for (int piece = 0; piece < 2; piece++) {
            vec2 a = piece == 0 ? p0 : pm;
            vec2 b = piece == 0 ? pm : p1;
            float za = piece == 0 ? n0.z : zm;
            float zb = piece == 0 ? zm : n1.z;
            vec2 ab = b - a;
            float L = length(ab);
            if (L < 1e-3) {
                continue;
            }
            vec2 dir = ab / L;
            // along its longer way on the screen, a short run of pixels across it at each step
            bool across_y = abs(dir.x) >= abs(dir.y);
            float ma = across_y ? a.x : a.y;
            float mb = across_y ? b.x : b.y;
            float na = across_y ? a.y : a.x;
            float nb_ = across_y ? b.y : b.x;
            float slope = (nb_ - na) / (mb - ma);
            float reach = R / max(across_y ? abs(dir.x) : abs(dir.y), 0.7) + 1.0;
            int first = max(int(floor(min(ma, mb) - R)), 0);
            int last_ = min(int(ceil(max(ma, mb) + R)), (across_y ? Sizes.x : Sizes.y) - 1);
            for (int m = first; m <= last_; m++) {
                // the piece's middle across at this step (held at its ends past them)
                float mc = clamp(float(m) + 0.5, min(ma, mb), max(ma, mb));
                float c = na + (mc - ma) * slope;
                int n0_ = int(floor(c - reach));
                int n1_ = int(ceil(c + reach));
                for (int n = n0_; n <= n1_; n++) {
                    ivec2 px = across_y ? ivec2(m, n) : ivec2(n, m);
                    if (px.x < 0 || px.y < 0 || px.x >= Sizes.x || px.y >= Sizes.y) {
                        continue;
                    }
                    vec2 e = vec2(px) + 0.5 - a;
                    float u = dot(e, dir);
                    float dd = e.x * dir.y - e.y * dir.x;
                    float d2 = dd * dd;
                    if (d2 >= R * R) {
                        continue;
                    }
                    // the points of the piece within the circle round this pixel, and the Gaussian summed over them
                    float h = sqrt(R * R - d2);
                    float t0 = max(0.0, u - h);
                    float t1 = min(L, u + h);
                    if (t1 <= t0) {
                        continue;
                    }
                    float along = 0.886227 * rs * (erf_((u - t0) / rs) - erf_((u - t1) / rs));
                    float ink = lambda * (exp(-d2 / spread) * along - cut * (t1 - t0)) / (1.0 - cut);
                    uint add = uint(max(ink, 0.0) * 4096.0 + 0.5);
                    if (add == 0u) {
                        continue;
                    }
                    // behind the world drawn there (reversed depth: nearer is more)
                    float z = mix(za, zb, clamp(u / L, 0.0, 1.0));
                    float scene = textureLod(Depth, (vec2(px) + 0.5) / size, 0.0).r;
                    if (z < scene) {
                        continue;
                    }
                    atomicAdd(splat[px.y * Sizes.x + px.x], add);
                }
            }
        }
    } else if (stage == 4) {
        // a brick with ink: the tiles of the frame its box covers (its corners in front of the camera, and where its
        // edges cross the near plane)
        ivec3 nb3 = SIZE / 4;
        if (id >= uint(nb3.x * nb3.y * nb3.z)) {
            return;
        }
        ivec3 b = ivec3(int(id) % nb3.x, (int(id) / nb3.x) % nb3.y, int(id) / (nb3.x * nb3.y));
        if (texelFetch(Bricks, b, 0).r < 0.002) {
            return;
        }
        vec2 sx = brick_span(b.x, Origin.x, SIZE.x);
        vec2 sy = brick_span(b.y, Origin.y, SIZE.y);
        vec2 sz = brick_span(b.z, Origin.z, SIZE.z);
        vec2 size = vec2(Sizes.xy);
        vec4 c[8];
        for (int k = 0; k < 8; k++) {
            vec3 corner = vec3((k & 1) == 0 ? sx.x : sx.y, ((k >> 1) & 1) == 0 ? sy.x : sy.y, (k >> 2) == 0 ? sz.x : sz.y);
            c[k] = ViewProj * vec4((corner - Camera.xyz) / B, 1.0);
        }
        const float NEAR = 0.002;
        vec2 mn = vec2(1e9);
        vec2 mx = vec2(-1e9);
        for (int k = 0; k < 8; k++) {
            if (c[k].w > NEAR) {
                vec2 s = (c[k].xy / c[k].w * 0.5 + 0.5) * size;
                mn = min(mn, s);
                mx = max(mx, s);
            }
        }
        const ivec2 EDGES[12] = ivec2[](ivec2(0, 1), ivec2(2, 3), ivec2(4, 5), ivec2(6, 7), ivec2(0, 2), ivec2(1, 3), ivec2(4, 6), ivec2(5, 7),
                                        ivec2(0, 4), ivec2(1, 5), ivec2(2, 6), ivec2(3, 7));
        for (int k = 0; k < 12; k++) {
            vec4 p = c[EDGES[k].x];
            vec4 q = c[EDGES[k].y];
            if ((p.w > NEAR) != (q.w > NEAR)) {
                vec4 m = mix(p, q, (NEAR - p.w) / (q.w - p.w));
                vec2 s = (m.xy / NEAR * 0.5 + 0.5) * size;
                mn = min(mn, s);
                mx = max(mx, s);
            }
        }
        // wholly behind the camera
        if (mn.x > mx.x) {
            return;
        }
        int tw = (Sizes.x + 7) / 8;
        int th = (Sizes.y + 7) / 8;
        // three pixels round (a picture at half the frame's size blends its neighbours in when brought up)
        ivec2 t0 = clamp(ivec2(floor((mn - 3.0) / 8.0)), ivec2(0), ivec2(tw - 1, th - 1));
        ivec2 t1 = clamp(ivec2(floor((mx + 3.0) / 8.0)), ivec2(0), ivec2(tw - 1, th - 1));
        if (mx.x < -3.0 || mx.y < -3.0 || mn.x > size.x + 3.0 || mn.y > size.y + 3.0) {
            return;
        }
        for (int ty = t0.y; ty <= t1.y; ty++) {
            for (int tx = t0.x; tx <= t1.x; tx++) {
                tiles[ty * tw + tx] = 1u;
            }
        }
    }
}
