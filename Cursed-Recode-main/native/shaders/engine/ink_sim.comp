#version 450
// The chams' ink in the air (engine/ink.rs, cursed.recode.chams): ink let into still water, simulated. A grid of cells
// (sixteen to a block) round the nearest body that lets ink go, addressed modulo its size as the camera moves (a cell's texel is its world cell
// modulo the grid; the cells that come into the window are emptied). The ink has a grid of its own twice as fine
// (thirty-two cells to a block, the same place in the texture: the samplers' coordinates are the water's), its sheets
// and threads finer than the swirls that carry them. One shader, its stage chosen by the push constant; engine/ink.rs
// runs them in order each step (60 a second):
//  0 the velocity carried along itself, the bodies stirring it (their way, their limbs), the cells come into the
//    window emptied, blocks still;
//  1 its curl kept from fading (vorticity confinement: the swirls that make ink curl), heavy ink sinking;
//  2 how much flows out of each cell (divergence), and which of its neighbours are blocks (the next stages read that,
//    not the voxels);
//  3 the pressure that undoes it, one Jacobi step (run many times);
//  4 its slope taken off the velocity: nothing gathers or empties (incompressible);
//  5 the ink carried along the velocity (forward) and the water's own finer swirls, the bodies letting more go (on the
//    ink's grid);
//  6 the ink carried back (MacCormack: the error of the round trip taken off, kept within its neighbours — thin threads
//    stay thin; on the ink's grid);
//  7 how much of the sun and of the sky reaches each cell through the ink (for its shading);
//  8 the most ink in each brick of the ink's grid (eight cells a side): the ray passes the empty ones at once;
//  9 once: the noise the finer swirls and the ink's grain read (a texture, not worked out for each cell and sample);
// 10 the most ink in each sub-brick (four cells a side), what stage 8 reads;
// 11 the velocity's curl at each cell (stage 1 reads it at a cell and its six neighbours, not worked out seven times).
// A step runs 0, 11, 1, 2, 3 (many), 4, 5, 6, 10, 8, 7: the light is worked out only round the bricks with ink (the
// ray reads it nowhere else).

layout(local_size_x = 8, local_size_y = 4, local_size_z = 8) in;

layout(set = 0, binding = 0) uniform sampler3D VelIn;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image3D VelOut;
layout(set = 0, binding = 2) uniform sampler3D InkIn;
layout(set = 0, binding = 3, r16f) uniform writeonly image3D InkOut;
layout(set = 0, binding = 4, r16f) uniform readonly image3D PresIn;
layout(set = 0, binding = 5, r16f) uniform writeonly image3D PresOut;
layout(set = 0, binding = 6, r16f) uniform image3D Div;
layout(set = 0, binding = 7) uniform sampler3D InkFwd;
layout(set = 0, binding = 8) uniform usampler2DArray CursedVoxels;
layout(set = 0, binding = 9, rg16f) uniform writeonly image3D LightOut;
layout(set = 0, binding = 11, r16f) uniform image3D Bricks;
// the noise (64 a side, repeating every 8 of its lattice): the curl of a noise (xyz), the noise (w)
layout(set = 0, binding = 12, rgba16f) uniform writeonly image3D NoiseOut;
layout(set = 0, binding = 13) uniform sampler3D Noise;
// each cell's six neighbours that are blocks (bits 0..5: +x, -x, +y, -y, +z, -z), itself (bit 6)
layout(set = 0, binding = 14, r8ui) uniform uimage3D Walls;
// the noise alone (w above), for the ink's grain (ink_draw.comp: a quarter of the reads' size)
layout(set = 0, binding = 15, r16f) uniform writeonly image3D NoiseAOut;
// the most ink in each sub-brick (stage 10), the velocity's curl (stage 11)
layout(set = 0, binding = 16, r16f) uniform image3D Sub;
layout(set = 0, binding = 17, rgba32f) uniform image3D Curl;

struct Body {
    // feet (cells from the grid's world origin), height (cells): where they are at the end of this step
    vec4 feet;
    // velocity (cells a second), how much ink it lets go (0..1)
    vec4 vel;
    // its hands (cells), how fast each moves (w)
    vec4 handA;
    vec4 handB;
    // where the feet and the hands were at its start (the way between let ink go all along it, not at its end alone:
    // else a body moving lets it go in separate prints, one a step); how much its hands let go (handAFrom.w: 0 a mob's),
    // how wide it is against a player (handBFrom.w)
    vec4 feetFrom;
    vec4 handAFrom;
    vec4 handBFrom;
};

layout(std140, set = 0, binding = 10) uniform Ink {
    // the grid's world origin now (cells: its lowest corner), the step's number
    ivec4 Origin;
    // the origin last step
    ivec4 Before;
    // the voxel window (engine): its lowest block (xyz), its width; height (x)
    ivec4 Window;
    ivec4 WindowSize;
    // the sun's direction (xyz), the step (seconds, w)
    vec4 Sun;
    // how many bodies (x), seconds (y), how much ink they let go (z: 1 as made), how fast it thins (w: 1 as made)
    vec4 Info;
    Body Bodies[8];
};

layout(push_constant) uniform Stage {
    int stage;
};

const ivec3 SIZE = ivec3(128, 64, 128);
const vec3 SIZEF = vec3(SIZE);
const float CELL = 0.0625;
// blocks in cells
const float B = 16.0;
// the ink's grid: twice as fine, its cells' positions in its own units (a water cell is two)
const ivec3 FINE = SIZE * 2;
const vec3 FINEF = vec3(FINE);
// its bricks (eight cells a side), sub-bricks (four)
const ivec3 BRICKS = FINE / 8;
const ivec3 SUBS = FINE / 4;

// The world cell a texel holds now, and whether it held another before the window moved (it came in: empty).
ivec3 world_of(ivec3 t, ivec3 origin) {
    return origin + ((t - origin) & (SIZE - 1));
}

bool came_in(ivec3 t) {
    return any(notEqual(world_of(t, Origin.xyz), world_of(t, Before.xyz)));
}

// The same on the ink's grid.
ivec3 fine_of(ivec3 t, ivec3 origin) {
    return origin + ((t - origin) & (FINE - 1));
}

bool came_in_fine(ivec3 t) {
    return any(notEqual(fine_of(t, Origin.xyz * 2), fine_of(t, Before.xyz * 2)));
}

// Whether a world cell is inside the window, and solid there (a block the ink cannot pass). Inside up to the last
// cell's middle: past it the repeating sampler would blend in the far side's cells (the floor's ink at the top).
bool inside(vec3 c) {
    return all(greaterThanEqual(c, vec3(Origin.xyz))) && all(lessThanEqual(c, vec3(Origin.xyz + SIZE - 1)));
}

bool inside_fine(vec3 c) {
    return all(greaterThanEqual(c, vec3(Origin.xyz * 2))) && all(lessThanEqual(c, vec3(Origin.xyz * 2 + FINE - 1)));
}

// Whether a place (blocks) is in a block the ink cannot pass (the engine's voxel window; outside it, water).
bool solid_at(vec3 at) {
    ivec3 b = ivec3(floor(at));
    ivec3 r = b - Window.xyz;
    if (r.x < 0 || r.z < 0 || r.y < 0 || r.x >= Window.w || r.z >= Window.w || r.y >= WindowSize.x) {
        return false;
    }
    uint v = texelFetch(CursedVoxels, ivec3(b.x & 255, b.z & 255, b.y - Window.y), 0).r & 15u;
    if (v == 1u || v == 5u || v == 8u || v == 11u) {
        return true;
    }
    float fy = fract(at.y);
    return (v == 2u && fy < 0.5) || (v == 3u && fy >= 0.5);
}

// A cell (its middle) of the water's grid, of the ink's.
// What is stored: a value gone wrong (not a number, or past half floats' reach) is nothing. One such in the water
// would spread through the whole grid in a few steps (each cell takes its neighbours') and its ink would be gone for
// good; this way it is gone where it came up, at once.
vec3 kept(vec3 v) {
    return any(isnan(v)) || any(isinf(v)) || any(greaterThan(abs(v), vec3(60000.0))) ? vec3(0.0) : v;
}

float kept(float v) {
    return isnan(v) || isinf(v) || abs(v) > 60000.0 ? 0.0 : v;
}

bool solid(ivec3 cell) {
    return solid_at((vec3(cell) + 0.5) * CELL);
}

bool solid_fine(ivec3 cell) {
    return solid_at((vec3(cell) + 0.5) * (CELL * 0.5));
}

// A field at a world position (cells): its texel modulo the grid, trilinear (the samplers repeat).
vec4 at_vel(vec3 c) {
    return inside(c) ? textureLod(VelIn, (c + 0.5) / SIZEF, 0.0) : vec4(0.0);
}

// The ink, the ink carried forward, at a position on the ink's grid (its cells).
float at_ink(vec3 c) {
    return inside_fine(c) ? textureLod(InkIn, (c + 0.5) / FINEF, 0.0).r : 0.0;
}

float at_fwd(vec3 c) {
    return inside_fine(c) ? textureLod(InkFwd, (c + 0.5) / FINEF, 0.0).r : 0.0;
}

vec3 vel_texel(ivec3 w) {
    return inside(vec3(w)) ? texelFetch(VelIn, w & (SIZE - 1), 0).xyz : vec3(0.0);
}

// The velocity's curl at a world cell (a central difference).
vec3 curl_at(ivec3 w) {
    vec3 dx = vel_texel(w + ivec3(1, 0, 0)) - vel_texel(w - ivec3(1, 0, 0));
    vec3 dy = vel_texel(w + ivec3(0, 1, 0)) - vel_texel(w - ivec3(0, 1, 0));
    vec3 dz = vel_texel(w + ivec3(0, 0, 1)) - vel_texel(w - ivec3(0, 0, 1));
    return 0.5 * vec3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x);
}

float hash(vec3 p) {
    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return fract((p.x + p.y) * p.z);
}

float noise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    return mix(mix(mix(hash(i), hash(i + vec3(1, 0, 0)), f.x), mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
               mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x), mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

// An integer hash of a lattice point, 0..1 (no pattern of its own).
float uhash(ivec3 i) {
    uvec3 q = uvec3(i + 32768);
    uint h = (q.x * 1597334677u) ^ (q.y * 3812015801u) ^ (q.z * 2798796415u);
    h *= 0x27d4eb2du;
    h ^= h >> 15;
    h *= 0x2c1b3c6du;
    h ^= h >> 12;
    return float(h) * (1.0 / 4294967296.0);
}

// Gradient noise repeating every 8 of its lattice (stage 9's texture): a slope at each lattice point, not a value — cut
// sharply (the pores, the grain's edges) it shows no squares; 0..1, spread as the value noise was (measured).
float noise_tile(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float c[8];
    for (int k = 0; k < 8; k++) {
        vec3 o = vec3(k & 1, (k >> 1) & 1, k >> 2);
        float h1 = uhash(ivec3(mod(i + o, 8.0)));
        float h2 = fract(h1 * 7919.0);
        // a direction on the sphere
        float z = h1 * 2.0 - 1.0;
        float a = h2 * 6.2831853;
        float r = sqrt(max(1.0 - z * z, 0.0));
        c[k] = dot(vec3(r * cos(a), r * sin(a), z), f - o);
    }
    float g = mix(mix(mix(c[0], c[1], u.x), mix(c[2], c[3], u.x), u.y), mix(mix(c[4], c[5], u.x), mix(c[6], c[7], u.x), u.y), u.z);
    return 0.5 + 1.04 * g;
}

vec3 curl_tile(vec3 q, float e) {
    float ax = noise_tile(q + vec3(0.0, e, 0.0)) - noise_tile(q - vec3(0.0, e, 0.0));
    float ay = noise_tile(q + vec3(0.0, 0.0, e)) - noise_tile(q - vec3(0.0, 0.0, e));
    float az = noise_tile(q + vec3(e, 0.0, 0.0)) - noise_tile(q - vec3(e, 0.0, 0.0));
    float bx = noise_tile(q + vec3(3.0, 0.0, e)) - noise_tile(q + vec3(3.0, 0.0, -e));
    float by = noise_tile(q + vec3(3.0 + e, 0.0, 0.0)) - noise_tile(q + vec3(3.0 - e, 0.0, 0.0));
    float bz = noise_tile(q + vec3(3.0, e, 0.0)) - noise_tile(q + vec3(3.0, -e, 0.0));
    return vec3(ax - bx, ay - by, az - bz);
}

// The curl of a noise at `q` (no source, no sink: what it moves stays as thick), about -1..1 a side.
vec3 curl_noise(vec3 q, float e) {
    float ax = noise(q + vec3(0.0, e, 0.0)) - noise(q - vec3(0.0, e, 0.0));
    float ay = noise(q + vec3(0.0, 0.0, e)) - noise(q - vec3(0.0, 0.0, e));
    float az = noise(q + vec3(e, 0.0, 0.0)) - noise(q - vec3(e, 0.0, 0.0));
    float bx = noise(q + vec3(31.0, 0.0, e)) - noise(q + vec3(31.0, 0.0, -e));
    float by = noise(q + vec3(31.0 + e, 0.0, 0.0)) - noise(q + vec3(31.0 - e, 0.0, 0.0));
    float bz = noise(q + vec3(31.0, e, 0.0)) - noise(q + vec3(31.0, -e, 0.0));
    return vec3(ax - bx, ay - by, az - bz);
}

// The water at a cell of the ink's grid (its cells a second): the grid's velocity, and finer than its cells, swirls of
// its own — stronger as the water is faster (what the grid's swirls break into), a little even in still water. The same
// for the ink carried forward and back (stages 5 and 6). `v` the grid's velocity there (the ink's cells a second).
vec3 fine_vel(vec3 f, vec3 v) {
    vec3 q = f * (1.0 / 9.0) + vec3(0.0, Info.y * 0.21, Info.y * 0.13);
    vec3 s = textureLod(Noise, q / 8.0, 0.0).xyz + 0.5 * textureLod(Noise, (q * 2.3 + 17.0) / 8.0, 0.0).xyz;
    return v + s * (0.16 * length(v) + 1.5);
}

// How far a point is from a body's trunk (a capsule from its feet up its height), in cells.
float to_trunk(vec3 p, vec3 feet, float height) {
    vec3 a = feet + vec3(0.0, 0.2 * B, 0.0);
    vec3 top = feet + vec3(0.0, height - 0.2 * B, 0.0);
    vec3 ab = top - a;
    float k = clamp(dot(p - a, ab) / max(dot(ab, ab), 1e-3), 0.0, 1.0);
    return length(p - (a + ab * k));
}

float to_body(vec3 p, Body b) {
    return to_trunk(p, b.feet.xyz, b.feet.w);
}

// How far a point is from the way a hand went this step (from `a` to `b`), in cells.
float to_way(vec3 p, vec3 a, vec3 b) {
    vec3 ab = b - a;
    float k = clamp(dot(p - a, ab) / max(dot(ab, ab), 1e-4), 0.0, 1.0);
    return length(p - (a + ab * k));
}

void main() {
    ivec3 t = ivec3(gl_GlobalInvocationID);
    ivec3 lim = stage == 5 || stage == 6 ? FINE : (stage == 8 ? BRICKS : (stage == 9 ? ivec3(64) : (stage == 10 ? SUBS : SIZE)));
    if (any(greaterThanEqual(t, lim))) {
        return;
    }
    ivec3 w = world_of(t, Origin.xyz);
    vec3 p = vec3(w);
    float dt = Sun.w;
    int bodies = int(Info.x);

    if (stage == 0) {
        vec3 v = came_in(t) ? vec3(0.0) : texelFetch(VelIn, t, 0).xyz;
        // carried along itself (back along the velocity, at its middle point)
        vec3 mid = p - 0.5 * dt * v;
        vec3 back = p - dt * at_vel(mid).xyz;
        v = came_in(t) ? vec3(0.0) : at_vel(back).xyz;
        // the bodies stir it: the water near a body goes with it, pushed out a little round its trunk; its hands drag
        // their own wake
        for (int i = 0; i < bodies; i++) {
            Body b = Bodies[i];
            float d = to_body(p, b);
            float near = exp(-max(d - 0.25 * B * b.handBFrom.w, 0.0) * 0.45 / (B * 0.1));
            v = mix(v, b.vel.xyz * 0.85, clamp(near * 4.0 * dt, 0.0, 1.0));
            vec3 out_ = p - (b.feet.xyz + vec3(0.0, clamp(p.y - b.feet.y, 0.0, b.feet.w), 0.0));
            out_.y = 0.0;
            v += normalize(out_ + 1e-4) * near * 6.0 * dt * b.vel.w;
            for (int hnd = 0; hnd < 2; hnd++) {
                vec3 from = hnd == 0 ? b.handAFrom.xyz : b.handBFrom.xyz;
                vec3 to = hnd == 0 ? b.handA.xyz : b.handB.xyz;
                float dh = to_way(p, from, to);
                // as much in all as a hand standing still drags, spread along its way
                float along = 1.0 / (1.0 + distance(from, to) / 4.9);
                v += vec3(0.0, -0.4 * B, 0.0) * exp(-dh * dh / (0.03 * B * B)) * along * dt * b.vel.w * b.handAFrom.w;
            }
        }
        v *= exp(-0.12 * dt);
        if (solid(w)) {
            v = vec3(0.0);
        }
        imageStore(VelOut, t, vec4(kept(v), 0.0));
    } else if (stage == 1) {
        vec3 v = texelFetch(VelIn, t, 0).xyz;
        // the curl here and next door (stage 11's; past the window's side, worked out here)
        vec3 grad = vec3(0.0);
        // |curl| at the six neighbours for the confinement's direction
        float cm[6];
        for (int k = 0; k < 6; k++) {
            ivec3 o = ivec3(0);
            o[k >> 1] = (k & 1) == 0 ? 1 : -1;
            ivec3 q = w + o;
            cm[k] = length(inside(vec3(q)) ? imageLoad(Curl, q & (SIZE - 1)).xyz : curl_at(q));
        }
        vec3 curl = imageLoad(Curl, t).xyz;
        grad = 0.5 * vec3(cm[0] - cm[1], cm[2] - cm[3], cm[4] - cm[5]);
        float gl = length(grad);
        if (gl > 1e-5) {
            vec3 N = grad / gl;
            v += 1.4 * cross(N, curl) * dt;
        }
        // the water never quite still: a slow stir with no source or sink (the curl of a noise), where there is ink
        // (the ink's grid at this cell's middle: the eight of its cells here, averaged)
        float ink = textureLod(InkIn, (vec3(t) + 0.5) / SIZEF, 0.0).r;
        if (ink > 0.002) {
            vec3 q = p * (0.7 / B) + vec3(0.0, Info.y * 0.08, Info.y * 0.05);
            vec3 stir = curl_noise(q, 0.5);
            v += stir * (0.9 * B) * dt * smoothstep(0.002, 0.05, ink);
        }
        // the ink is heavier than the water: it sinks, slowly, as a plume
        v.y -= (0.15 * B) * ink * dt;
        if (solid(w)) {
            v = vec3(0.0);
        }
        imageStore(VelOut, t, vec4(kept(v), 0.0));
    } else if (stage == 2) {
        // out of the cell, blocks and the window's edges walls (no flow through them); which neighbours are blocks,
        // and itself, kept for the pressure's steps
        uint walls = solid(w) ? 64u : 0u;
        float out_[6];
        for (int k = 0; k < 6; k++) {
            ivec3 o = ivec3(0);
            o[k >> 1] = (k & 1) == 0 ? 1 : -1;
            bool wall = solid(w + o);
            walls |= wall ? (1u << k) : 0u;
            out_[k] = wall ? 0.0 : vel_texel(w + o)[k >> 1];
        }
        imageStore(Walls, t, uvec4(walls, 0u, 0u, 0u));
        imageStore(Div, t, vec4(0.5 * (out_[0] - out_[1] + out_[2] - out_[3] + out_[4] - out_[5]), 0.0, 0.0, 0.0));
    } else if (stage == 3) {
        float c = imageLoad(PresIn, t).r;
        uint walls = imageLoad(Walls, t).r;
        float sum = 0.0;
        for (int k = 0; k < 6; k++) {
            ivec3 o = ivec3(0);
            o[k >> 1] = (k & 1) == 0 ? 1 : -1;
            ivec3 q = w + o;
            // a block's side keeps this cell's pressure (no flow through it); past the window, none
            sum += (walls & (1u << k)) != 0u ? c : (inside(vec3(q)) ? imageLoad(PresIn, q & (SIZE - 1)).r : 0.0);
        }
        float div = imageLoad(Div, t).r;
        imageStore(PresOut, t, vec4(kept((sum - div) / 6.0), 0.0, 0.0, 0.0));
    } else if (stage == 4) {
        float c = imageLoad(PresIn, t).r;
        uint walls = imageLoad(Walls, t).r;
        vec3 g;
        for (int a = 0; a < 3; a++) {
            ivec3 o = ivec3(0);
            o[a] = 1;
            float hi = (walls & (1u << (a * 2))) != 0u ? c : (inside(vec3(w + o)) ? imageLoad(PresIn, (w + o) & (SIZE - 1)).r : 0.0);
            float lo = (walls & (2u << (a * 2))) != 0u ? c : (inside(vec3(w - o)) ? imageLoad(PresIn, (w - o) & (SIZE - 1)).r : 0.0);
            g[a] = 0.5 * (hi - lo);
        }
        vec3 v = texelFetch(VelIn, t, 0).xyz - g;
        if ((walls & 64u) != 0u) {
            v = vec3(0.0);
        }
        imageStore(VelOut, t, vec4(kept(v), 0.0));
    } else if (stage == 5) {
        // on the ink's grid: its cell, its position in the water's cells
        ivec3 wf = fine_of(t, Origin.xyz * 2);
        vec3 f = vec3(wf);
        vec3 pc = f * 0.5;
        vec3 vc = at_vel(pc).xyz * 2.0;
        float ink = 0.0;
        // where no ink is round where it came from, none comes (the finer swirls move it less than a cell a step):
        // their noise is worked out only where there is ink
        if (!came_in_fine(t) && (at_ink(f - dt * vc) > 0.0 || at_ink(f) > 0.0)) {
            ink = at_ink(f - dt * fine_vel(f, vc));
        }
        // the bodies let ink go: in patches over their trunk's surface that come and go, more from a moving body;
        // from the hands, a thicker run — all along the way each went this step (a smear, not prints)
        for (int i = 0; i < bodies; i++) {
            Body b = Bodies[i];
            // pores just outside its surface that open and close: thin runs, not a cloak; the shell at a few places
            // along the step's way (no further apart than a third of its thickness)
            vec3 move = b.feet.xyz - b.feetFrom.xyz;
            int K = int(clamp(ceil(length(move) / 0.3), 1.0, 6.0));
            float shell = 0.0;
            // no nearer to the trunk anywhere along the step than this: past five of the shell's widths from it, what
            // it lets go is below anything the ink holds (not worked out)
            float far = to_trunk(pc, mix(b.feetFrom.xyz, b.feet.xyz, 0.5), b.feet.w) - 0.5 * length(move);
            float radius = 0.36 * B * b.handBFrom.w;
            for (int s = 0; s < K && far < radius + 0.27 * B; s++) {
                vec3 at = mix(b.feetFrom.xyz, b.feet.xyz, (float(s) + 0.5) / float(K));
                float d = to_trunk(pc, at, b.feet.w);
                shell += exp(-pow((d - radius) / (0.05 * B), 2.0));
            }
            shell /= float(K);
            if (shell > 1e-4) {
                // the pores on the body (they go with it), drifting up over it
                vec3 q = (pc - mix(b.feetFrom.xyz, b.feet.xyz, 0.5)) * (3.2 / B) + vec3(float(i) * 2.9, Info.y * 0.9, Info.y * 0.5);
                float pores = smoothstep(0.72, 0.92, textureLod(Noise, q / 8.0, 0.0).a);
                float moving = length(b.vel.xyz) / B;
                ink += shell * pores * b.vel.w * Info.z * dt * (0.6 + moving * 0.4);
            }
            for (int hnd = 0; hnd < 2; hnd++) {
                vec4 hh = hnd == 0 ? b.handA : b.handB;
                vec3 from = hnd == 0 ? b.handAFrom.xyz : b.handBFrom.xyz;
                float dh = to_way(pc, from, hh.xyz);
                // as much in all as a hand standing still lets go, spread along its way
                float along = 1.0 / (1.0 + distance(from, hh.xyz) / 3.1);
                ink += exp(-dh * dh / (0.012 * B * B)) * along * b.vel.w * b.handAFrom.w * Info.z * dt * (0.5 + hh.w / B * 0.3);
            }
        }
        if (solid_fine(wf)) {
            ink = 0.0;
        }
        imageStore(InkOut, t, vec4(kept(min(ink, 3.0)), 0.0, 0.0, 0.0));
    } else if (stage == 6) {
        // InkIn: the ink before this step; InkFwd: carried forward. Carry the forward back and compare.
        ivec3 wf = fine_of(t, Origin.xyz * 2);
        vec3 f = vec3(wf);
        float fwd = texelFetch(InkFwd, t, 0).r;
        // none carried here, none let go: none (the cells round where it came from all empty)
        if (fwd <= 0.0) {
            imageStore(InkOut, t, vec4(0.0));
            return;
        }
        vec3 v = fine_vel(f, at_vel(f * 0.5).xyz * 2.0);
        float again = at_fwd(f + dt * v);
        bool fresh = came_in_fine(t);
        float before = fresh ? 0.0 : texelFetch(InkIn, t, 0).r;
        float corrected = fwd + 0.5 * (before - again);
        // within the values round where it came from (no new extremes: no ringing)
        vec3 src = f - dt * v;
        vec3 base = floor(src);
        float lo = 1e9;
        float hi = -1e9;
        for (int k = 0; k < 8; k++) {
            vec3 q = base + vec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
            float s = inside_fine(q) ? texelFetch(InkIn, ivec3(q) & (FINE - 1), 0).r : 0.0;
            lo = min(lo, s);
            hi = max(hi, s);
        }
        float bodiesInk = fwd - at_ink(src);
        corrected = clamp(corrected, lo, hi) + max(bodiesInk, 0.0);
        // fading slowly, as it spreads too thin to see
        // thin ink goes faster than thick (the haze clears, the threads stay)
        corrected = max(corrected * exp(-0.06 * dt * Info.w) - 0.025 * dt * Info.w, 0.0);
        if (solid_fine(wf) || fresh) {
            corrected = 0.0;
        }
        imageStore(InkOut, t, vec4(kept(max(corrected, 0.0)), 0.0, 0.0, 0.0));
    } else if (stage == 7) {
        // read only where a brick with ink is within a cell of here (the ray's samples are in such bricks, the light
        // blended from the cells round them): elsewhere not worked out
        bool read = false;
        for (int k = 0; k < 8; k++) {
            ivec3 c = w + ivec3(k & 1, (k >> 1) & 1, k >> 2) * 2 - 1;
            read = read || imageLoad(Bricks, (c >> 2) & (BRICKS - 1)).r >= 0.002;
        }
        if (!read) {
            return;
        }
        // toward the sun through the ink, a cell and a half a step; straight up toward the sky (the light round,
        // most of it from above)
        float depth = 0.0;
        vec3 L = normalize(Sun.xyz);
        for (int k = 1; k <= 24; k++) {
            vec3 q = p + L * (float(k) * 2.0);
            if (!inside(q)) {
                break;
            }
            depth += textureLod(InkIn, (q + 0.5) / SIZEF, 0.0).r * 2.0;
        }
        float above = 0.0;
        for (int k = 1; k <= 16; k++) {
            vec3 q = p + vec3(0.0, float(k) * 2.0, 0.0);
            if (!inside(q)) {
                break;
            }
            above += textureLod(InkIn, (q + 0.5) / SIZEF, 0.0).r * 2.0;
        }
        imageStore(LightOut, t, vec4(exp(-depth * CELL * 16.0), exp(-above * CELL * 10.0), 0.0, 0.0));
    } else if (stage == 8) {
        // the most ink a sample in this brick can see: its cells and four round it, its sub-bricks and one round them
        // (the sampler blends a neighbour in, the ray looks back along the flow as far as the ink went since the last
        // step: up to two)
        ivec3 base = t * 2 - 1;
        float most = 0.0;
        for (int z = 0; z < 4; z++) {
            for (int y = 0; y < 4; y++) {
                for (int x = 0; x < 4; x++) {
                    most = max(most, imageLoad(Sub, (base + ivec3(x, y, z)) & (SUBS - 1)).r);
                }
            }
        }
        imageStore(Bricks, t, vec4(most, 0.0, 0.0, 0.0));
    } else if (stage == 9) {
        // the curl scaled to the value noise's strength it took over (measured)
        vec3 q = vec3(t) / 8.0;
        float n = clamp(noise_tile(q), 0.0, 1.0);
        imageStore(NoiseOut, t, vec4(curl_tile(q, 0.3) * 0.79, n));
        imageStore(NoiseAOut, t, vec4(n, 0.0, 0.0, 0.0));
    } else if (stage == 10) {
        ivec3 base = t * 4;
        float most = 0.0;
        for (int z = 0; z < 4; z++) {
            for (int y = 0; y < 4; y++) {
                for (int x = 0; x < 4; x++) {
                    most = max(most, texelFetch(InkIn, base + ivec3(x, y, z), 0).r);
                }
            }
        }
        imageStore(Sub, t, vec4(most, 0.0, 0.0, 0.0));
    } else if (stage == 11) {
        imageStore(Curl, t, vec4(curl_at(w), 0.0));
    }
}
