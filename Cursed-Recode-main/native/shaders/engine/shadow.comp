#version 450
// Chams' shadow in the air (engine/shadow.rs, the menu's Look "Shadow"): round each body in it the smoke frays — a
// ragged edge of it just beyond the body, wisps rising off it — and the puffs the bodies let go drift behind them.
// The bodies themselves are their polygons (chams.glsl ch_shadow); here each pixel's ray goes through the smoke round
// them as through a volume, up to the nearest of the level and the bodies (a body hides what is behind it whatever the
// level's depth holds: with the game's Improved Transparency a player's body is not in it). The smoke takes the light:
// black, the sky's and the sun's just touching its thin edges.
// Over a copy of the frame's rectangle that holds it, laid back after: each group of 8 by 8 pixels first keeps the boxes
// and the puffs its rays can meet.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform image2D Canvas;
layout(set = 0, binding = 1) uniform sampler2D Depth;
layout(std140, set = 0, binding = 2) uniform U {
    mat4 ViewProj;
    mat4 InvViewProj;
    // x seconds, y how many boxes, z the frame's width, w its height
    vec4 Info;
    // the rectangle drawn: lowest pixel x, y, past the highest
    ivec4 Rect;
    // x how much the wisps (0 none), z how many puffs, w how much smoke (1)
    vec4 Look;
    // the sky's light (linear), w how much sun there is
    vec4 Sky;
    vec4 SunDir;
    vec4 Spare;
    // the bodies' boxes, four each: the middle (from the camera), the three axes as units (w the half side along each)
    vec4 Boxes[128 * 4];
    // the puffs: middle (from the camera) and radius; how thick (x)
    vec4 Puffs[96];
    vec4 PuffA[96];
};
layout(push_constant) uniform P {
    int Stage;
};

shared uint kept_b;
shared uint keep_b[128];
shared uint kept_p;
shared uint keep_p[96];

vec3 to_linear(vec3 c) {
    return pow(c, vec3(2.2));
}

vec3 to_srgb(vec3 c) {
    return pow(max(c, 0.0), vec3(1.0 / 2.2));
}

vec3 ray_at(vec2 px, float dz) {
    vec2 uv = px / Info.zw;
    vec4 wp = InvViewProj * vec4(uv * 2.0 - 1.0, max(dz, 1e-7), 1.0);
    return wp.xyz / wp.w;
}

// ---- the numbers of chance, the noise ----
uint hash_u(uint n) {
    n ^= n >> 16;
    n *= 0x7feb352du;
    n ^= n >> 15;
    n *= 0x846ca68bu;
    n ^= n >> 16;
    return n;
}

float hash1(uint n) {
    return float(hash_u(n) & 0xffffffu) / 16777216.0;
}

float vnoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    ivec3 b = ivec3(i);
    float n[8];
    for (int k = 0; k < 8; k++) {
        ivec3 o = b + ivec3(k & 1, (k >> 1) & 1, k >> 2);
        n[k] = hash1(uint(o.x) * 73856093u ^ uint(o.y) * 19349663u ^ uint(o.z) * 83492791u);
    }
    return mix(mix(mix(n[0], n[1], u.x), mix(n[2], n[3], u.x), u.y), mix(mix(n[4], n[5], u.x), mix(n[6], n[7], u.x), u.y), u.z);
}

// Two octaves, the first turned through the second (the smoke curls).
float fbm(vec3 p) {
    float a = vnoise(p);
    p = p * 2.03 + vec3(a * 1.7, 0.0, -a * 1.3);
    return a * 0.65 + vnoise(p) * 0.35;
}

// ---- the bodies ----
float box_sd(uint i, vec3 p) {
    vec3 d = p - Boxes[i * 4u].xyz;
    vec4 ax = Boxes[i * 4u + 1u];
    vec4 ay = Boxes[i * 4u + 2u];
    vec4 az = Boxes[i * 4u + 3u];
    vec3 q = abs(vec3(dot(d, ax.xyz), dot(d, ay.xyz), dot(d, az.xyz))) - vec3(ax.w, ay.w, az.w);
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

// The nearest body's distance (its boxes, those the group kept; one whose sphere is further than the nearest found is
// not looked into).
float body_sd(vec3 p) {
    float sd = 1e3;
    for (uint j = 0u; j < kept_b; j++) {
        uint i = keep_b[j];
        float r = length(vec3(Boxes[i * 4u + 1u].w, Boxes[i * 4u + 2u].w, Boxes[i * 4u + 3u].w));
        if (length(p - Boxes[i * 4u].xyz) - r < sd) {
            sd = min(sd, box_sd(i, p));
        }
    }
    return sd;
}

// Where the ray first enters a body (its boxes the group kept); 1e9 when it misses.
float body_hit(vec3 rd) {
    float best = 1e9;
    for (uint j = 0u; j < kept_b; j++) {
        uint i = keep_b[j];
        vec3 c = Boxes[i * 4u].xyz;
        vec4 u0 = Boxes[i * 4u + 1u];
        vec4 u1 = Boxes[i * 4u + 2u];
        vec4 u2 = Boxes[i * 4u + 3u];
        vec3 o = vec3(dot(-c, u0.xyz), dot(-c, u1.xyz), dot(-c, u2.xyz));
        vec3 d = vec3(dot(rd, u0.xyz), dot(rd, u1.xyz), dot(rd, u2.xyz));
        d = vec3(abs(d.x) < 1e-6 ? 1e-6 : d.x, abs(d.y) < 1e-6 ? 1e-6 : d.y, abs(d.z) < 1e-6 ? 1e-6 : d.z);
        vec3 h = vec3(u0.w, u1.w, u2.w);
        vec3 t0 = (-h - o) / d;
        vec3 t1 = (h - o) / d;
        vec3 lo = min(t0, t1);
        vec3 hi = max(t0, t1);
        float tn = max(max(lo.x, lo.y), lo.z);
        float tf = min(min(hi.x, hi.y), hi.z);
        if (tf >= max(tn, 0.0)) {
            best = min(best, max(tn, 0.0));
        }
    }
    return best;
}

float puff_sd(vec3 p) {
    float d = 1e3;
    for (uint j = 0u; j < kept_p; j++) {
        vec4 pf = Puffs[keep_p[j]];
        d = min(d, length(p - pf.xyz) - pf.w);
    }
    return d;
}

// How thick the smoke is at `p` (`sd` the bodies' distance there: it is only outside them), the noise there.
float density(vec3 p, float t, float sd, out float n) {
    float d = 0.0;
    n = 0.5;
    if (Look.x > 0.0 && sd < 0.14) {
        // one noise, flowing up: the ragged edge just beyond the body, and wisps rising off it where it is thick
        n = vnoise(p * 6.0 + vec3(0.0, -t * 0.9, t * 0.1));
        float edge = smoothstep(0.05, 0.0, sd - (n - 0.45) * 0.07);
        float wisp = smoothstep(0.14, 0.0, sd) * smoothstep(0.55, 0.9, n) * 0.8;
        d = max(edge * 0.75, wisp) * min(Look.x, 1.5);
    }
    for (uint j = 0u; j < kept_p; j++) {
        uint i = keep_p[j];
        vec4 pf = Puffs[i];
        float r = length(p - pf.xyz) / pf.w;
        if (r < 1.0) {
            if (n == 0.5) {
                n = vnoise(p * 4.2 + vec3(0.0, -t * 0.55, 0.0));
            }
            d += PuffA[i].x * smoothstep(1.0, 0.15, r + (n - 0.5) * 0.7) * 0.5;
        }
    }
    return d;
}

vec2 sphere(vec3 rd, vec3 c, float r) {
    float b = dot(rd, c);
    float h = b * b - dot(c, c) + r * r;
    if (h < 0.0) {
        return vec2(1e9, -1e9);
    }
    h = sqrt(h);
    return vec2(b - h, b + h);
}

bool reaches(vec3 c, float r, vec2 lo, vec2 hi, float ppb) {
    vec4 cl = ViewProj * vec4(c, 1.0);
    if (cl.w < r + 0.05) {
        return true;
    }
    vec2 s = (cl.xy / cl.w * 0.5 + 0.5) * Info.zw;
    float m = r * ppb / cl.w + 2.0;
    return s.x + m > lo.x && s.x - m < hi.x && s.y + m > lo.y && s.y - m < hi.y;
}

void main() {
    uint li = gl_LocalInvocationIndex;
    if (li == 0u) {
        kept_b = 0u;
        kept_p = 0u;
    }
    barrier();
    vec2 lo = vec2(Rect.xy + ivec2(gl_WorkGroupID.xy * 8u));
    vec2 hi = lo + 8.0;
    float ppb = length(vec3(ViewProj[0][1], ViewProj[1][1], ViewProj[2][1])) * Info.w * 0.5;
    uint nb = min(uint(Info.y), 128u);
    for (uint i = li; i < nb; i += 64u) {
        float r = length(vec3(Boxes[i * 4u + 1u].w, Boxes[i * 4u + 2u].w, Boxes[i * 4u + 3u].w)) + 0.22;
        if (reaches(Boxes[i * 4u].xyz, r, lo, hi, ppb)) {
            keep_b[atomicAdd(kept_b, 1u)] = i;
        }
    }
    uint np = min(uint(Look.z), 96u);
    for (uint i = li; i < np; i += 64u) {
        if (reaches(Puffs[i].xyz, Puffs[i].w, lo, hi, ppb)) {
            keep_p[atomicAdd(kept_p, 1u)] = i;
        }
    }
    barrier();

    ivec2 px = Rect.xy + ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= Rect.z || px.y >= Rect.w || (kept_b == 0u && kept_p == 0u)) {
        return;
    }
    float dz = textureLod(Depth, (vec2(px) + 0.5) / Info.zw, 0.0).r;
    vec3 scene = ray_at(vec2(px) + 0.5, dz);
    float far = dz <= 0.0 ? 1e6 : length(scene);
    // (the sky's: a point far out along the pixel's ray, ray_at's least depth; one a tenth of a block out the view's
    // bob, which moves the eye off the middle, turned well off)
    vec3 rd = normalize(scene);
    // the bodies hide what is behind them
    far = min(far, body_hit(rd));

    // the stretch of the ray that can meet it: through the boxes' spheres and the puffs'
    vec2 span = vec2(1e9, -1e9);
    if (Look.x > 0.0) {
        for (uint j = 0u; j < kept_b; j++) {
            uint i = keep_b[j];
            float r = length(vec3(Boxes[i * 4u + 1u].w, Boxes[i * 4u + 2u].w, Boxes[i * 4u + 3u].w)) + 0.22;
            vec2 s = sphere(rd, Boxes[i * 4u].xyz, r);
            span = vec2(min(span.x, s.x), max(span.y, s.y));
        }
    }
    for (uint j = 0u; j < kept_p; j++) {
        vec2 s = sphere(rd, Puffs[keep_p[j]].xyz, Puffs[keep_p[j]].w);
        span = vec2(min(span.x, s.x), max(span.y, s.y));
    }
    span.x = max(span.x, 0.05);
    span.y = min(span.y, far);
    if (span.y <= span.x) {
        return;
    }

    // ---- through the smoke, front to back ----
    float time = Info.x;
    float trans = 1.0;
    vec3 col = vec3(0.0);
    float len = span.y - span.x;
    float dt = clamp(len / 24.0, 0.03, 0.06);
    float jitter = hash1(uint(px.x) * 1973u ^ uint(px.y) * 9277u ^ uint(time * 60.0) * 26699u);
    float t = span.x + dt * jitter;
    vec3 amb = Sky.rgb * 0.5 + 0.02;
    for (int s = 0; s < 48 && t < span.y; s++) {
        vec3 p = rd * t;
        float sd = Look.x > 0.0 ? body_sd(p) : 1e3;
        // nothing here: over the empty air in one step (as far as nothing can be)
        float empty = min(sd - 0.14, puff_sd(p));
        if (empty > dt) {
            t += empty;
            continue;
        }
        float n;
        float d = density(p, time, max(sd, 0.0), n);
        if (d > 0.002) {
            float sigma = 26.0 * d;
            float a = 1.0 - exp(-sigma * dt);
            float thin = 1.0 - smoothstep(0.15, 0.8, d);
            vec3 lit = amb * (0.035 + 0.09 * thin * n) + Sky.w * 0.03 * thin * (0.5 + 0.5 * SunDir.y);
            col += trans * a * lit;
            trans *= 1.0 - a;
            if (trans < 0.01) {
                break;
            }
        }
        t += dt;
    }
    if (trans > 0.995) {
        return;
    }
    vec4 c4 = imageLoad(Canvas, px);
    vec3 outc = to_linear(c4.rgb) * trans + col;
    imageStore(Canvas, px, vec4(to_srgb(min(outc, vec3(1.0))), c4.a));
}
