
// The sky's table (sky.glsl): for each angle from the sun round the horizon (columns) and each height above it (rows,
// squared so the horizon gets more of them), what the game's sky colour is multiplied by. 256 x 64, again whenever
// the sun has moved (engine/gpu.rs).

// The air straight up, worked out once for the group.
shared vec3 upShared;

void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    vec3 sun = CursedSun.xyz;
    // Turned so the sun is along +x: the sky is the same on both sides of it.
    vec3 s = vec3(length(sun.xz), sun.y, 0.0);
    if (gl_LocalInvocationIndex == 0u) {
        upShared = cursed_atmosphere(vec3(0.0, 1.0, 0.0), s);
    }
    barrier();
    if (t.x >= SKY_LUT_SIZE.x || t.y >= SKY_LUT_SIZE.y) {
        return;
    }
    float side = (float(t.x) + 0.5) / float(SKY_LUT_SIZE.x) * CA_PI;
    float v = (float(t.y) + 0.5) / float(SKY_LUT_SIZE.y);
    float height = v * v * 0.5 * CA_PI;
    vec3 d = vec3(cos(height) * cos(side), sin(height), cos(height) * sin(side));
    imageStore(Palette, ivec2(t.x, SKY_LUT_ROW + t.y), vec4(cursed_sky_ratio(d, s, upShared), 1.0));
}
