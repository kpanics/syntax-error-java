
// How much of the sun reaches each block of a grid of 128 x 64 x 128 round the camera (the coloured light's grid,
// addressed the same way), one block in sixteen traced each step; the light in the air reads it (volume.comp): so the
// air under a cloud's shadow is dark and the sun's rays show between the clouds.
// vk/shaders.rs puts mask_head-like declarations (sunvis_head.glsl) and trace.glsl in front.

void main() {
    ivec3 t = ivec3(gl_GlobalInvocationID);
    // One in sixteen a frame, a different sixteenth each frame.
    if (((t.x + t.y * 3 + t.z * 5 + Frame.x) & 15) != 0) {
        return;
    }
    CameraBlockPos = Base.xyz;
    ivec3 w = Origin.xyz + ((t - Origin.xyz) & MASK);
    float vis = 0.0;
    vec3 L = CursedSun.w > 0.02 ? CursedSun.xyz : CursedMoon.xyz;
    if (L.y > 0.0 && cursed_inside(w) && (cursed_voxel(w) & 15u) != C_FULL && (cursed_voxel(w) & 15u) != C_SHINY) {
        // From the middle of the block (the start cell is skipped: its own block does not shade it).
        vec3 o = vec3(w - Base.xyz) + 0.5;
        vis = cursed_trace(o, L, 96.0) * cursed_cloud_shadow(o, L);
    } else if (!cursed_inside(w)) {
        vis = cursed_cloud_shadow(vec3(w - Base.xyz) + 0.5, L);
    }
    imageStore(SunVis, t, vec4(vis));
}
