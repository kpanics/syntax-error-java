#version 450
// Target ESP (engine/tesseract.rs, the menu's module "target-esp"): the one aimed at in a tesseract. Its edges, corners,
// their trails and the waves of its hits are segments of light: each a core as thick as it is (never thinner than a
// pixel's worth of light: a far one is fainter, not thicker) and a glow round it, hidden where the level is nearer (a
// wall, the target's own body). Its corners are lamps on the level round it: each pixel of it lit as its surface turns
// to them, never through a block of the voxel window.
// Over a copy of the frame's rectangle that holds all of it (Rect), laid back after: each group of 8 by 8 pixels first
// keeps the segments whose glow reaches it.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform image2D Canvas;
layout(set = 0, binding = 1) uniform sampler2D Depth;
layout(set = 0, binding = 2) uniform usampler2DArray CursedVoxels;
layout(std140, set = 0, binding = 3) uniform U {
    mat4 ViewProj;
    mat4 InvViewProj;
    // x seconds, y how many segments, z the frame's width, w its height
    vec4 Info;
    // the rectangle drawn: lowest pixel x, y, past the highest
    ivec4 Rect;
    // x pixels a block is at a block's distance, y how far a glow reaches (its core's radii), z how many lamps, w how
    // far their light reaches (blocks)
    vec4 Look;
    // the colour (linear), w 1 when it lights the world
    vec4 Colour;
    // the lamps' middle (from the camera)
    vec4 Middle;
    // the camera's block in the world, where in it the camera is
    ivec4 CamBlock;
    vec4 CamFrac;
    // the voxel window: its lowest block (xyz), its width (w); its height (x of WindowSize), whether there is one (y)
    ivec4 Window;
    ivec4 WindowSize;
    // the lines' own rectangle (the groups past it have none to keep)
    ivec4 GlowRect;
    // x how many boxes the target's body has
    vec4 More;
    // the lamps: where (from the camera), w how bright
    vec4 Lamps[4];
    // the segments, two each: one end (from the camera) and its core's radius, the other end and how bright
    vec4 Segs[2 * 360];
    // the target's body: four each, the middle (from the camera), the axes as units (w the half side along each)
    vec4 Body[48 * 4];
};
layout(push_constant) uniform P {
    int Stage;
};

const uint MOST_SEGS = 360u;
#define BODY Body
#define BODY_COUNT More.x

shared uint kept;
shared uint keep[MOST_SEGS];
// the body's boxes the group's rays can meet
shared uint kept_body;
shared uint keep_body[48];

vec3 to_linear(vec3 c) {
    return pow(c, vec3(2.2));
}

vec3 to_srgb(vec3 c) {
    return pow(max(c, 0.0), vec3(1.0 / 2.2));
}

vec3 ray_at(vec2 px, float dz) {
    vec2 uv = px / Info.zw;
    vec4 wp = InvViewProj * vec4(uv * 2.0 - 1.0, max(dz, 1e-7), 1.0);
    return wp.xyz / wp.w;
}

// Where a point (from the camera) is on the frame (pixels), z its distance along the view; z below 0.05 behind.
vec3 on_screen(vec3 p) {
    vec4 c = ViewProj * vec4(p, 1.0);
    if (c.w < 0.05) {
        return vec3(0.0, 0.0, -1.0);
    }
    return vec3((c.xy / c.w * 0.5 + 0.5) * Info.zw, c.w);
}

// Whether a segment's glow reaches the box of pixels [lo, hi).
bool reaches(uint i, vec2 lo, vec2 hi) {
    vec4 a = Segs[2u * i];
    vec4 b = Segs[2u * i + 1u];
    vec3 sa = on_screen(a.xyz);
    vec3 sb = on_screen(b.xyz);
    float r = a.w * Look.y;
    // (one end behind the camera, or the glow round the camera: anywhere)
    if (sa.z < r || sb.z < r) {
        return true;
    }
    float m = r * Look.x / min(sa.z, sb.z) + 2.0;
    // how far the box's middle is from the segment on the frame, against its glow and the box's half diagonal
    vec2 mid = (lo + hi) * 0.5;
    vec2 ab = sb.xy - sa.xy;
    float u = clamp(dot(mid - sa.xy, ab) / max(dot(ab, ab), 1e-6), 0.0, 1.0);
    return length(mid - (sa.xy + ab * u)) < m + length(hi - lo) * 0.5;
}

// The ray from the camera along `rd` and a segment: how far apart at their nearest, and how far along the ray.
float apart(vec3 rd, vec3 a, vec3 b, out float t) {
    vec3 ab = b - a;
    float e = dot(ab, ab);
    float k = dot(rd, ab);
    float c = dot(rd, a);
    float f = dot(ab, a);
    float den = e - k * k;
    float u = den > 1e-9 ? clamp((c * k - f) / den, 0.0, 1.0) : 0.0;
    t = max(c + u * k, 0.0);
    // the segment's nearest to that point of the ray (u may have stopped at an end)
    u = e > 1e-12 ? clamp((t * k - f) / e, 0.0, 1.0) : 0.0;
    vec3 q = a + ab * u;
    t = max(dot(q, rd), 0.0);
    return length(rd * t - q);
}

// Where the ray from the camera along `rd` first enters the target's body (its model's boxes, from the camera), and
// the way out of the face it enters by; 1e9 when it misses. The body hides what is behind it whatever the level's depth
// holds (with the game's Improved Transparency a player's body is not in it).
float body_hit(vec3 rd, out vec3 face) {
    float best = 1e9;
    face = -rd;
    for (uint j = 0u; j < kept_body; j++) {
        uint i = keep_body[j];
        vec3 c = BODY[i * 4u].xyz;
        vec4 u0 = BODY[i * 4u + 1u];
        vec4 u1 = BODY[i * 4u + 2u];
        vec4 u2 = BODY[i * 4u + 3u];
        vec3 o = vec3(dot(-c, u0.xyz), dot(-c, u1.xyz), dot(-c, u2.xyz));
        vec3 d = vec3(dot(rd, u0.xyz), dot(rd, u1.xyz), dot(rd, u2.xyz));
        d = vec3(abs(d.x) < 1e-6 ? 1e-6 : d.x, abs(d.y) < 1e-6 ? 1e-6 : d.y, abs(d.z) < 1e-6 ? 1e-6 : d.z);
        vec3 h = vec3(u0.w, u1.w, u2.w);
        vec3 t0 = (-h - o) / d;
        vec3 t1 = (h - o) / d;
        vec3 lo = min(t0, t1);
        vec3 hi = max(t0, t1);
        float tn = max(max(lo.x, lo.y), lo.z);
        float tf = min(min(hi.x, hi.y), hi.z);
        if (tf >= max(tn, 0.0) && tn < best) {
            best = max(tn, 0.0);
            vec3 m = vec3(lo.x >= tn ? 1.0 : 0.0, lo.y >= tn && lo.x < tn ? 1.0 : 0.0, lo.z >= tn && lo.x < tn && lo.y < tn ? 1.0 : 0.0);
            vec3 nl = -sign(d) * m;
            face = normalize(nl.x * u0.xyz + nl.y * u1.xyz + nl.z * u2.xyz + 1e-6);
        }
    }
    return best;
}

// Whether a block of the voxel window stands at this place (from the camera): the full ones and slabs' halves.
bool solid(vec3 p) {
    vec3 f = CamFrac.xyz + p;
    ivec3 b = CamBlock.xyz + ivec3(floor(f));
    ivec3 r = b - Window.xyz;
    if (r.x < 0 || r.z < 0 || r.y < 0 || r.x >= Window.w || r.z >= Window.w || r.y >= WindowSize.x) {
        return false;
    }
    uint v = texelFetch(CursedVoxels, ivec3(b.x & 255, b.z & 255, b.y - Window.y), 0).r & 15u;
    float fy = fract(f.y);
    return v == 1u || v == 5u || v == 8u || v == 11u || (v == 2u && fy < 0.5) || (v == 3u && fy >= 0.5);
}

// How much of the lamps' light gets from their middle to this place: none through a block on the way.
float clear_to(vec3 from, vec3 to) {
    if (WindowSize.y == 0) {
        return 1.0;
    }
    vec3 d = to - from;
    float len = length(d);
    int steps = int(clamp(len / 0.4, 1.0, 7.0));
    for (int i = 1; i < steps; i++) {
        if (solid(from + d * (float(i) / float(steps)))) {
            return 0.12;
        }
    }
    return 1.0;
}

void main() {
    uint li = gl_LocalInvocationIndex;
    if (li == 0u) {
        kept = 0u;
        kept_body = 0u;
    }
    barrier();
    vec2 lo = vec2(Rect.xy + ivec2(gl_WorkGroupID.xy * 8u));
    vec2 hi = lo + 8.0;
    bool any = lo.x < float(GlowRect.z) && hi.x > float(GlowRect.x) && lo.y < float(GlowRect.w) && hi.y > float(GlowRect.y);
    uint n = any ? min(uint(Info.y), MOST_SEGS) : 0u;
    for (uint i = li; i < n; i += 64u) {
        if (reaches(i, lo, hi)) {
            keep[atomicAdd(kept, 1u)] = i;
        }
    }
    if (li < min(uint(BODY_COUNT), 48u)) {
        vec3 c = BODY[li * 4u].xyz;
        float r = length(vec3(BODY[li * 4u + 1u].w, BODY[li * 4u + 2u].w, BODY[li * 4u + 3u].w));
        vec4 cl = ViewProj * vec4(c, 1.0);
        bool any_px = cl.w < r + 0.05;
        if (!any_px) {
            vec2 sc = (cl.xy / cl.w * 0.5 + 0.5) * Info.zw;
            float m = r * Look.x / cl.w + 2.0;
            any_px = sc.x + m > lo.x && sc.x - m < hi.x && sc.y + m > lo.y && sc.y - m < hi.y;
        }
        if (any_px) {
            keep_body[atomicAdd(kept_body, 1u)] = li;
        }
    }
    barrier();

    ivec2 px = Rect.xy + ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= Rect.z || px.y >= Rect.w) {
        return;
    }
    vec2 uv = (vec2(px) + 0.5) / Info.zw;
    // (the level's depth, maybe smaller than the frame: World resolution; 0 the sky)
    float dz = textureLod(Depth, uv, 0.0).r;
    vec3 scene = ray_at(vec2(px) + 0.5, dz);
    float far = dz <= 0.0 ? 1e6 : length(scene);
    vec3 rd = normalize(dz <= 0.0 ? ray_at(vec2(px) + 0.5, 0.5) : scene);
    // the target's own body, nearer than what the level's depth holds: it hides the lines and takes the light
    vec3 body_face;
    float tb = body_hit(rd, body_face);
    bool on_body = tb < far;
    if (on_body) {
        far = tb;
        scene = rd * tb;
        dz = 1.0;
    }
    // a pixel's width at a block's distance
    float pa = length(normalize(ray_at(vec2(px) + vec2(1.5, 0.5), 0.5)) - normalize(ray_at(vec2(px) + 0.5, 0.5)));

    // ---- the lines of light ----
    float core = 0.0;
    float glow = 0.0;
    for (uint j = 0u; j < kept; j++) {
        uint i = keep[j];
        vec4 a = Segs[2u * i];
        vec4 b = Segs[2u * i + 1u];
        float t;
        float d = apart(rd, a.xyz, b.xyz, t);
        float r = a.w;
        // hidden where the level is nearer
        float seen = 1.0 - smoothstep(far - 0.03, far + 0.12, t);
        if (seen <= 0.0 || d > r * Look.y) {
            continue;
        }
        float rc = max(r, max(t, 0.05) * pa * 0.75);
        core += b.w * (r / rc) * (1.0 - smoothstep(rc * 0.3, rc, d)) * seen;
        float x = d / (r * 3.5);
        glow += b.w * (0.13 * exp(-x * x) + 0.03 * exp(-d / (r * 4.0))) * seen;
    }

    // ---- its light on the level ----
    vec3 light = vec3(0.0);
    if (Colour.w > 0.5 && dz > 0.0 && length(scene - Middle.xyz) < Look.w) {
        // the surface's way out, from its neighbours' depth (turned to the camera)
        vec3 sx = ray_at(vec2(px) + vec2(1.5, 0.5), textureLod(Depth, uv + vec2(1.0, 0.0) / Info.zw, 0.0).r);
        vec3 sy = ray_at(vec2(px) + vec2(0.5, 1.5), textureLod(Depth, uv + vec2(0.0, 1.0) / Info.zw, 0.0).r);
        vec3 nrm = cross(sx - scene, sy - scene);
        nrm = on_body ? body_face : (dot(nrm, nrm) > 1e-12 ? normalize(nrm) : -rd);
        if (dot(nrm, rd) > 0.0) {
            nrm = -nrm;
        }
        float sum = 0.0;
        int lamps = int(Look.z);
        for (int i = 0; i < lamps; i++) {
            vec3 l = Lamps[i].xyz - scene;
            float d = length(l);
            float fall = Lamps[i].w / (1.0 + d * d * 1.3) * (1.0 - smoothstep(Look.w * 0.55, Look.w, d));
            sum += fall * (max(dot(nrm, l / max(d, 1e-4)), 0.0) * 0.82 + 0.18);
        }
        if (sum > 0.002) {
            sum *= clear_to(scene + nrm * 0.06, Middle.xyz);
            light = Colour.rgb * sum;
        }
    }

    if (core <= 0.0005 && glow <= 0.0005 && dot(light, light) <= 1e-7) {
        return;
    }
    vec4 c4 = imageLoad(Canvas, px);
    vec3 col = to_linear(c4.rgb);
    // lit as a lamp lights it: what it is made of is not known here, only how it looks lit as it is; the dark lifted
    // more than the bright (by night it shows, by day it is a touch)
    float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
    col += light * (0.6 * sqrt(col) + 0.02) * (1.0 - 0.8 * smoothstep(0.04, 0.45, lum));
    // the lines over it: the glow in its colour, the core nearly white
    col += Colour.rgb * glow + mix(Colour.rgb, vec3(1.0), 0.65) * core;
    imageStore(Canvas, px, vec4(to_srgb(min(col, vec3(1.0))), c4.a));
}
