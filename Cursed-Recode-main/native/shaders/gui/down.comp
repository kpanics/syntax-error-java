// The glass's blur, down: a 13-tap level of the one above (the first takes the game's picture).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D Src;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D Level;
layout(push_constant) uniform Step {
    vec4 Info;     // the source's texel (x, y), this level's size
    vec4 Area;     // where it is needed (the window): its corner in this level's texels
};
vec3 s(vec2 uv){ return textureLod(Src, uv, 0.).rgb; }
void main(){
  ivec2 q = ivec2(gl_GlobalInvocationID.xy) + ivec2(Area.xy);
  if (q.x >= int(Info.z) || q.y >= int(Info.w)) return;
  vec2 uv = (vec2(q) + .5) / Info.zw; vec2 t = Info.xy;
  vec3 a = s(uv + t * vec2(-2., 2.)), b = s(uv + t * vec2(0., 2.)), c = s(uv + t * vec2(2., 2.));
  vec3 d = s(uv + t * vec2(-2., 0.)), e = s(uv), f = s(uv + t * vec2(2., 0.));
  vec3 g = s(uv + t * vec2(-2., -2.)), h = s(uv + t * vec2(0., -2.)), i = s(uv + t * vec2(2., -2.));
  vec3 j = s(uv + t * vec2(-1., 1.)), k = s(uv + t * vec2(1., 1.)), l = s(uv + t * vec2(-1., -1.)), m = s(uv + t * vec2(1., -1.));
  imageStore(Level, q, vec4(e * .125 + (a + c + g + i) * .03125 + (b + d + f + h) * .0625 + (j + k + l + m) * .125, 1.));
}
