// The menu: the glass (the world behind it blurred), then every shape gui/mod.rs drew, in order, each pixel only the
// ones over its tile of 16 px (draw.rs bins), then the burning line the window opens from and folds into.
// A shape is six vec4: its box, colour, parameters, (kind, -, -, -), second colour, clip.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 1, std430) readonly buffer Prims { vec4 P[]; };
layout(set = 0, binding = 2, std430) readonly buffer Lists { uint L[]; };   // per tile: start, count; then indices
layout(set = 0, binding = 3) uniform sampler2D Atlas;
layout(set = 0, binding = 4) uniform sampler2D Logo;
layout(set = 0, binding = 5) uniform sampler2D Back;
layout(set = 0, binding = 6, rgba8) uniform writeonly image2D Out;
layout(set = 0, binding = 7) uniform sampler2D Sharp;   // the game's picture as it is (glass that is barely frosted)
layout(set = 0, binding = 8) uniform sampler2D Pics;    // the menus' pictures: worlds, servers' icons, packs, faces (render.rs)
layout(set = 0, binding = 9) uniform sampler2D Letters; // the letters drawn from the system's fonts (gui/dynfont.rs)

shared vec4 S[256 * 6];

// The launch's noise (shaders/launch/launch.glsl): the fire under a word burns the same here.
float hash12(vec2 p){ vec3 p3 = fract(vec3(p.xyx) * .1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }
float vn2(vec2 p){ vec2 i = floor(p), f = fract(p); vec2 u = f*f*(3.-2.*f);
  return mix(mix(hash12(i), hash12(i+vec2(1,0)), u.x), mix(hash12(i+vec2(0,1)), hash12(i+vec2(1,1)), u.x), u.y); }
float fbm2(vec2 p){ float s = 0., a = .5; for (int i = 0; i < 4; i++) { s += a * vn2(p); p = p * 2.03 + vec2(17.1, 9.3); a *= .5; } return s / .9375; }

// The fire under the hovered word (shaders/launch/comp.comp flameLine): f the place in ui px (y up from the line's
// own y), x0, x1 in ui px, how far it has run along, how much is seen.
float flameLine(vec2 f, float x0, float x1, float run, float a, float time){
  if (a <= 0.) return 0.;
  float px = (f.x - x0) / max(x1 - x0, 1.);
  float dy = f.y;
  if (px < -.05 || px > 1.05 || dy < -4. || dy > 110.) return 0.;
  float rev = smoothstep(run + .03, run - .1, px) * smoothstep(-.05, .03, px) * smoothstep(1.05, .96, px);
  float xs = f.x * .045 + 1.1 * fbm2(vec2(f.x * .018, dy * .028 - time * 1.7));
  float cell = floor(xs), fx = fract(xs) - .5;
  float hh = 12. + 58. * pow(vn2(vec2(cell * 1.7, time * 2.3)), 2.);
  float rise = clamp(dy / hh, 0., 1.);
  float w = .38 * pow(1. - rise, .8) + .04;
  float tongue = smoothstep(w, 0., abs(fx + .16 * sin(dy * .09 - time * 6.5 + cell * 2.3))) * pow(1. - rise, 1.3) * step(0., dy);
  float xs2 = f.x * .09 + 1.4 * fbm2(vec2(f.x * .03 + 7., dy * .04 - time * 2.4));
  float c2 = floor(xs2), f2 = fract(xs2) - .5;
  float h2 = 24. + 80. * pow(vn2(vec2(c2 * 2.9, time * 1.9 + 5.)), 3.);
  float r2 = clamp(dy / h2, 0., 1.);
  float wisp = smoothstep(.1 * (1. - r2) + .02, 0., abs(f2 + .2 * sin(dy * .12 - time * 7. + c2))) * pow(1. - r2, 1.6) * step(0., dy) * .55;
  float base = exp(-dy * dy / 3.) * .32 + exp(-max(dy, 0.) / 8.) * .22 * step(-1., dy);
  return (tongue * 1.15 + wisp + base) * rev * a;
}

// The preview's svg icons, 16 × 16, y down: the distance to a segment, to a triangle.
float sdSeg(vec2 p, vec2 a, vec2 b){ vec2 pa = p - a, ba = b - a; float h = clamp(dot(pa, ba) / dot(ba, ba), 0., 1.); return length(pa - ba * h); }
float sdTri(vec2 p, vec2 a, vec2 b, vec2 c){
  vec2 e0 = b - a, e1 = c - b, e2 = a - c, v0 = p - a, v1 = p - b, v2 = p - c;
  vec2 q0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0., 1.), q1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0., 1.), q2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0., 1.);
  float s = sign(e0.x * e2.y - e0.y * e2.x);
  vec2 d = min(min(vec2(dot(q0, q0), s * (v0.x * e0.y - v0.y * e0.x)), vec2(dot(q1, q1), s * (v1.x * e1.y - v1.y * e1.x))), vec2(dot(q2, q2), s * (v2.x * e2.y - v2.y * e2.x)));
  return -sqrt(d.x) * sign(d.y);
}
float dot2(vec2 v){ return dot(v, v); }
// two shapes grown into one, `k` of a round between them
float smin(float a, float b, float k){ float h = clamp(.5 + .5 * (b - a) / k, 0., 1.); return mix(b, a, h) - k * h * (1. - h); }
// a heart (Inigo Quilez's), its tip at the origin, y up, about 1.2 wide and 1.1 tall
float sdHeart(vec2 p){
  p.x = abs(p.x);
  if (p.y + p.x > 1.) return sqrt(dot2(p - vec2(.25, .75))) - sqrt(2.) / 4.;
  return sqrt(min(dot2(p - vec2(0., 1.)), dot2(p - .5 * max(p.x + p.y, 0.)))) * sign(p.x - p.y);
}
float rbox(vec2 p, vec2 c, vec2 h, float r){ vec2 q = abs(p - c) - h + r; return length(max(q, 0.)) + min(max(q.x, q.y), 0.) - r; }
// the body's icons (the Custom Hotbar, gui/hudbar.rs): 14 a heart, 16 food, 18 armour (each +1 its left half), 20 a
// bubble of air, 21 experience
float bodyIcon(vec2 u, float kind){
  float d;
  if (kind < 15.5) {
    d = sdHeart(vec2(u.x - 8., 14.2 - u.y) / 10.6) * 10.6;
  } else if (kind < 17.5) {
    // a drumstick: the meat narrowing into the bone (a round head on a stick reads as a key), the bone's two knobs
    float meat = smin(length(u - vec2(6.2, 6.2)) - 4.9, length(u - vec2(9.4, 9.4)) - 2.3, 2.4);
    float bone = sdSeg(u, vec2(9.4, 9.4), vec2(12.4, 12.4)) - .9;
    float knob = min(length(u - vec2(13.4, 11.9)) - 1.3, length(u - vec2(11.9, 13.4)) - 1.3);
    d = min(meat, min(bone, knob));
  } else if (kind < 19.5) {
    float body = rbox(u, vec2(8., 9.4), vec2(3.9, 4.8), 1.3);
    float shoulders = rbox(u, vec2(8., 5.4), vec2(6.4, 2.), 1.);
    float neck = length(u - vec2(8., 2.4)) - 2.9;
    d = max(min(body, shoulders), -neck);
  } else if (kind < 20.5) {
    return min(abs(length(u - 8.) - 5.) - .95, length(u - vec2(6.1, 6.1)) - 1.15);
  } else {
    return (abs(u.x - 8.) + abs(u.y - 8.)) * .7071 - 4.2;
  }
  // the odd ones: the left half only
  return mod(floor(kind + .5), 2.) > .5 ? max(d, u.x - 8.) : d;
}
// the chat's icons (gui/chat): 30 reply, 31 at, 32 copy, 33 hide, 34 a person, 35 people, 36 a letter, 37 a server,
// 38 every line, 39 a gear, 40 a place, 41 a link, 42 a speech bubble, 43 a clock, 44 a person crossed
float ringPart(vec2 u, vec2 c, float r, float t){ return abs(length(u - c) - r) - t; }
float chatIcon(vec2 u, float kind){
  float t = .75;
  if (kind < 30.5) {
    // reply: an arrowhead to the left, its shaft bending down to the right
    float head = min(sdSeg(u, vec2(3., 7.), vec2(7., 3.)), sdSeg(u, vec2(3., 7.), vec2(7., 11.)));
    float shaft = sdSeg(u, vec2(3., 7.), vec2(9., 7.));
    vec2 c = vec2(9., 11.);
    float bend = (u.x >= c.x && u.y <= c.y) ? ringPart(u, c, 4., 0.) : 1e3;
    return min(min(head, shaft), bend) - t;
  }
  if (kind < 31.5) {
    vec2 d = u - 8.;
    float ang = atan(d.y, d.x);
    float outer = (ang > .15 && ang < 1.25) ? 1e3 : ringPart(u, vec2(8.), 5.6, t);
    float inner = ringPart(u, vec2(8.), 2.3, t);
    float stem = sdSeg(u, vec2(10.3, 5.8), vec2(10.3, 9.6)) - t;
    float tail = sdSeg(u, vec2(10.3, 9.6), vec2(12.3, 10.6)) - t;
    return min(min(outer, inner), min(stem, tail));
  }
  if (kind < 32.5) {
    float front = abs(rbox(u, vec2(9.6, 9.6), vec2(3.6), 1.3)) - t;
    float behind = abs(rbox(u, vec2(6.4, 6.4), vec2(3.6), 1.3)) - t;
    behind = max(behind, -(rbox(u, vec2(9.6, 9.6), vec2(3.6), 1.3) - 1.6));
    return min(front, behind);
  }
  if (kind < 33.5) {
    // an eye crossed out
    float lens = abs(max(length(u - vec2(8., 14.)) - 8.2, length(u - vec2(8., 2.)) - 8.2)) - t;
    float pupil = length(u - 8.) - 1.9;
    float slash = sdSeg(u, vec2(3., 13.), vec2(13., 3.)) - t;
    return min(max(min(lens, pupil), -(sdSeg(u, vec2(3., 13.), vec2(13., 3.)) - 1.8)), slash);
  }
  if (kind < 34.5 || kind > 43.5) {
    float head = ringPart(u, vec2(8., 5.4), 2.7, t);
    float body = u.y < 14. ? ringPart(u, vec2(8., 15.), 6., t) : 1e3;
    float d = min(head, body);
    if (kind > 43.5) d = min(max(d, -(sdSeg(u, vec2(2.5, 13.5), vec2(13.5, 2.5)) - 1.8)), sdSeg(u, vec2(2.5, 13.5), vec2(13.5, 2.5)) - t);
    return d;
  }
  if (kind < 35.5) {
    float h1 = ringPart(u, vec2(6., 5.6), 2.4, t);
    float b1 = u.y < 14. ? ringPart(u, vec2(6., 14.6), 5., t) : 1e3;
    float h2 = ringPart(u, vec2(11.2, 4.6), 2., t);
    float b2 = (u.y < 11.5 && u.x > 9.6) ? ringPart(u, vec2(11.2, 12.4), 4.2, t) : 1e3;
    return min(min(h1, b1), min(h2, b2));
  }
  if (kind < 36.5) {
    float box2 = abs(rbox(u, vec2(8.), vec2(6., 4.4), 1.2)) - t;
    float v = min(sdSeg(u, vec2(2.6, 4.8), vec2(8., 8.8)), sdSeg(u, vec2(8., 8.8), vec2(13.4, 4.8))) - t;
    return min(box2, v);
  }
  if (kind < 37.5) {
    float a = abs(rbox(u, vec2(8., 5.), vec2(5.6, 2.3), 1.)) - t;
    float b = abs(rbox(u, vec2(8., 11.), vec2(5.6, 2.3), 1.)) - t;
    float dots = min(length(u - vec2(5., 5.)), length(u - vec2(5., 11.))) - .9;
    return min(min(a, b), dots);
  }
  if (kind < 38.5) {
    float l = min(sdSeg(u, vec2(3., 4.5), vec2(13., 4.5)), sdSeg(u, vec2(3., 8.), vec2(13., 8.)));
    return min(l, sdSeg(u, vec2(3., 11.5), vec2(10., 11.5))) - t;
  }
  if (kind < 39.5) {
    vec2 d = u - 8.;
    float ang = atan(d.y, d.x);
    float k = round(ang / .785398) * .785398;
    vec2 dir = vec2(cos(k), sin(k));
    float tooth = sdSeg(u, 8. + dir * 4.4, 8. + dir * 6.4) - 1.;
    return min(ringPart(u, vec2(8.), 4.1, t), min(tooth, ringPart(u, vec2(8.), 1.6, t)));
  }
  if (kind < 40.5) {
    float top = u.y < 8.6 ? ringPart(u, vec2(8., 6.6), 4.2, t) : 1e3;
    float v = min(sdSeg(u, vec2(4.2, 8.4), vec2(8., 13.8)), sdSeg(u, vec2(8., 13.8), vec2(11.8, 8.4))) - t;
    return min(min(top, v), length(u - vec2(8., 6.6)) - 1.3);
  }
  if (kind < 41.5) {
    vec2 v = mat2(.7071, -.7071, .7071, .7071) * (u - 8.);
    float a = abs(rbox(v, vec2(-2.7, 0.), vec2(3.4, 1.9), 1.9)) - t;
    float b = abs(rbox(v, vec2(2.7, 0.), vec2(3.4, 1.9), 1.9)) - t;
    return min(a, b);
  }
  if (kind < 42.5) {
    float bub = abs(rbox(u, vec2(8., 7.), vec2(5.8, 4.2), 2.)) - t;
    float tail = min(sdSeg(u, vec2(5.2, 11.), vec2(4.4, 14.)), sdSeg(u, vec2(4.4, 14.), vec2(8.4, 11.))) - t;
    return min(bub, tail);
  }
  // a clock
  return min(ringPart(u, vec2(8.), 5.8, t), min(sdSeg(u, vec2(8.), vec2(8., 4.6)), sdSeg(u, vec2(8.), vec2(10.6, 9.4))) - t);
}
// what goes in an empty cell of the inventory (gui/hud/hudpack.rs): 50 a helmet, 51 a chestplate, 52 leggings,
// 53 boots, 54 a shield; a furnace's 56 fire
float invIcon(vec2 u, float kind){
  if (kind > 55.5) {
    // a fire: a round foot, a tall middle tongue swaying as it rises, a shorter one each side leaning out
    float sway = .28 * clamp(10.5 - u.y, 0., 9.) * sin((10.5 - u.y) * .35);
    float foot = length((u - vec2(8., 11.5)) / vec2(1., .85)) - 3.6;
    float mid = sdTri(vec2(u.x - sway, u.y), vec2(5.4, 10.6), vec2(10.6, 10.6), vec2(8., 1.)) - .5;
    float lean = .3 * clamp(12.5 - u.y, 0., 9.);
    float left = sdTri(vec2(u.x + lean, u.y), vec2(5.2, 12.8), vec2(7.4, 10.8), vec2(5.6, 4.6)) - .3;
    float right = sdTri(vec2(u.x - lean, u.y), vec2(8.8, 10.8), vec2(10.8, 12.8), vec2(10.6, 5.8)) - .3;
    return smin(smin(smin(foot, mid, 1.4), left, .5), right, .5);
  }
  if (kind < 50.5) {
    float dome = rbox(u, vec2(8., 7.6), vec2(5.8, 4.6), 4.2);
    float face = rbox(u, vec2(8., 11.4), vec2(3.4, 3.2), 1.);
    return max(dome, -face);
  }
  if (kind < 51.5) return bodyIcon(u, 18.);
  if (kind < 52.5) {
    float belt = rbox(u, vec2(8., 3.9), vec2(5., 1.7), .8);
    float left = rbox(u, vec2(5.5, 9.), vec2(2.3, 5.4), .9);
    float right = rbox(u, vec2(10.5, 9.), vec2(2.3, 5.4), .9);
    return min(belt, min(left, right));
  }
  if (kind < 53.5) {
    vec2 m = vec2(abs(u.x - 8.), u.y);
    float shaft = rbox(m, vec2(3.4, 8.), vec2(1.9, 3.2), .7);
    float foot = rbox(m, vec2(4.4, 12.2), vec2(2.9, 1.5), .9);
    return min(shaft, foot);
  }
  float top = rbox(u, vec2(8., 5.8), vec2(5.4, 3.6), 1.6);
  float tip = sdTri(u, vec2(2.9, 7.6), vec2(13.1, 7.6), vec2(8., 14.6)) - .7;
  return min(top, tip);
}
// The binds' icon (45): a keyboard — a rounded body, two rows of keys (the lower one between the upper's) and the space
// bar. `t`: seconds since the pointer came onto it (-1 not): its keys light one after another, left to right, once.
float keysIcon(vec2 u, float t){
  float w = .7;
  float d = abs(rbox(u, vec2(8.), vec2(6.65, 5.3), 1.5)) - w;
  for (int i = 0; i < 7; i++) {
    vec2 c = i < 4 ? vec2(4. + float(i) * 2.667, 5.4) : vec2(5.333 + float(i - 4) * 2.667, 8.);
    float k = t < 0. ? 0. : clamp((t - float(i) * .045) / .16, 0., 1.);
    d = min(d, length(u - c) - (.72 + .36 * sin(k * 3.14159)));
  }
  float ks = t < 0. ? 0. : clamp((t - .315) / .2, 0., 1.);
  return min(d, sdSeg(u, vec2(4.7, 10.67), vec2(11.3, 10.67)) - w * (1. + .45 * sin(ks * 3.14159)));
}
// The tutorial's icons (menus/toasts.rs; the game's are pixels), `t` seconds since its toast came: 46 the keys one moves
// with (W over A S D), pressed in turn; 47 a mouse looking round (swaying side to side); 48 a mouse, its right button
// pressed now and then.
float tutIcon(vec2 u, float kind, float t){
  float w = .55;
  if (kind < 46.5) {
    float d = 1e3;
    for (int i = 0; i < 4; i++) {
      vec2 c = i == 0 ? vec2(8., 5.2) : vec2(3. + float(i - 1) * 5., 10.6);
      d = min(d, abs(rbox(u, c, vec2(1.9), .7)) - w);
      // its turn: pressed, filled from its middle
      float k = sin(3.14159 * clamp((mod(t, 2.8) - .4 - float(i) * .5) / .5, 0., 1.));
      if (k > .01) d = min(d, rbox(u, c, vec2(1.4 * k), .5 * k));
    }
    return d;
  }
  // its body, the line between its buttons, the line under them
  vec2 m = kind < 47.5 ? vec2(u.x - 1.4 * sin(t * 2.2), u.y) : u;
  float d = abs(rbox(m, vec2(8., 8.4), vec2(4.2, 6.), 4.2)) - w;
  d = min(d, sdSeg(m, vec2(8., 2.4), vec2(8., 7.6)) - w);
  d = min(d, sdSeg(m, vec2(3.8, 7.6), vec2(12.2, 7.6)) - w);
  if (kind > 47.5) {
    // the whole right button, a click: in quickly, held, out
    float ph = mod(t, 1.6);
    float k = smoothstep(.3, .38, ph) * (1. - smoothstep(.62, .72, ph));
    float button = max(rbox(m, vec2(8., 8.4), vec2(3.7, 5.5), 3.7), max(8. - m.x, m.y - 7.6));
    if (k > .01) d = min(d, button + (1. - k) * 1.5);
  }
  return d;
}

float icon(vec2 u, float kind){
  float t = .75;   // half a stroke
  // past 100: turned left to right (a bar filled from the right)
  if (kind > 99.5) { kind -= 100.; u.x = 16. - u.x; }
  if (kind > 49.5) return invIcon(u, kind);
  if (kind > 29.5) return chatIcon(u, kind);
  if (kind > 13.5) return bodyIcon(u, kind);
  if (kind < .5) return min(sdSeg(u, vec2(4, 3), vec2(4, 13)) - .6, sdTri(u, vec2(13, 3), vec2(6, 8), vec2(13, 13)) - .6);
  if (kind < 1.5) return min(sdSeg(u, vec2(5, 3), vec2(5, 13)), sdSeg(u, vec2(11, 3), vec2(11, 13))) - 1.1;
  if (kind < 2.5) return sdTri(u, vec2(4, 2.5), vec2(13, 8), vec2(4, 13.5));
  if (kind < 3.5) return min(sdSeg(u, vec2(12, 3), vec2(12, 13)) - .6, sdTri(u, vec2(3, 3), vec2(10, 8), vec2(3, 13)) - .6);
  if (kind < 4.5) return min(sdSeg(u, vec2(8, 2.5), vec2(8, 13.5)), sdSeg(u, vec2(2.5, 8), vec2(13.5, 8))) - t;
  if (kind < 5.5) return min(sdSeg(u, vec2(3.5, 3.5), vec2(12.5, 12.5)), sdSeg(u, vec2(12.5, 3.5), vec2(3.5, 12.5))) - t;
  if (kind < 6.5) return min(sdSeg(u, vec2(2.5, 8.5), vec2(6.3, 12.3)), sdSeg(u, vec2(6.3, 12.3), vec2(13.5, 4.2))) - t;
  if (kind < 7.5) return min(sdSeg(u, vec2(10.5, 2.5), vec2(5, 8)), sdSeg(u, vec2(5, 8), vec2(10.5, 13.5))) - t;
  if (kind < 8.5) return min(sdSeg(u, vec2(5.5, 2.5), vec2(11, 8)), sdSeg(u, vec2(11, 8), vec2(5.5, 13.5))) - t;
  if (kind < 9.5) {
    // again: three quarters of a circle, an arrowhead at its end
    vec2 d = u - 8.;
    float ring = abs(length(d) - 5.) - t;
    float ang = atan(d.x, -d.y);
    float arc = ang > -1.2 ? ring : length(u - vec2(8. - 5. * sin(1.2), 8. - 5. * cos(1.2))) - t;
    return min(arc, sdTri(u, vec2(2.2, 4.6), vec2(6.6, 4.4), vec2(4.2, 8.6)) - .2);
  }
  if (kind < 10.5) return min(sdSeg(u, vec2(2.5, 10.5), vec2(8, 5)), sdSeg(u, vec2(8, 5), vec2(13.5, 10.5))) - t;
  if (kind < 11.5) return min(sdSeg(u, vec2(2.5, 5.5), vec2(8, 11)), sdSeg(u, vec2(8, 11), vec2(13.5, 5.5))) - t;
  if (kind < 12.5) {
    vec2 b = abs(u - vec2(8, 10.5)) - vec2(4.5, 3.5);
    float body = length(max(b, 0.)) + min(max(b.x, b.y), 0.) - .6;
    vec2 d = u - vec2(8, 7);
    float shackle = d.y < 0. ? abs(length(d) - 3.) - t : abs(abs(d.x) - 3.) - t;
    return min(body, max(shackle, u.y - 7.5));
  }
  return min(abs(length(u - vec2(7, 7)) - 4.2) - t, sdSeg(u, vec2(10, 10), vec2(13.5, 13.5)) - t);
}

float box(vec2 p, vec4 r, float rad) {
  vec2 c = (r.xy + r.zw) * .5, h = max((r.zw - r.xy) * .5, vec2(0.));
  rad = min(rad, min(h.x, h.y));
  vec2 q = abs(p - c) - h + rad;
  return length(max(q, 0.)) + min(max(q.x, q.y), 0.) - rad;
}

// A random number for a cell and a moment (PCG: no pattern in the grain, as the float hashes leave)
uint pcg(uint v) {
  uint s = v * 747796405u + 2891336453u;
  uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
  return (w >> 22u) ^ w;
}
float hash(vec2 p, float k) {
  uvec2 q = uvec2(ivec2(floor(p)) + 65536);
  return float(pcg(q.x + pcg(q.y + pcg(uint(k)))) >> 8) / 16777215.;
}

// premultiplied `acc` under a straight colour `c` seen `a`
vec4 over(vec4 acc, vec3 c, float a) {
  return vec4(c * a + acc.rgb * (1. - a), a + acc.a * (1. - a));
}

// Interference where a preview will be: grain that changes 24 times a second, rows torn sideways now and then, a soft
// band rolling down, scanlines, a flicker; darker at the corners. Grey, a breath warm, like the client's light.
vec3 noise(vec2 p, vec4 r, float time, float seed, float s) {
  vec2 sz = max(r.zw - r.xy, vec2(1.));
  vec2 uv = (p - r.xy) / sz;
  float frame = floor(time * 24.);
  float sd = seed * 7919.;
  float tearRow = floor((p.y - r.y) / 22.);
  float torn = step(.9, hash(vec2(floor(time * 7.), tearRow), sd + 1.));
  float shift = torn * (hash(vec2(floor((p.y - r.y) / 3.), 0.), frame + sd) - .5) * 26.;
  vec2 q = p - r.xy + vec2(shift, 0.);
  float g = hash(q / 2., frame + sd + 2.);
  float g2 = hash(q / 5., frame * 3. + sd + 3.);
  float roll = fract(uv.y - time * .13 + seed * .31);
  float band = exp(-pow(roll - .5, 2.) * 34.);
  float scan = .78 + .22 * sin(p.y * 3.14159 * .66);
  float flick = .86 + .14 * hash(vec2(floor(time * 11.), 0.), sd + 4.);
  float snow = step(.985, g) * (.5 + .5 * g2);
  float v = (.045 + .15 * g * g + .05 * g2 + .11 * band * (.45 + g) + .35 * snow * (.3 + band)) * scan * flick;
  v += torn * .05 * g;
  vec2 e = uv - .5;
  v *= clamp(1. - dot(e, e) * 1.25, 0., 1.);
  v *= mix(.55, 1., s);
  return vec3(v) * vec3(1., .975, .95);
}

// The game's picture (and the blur's levels made from it) is stored bottom row first: a place on the screen (y down)
// is read from the other end.
vec2 pic(vec2 uv) { return vec2(uv.x, 1. - uv.y); }

// The glass's blur read through a cubic B-spline (four bilinear reads): a level a few times smaller than the screen
// read bilinearly shows its texels as creases and diamonds, which the cursor's light and the dark glass bring out.
vec3 glass_blur(vec2 uv) {
  vec2 size = vec2(textureSize(Back, 0));
  vec2 st = uv * size - .5;
  vec2 i = floor(st);
  vec2 f = st - i;
  vec2 f2 = f * f, f3 = f2 * f;
  vec2 w0 = (1. - 3. * f + 3. * f2 - f3) / 6.;
  vec2 w1 = (4. - 6. * f2 + 3. * f3) / 6.;
  vec2 w2 = (1. + 3. * f + 3. * f2 - 3. * f3) / 6.;
  vec2 w3 = f3 / 6.;
  vec2 g0 = w0 + w1, g1 = w2 + w3;
  vec2 h0 = (i - .5 + w1 / g0) / size;
  vec2 h1 = (i + 1.5 + w3 / g1) / size;
  return g0.y * (g0.x * textureLod(Back, vec2(h0.x, h0.y), 0.).rgb + g1.x * textureLod(Back, vec2(h1.x, h0.y), 0.).rgb)
       + g1.y * (g0.x * textureLod(Back, vec2(h0.x, h1.y), 0.).rgb + g1.x * textureLod(Back, vec2(h1.x, h1.y), 0.).rgb);
}

vec3 hsv2rgb(float h, float s, float v) {
  vec3 k = clamp(abs(fract(h + vec3(0., 2., 1.) / 3.) * 6. - 3.) - 1., 0., 1.);
  return v * mix(vec3(1.), k, s);
}

vec4 glass(vec2 p, out float inside) {
  float k = Open.x;
  float cy = Win.y + Win.w * .5;
  float hh = Win.w * .5 * k;
  vec4 r = vec4(Win.x, cy - hh, Win.x + Win.z, cy + hh);
  float d = k > .001 ? box(p, r, min(Look.z, hh)) : 1e9;
  vec2 uv = p / Size.xy;
  // the veil over the world, deeper at the edges, and the window's shadow
  vec2 e = (uv - .5) * vec2(1.25, 1.);
  float va = Look.x * Veil.a * (.67 + .71 * dot(e, e) * 2.);
  vec4 acc = vec4(Veil.rgb * va, va);
  // round the window the world loses its colour as the veil comes (the main menu's grey valley), a breath more
  // contrast in its greys; it comes back as the window goes
  float drain = Anim.w * Look.x;
  if (drain > .001 && Size.z > 0.) {
    vec3 w0 = textureLod(Sharp, pic(uv), 0.).rgb;
    float l0 = dot(w0, vec3(.2126, .7152, .0722));
    l0 = mix(l0, l0 * l0 * (3. - 2. * l0), .35);
    // laid over the game's own picture as much as it is drained: what is drawn over the world (the HUD) goes with it
    acc = over(vec4(mix(w0, vec3(l0), drain) * drain, drain), Veil.rgb, va);
  }
  float sh = (1. - smoothstep(-24., 90., d)) * .5 * k * Theme.w * Anim.x;
  acc = over(acc, vec3(0.), sh);
  inside = clamp(.5 - d, 0., 1.);
  if (inside > 0.) {
    // the world through it: frosting over as the glass opens (sharp at first)
    vec3 w = Size.z > 0. ? mix(textureLod(Sharp, pic(uv), 0.).rgb, glass_blur(pic(uv)), Anim.y) : vec3(.06);
    float lum = dot(w, vec3(.2126, .7152, .0722));
    vec3 g = mix(mix(vec3(lum), w, Theme.x), Glass.rgb, Glass.a);
    // the sections' rail a shade deeper; a sheen down from the top; the cursor's light
    float rail = 1. - smoothstep(Win.x + Look.y - 1., Win.x + Look.y + 1., p.x);
    g *= mix(1., 1. - Theme.y, rail);
    g += vec3(.022) * Theme.z * (1. - clamp((p.y - Win.y) / (Win.w * .55), 0., 1.));
    vec2 dc = p - Cur.xy;
    g += vec3(.03) * Cur.z * Fire.a * exp(-dot(dc, dc) / (2. * 230. * 230.));
    // the light crossing it once as it opens: a soft band, leaning, from the left
    if (Anim.z > -.5) {
      float s = (p.x - Win.x) / max(Win.z, 1.) * .78 + (p.y - Win.y) / max(Win.w, 1.) * .22;
      float band = exp(-pow((s - Anim.z) / .085, 2.));
      g += vec3(.065) * band;
    }
    acc = over(acc, g, inside * Anim.x);
  }
  return acc;
}

// The line: during the opening it burns out from the middle, splits into the window's edges and cools; on closing
// the window folds onto it and it burns back to its middle.
vec4 burning(vec4 acc, vec2 p) {
  float L = Open.y;
  if (L <= .001) return acc;
  float cx = Win.x + Win.z * .5, cy = Win.y + Win.w * .5;
  float hw = Win.z * .5 * L;
  float hh = Win.w * .5 * Open.x;
  float heat = Open.z;
  float strength = Open.x < .002 ? 1. : heat;
  if (strength <= .001) return acc;
  float dx = max(abs(p.x - cx) - hw, 0.);
  float taper = 1. - smoothstep(hw * .55, hw + 1., abs(p.x - cx));
  float lit = 0.;
  float glow = 0.;
  for (int i = 0; i < 2; i++) {
    float yy = i == 0 ? cy - hh : cy + hh;
    if (i == 1 && hh < .75) break;
    float d = length(vec2(dx, p.y - yy));
    lit = max(lit, clamp(1.25 - d, 0., 1.) * mix(.55, 1., taper));
    glow += exp(-d / 5.) * .42 + exp(-d / 22.) * .14;
  }
  vec3 hot = mix(vec3(1.), mix(Fire.rgb, vec3(1.), .8), heat);
  vec3 warm = mix(vec3(.9, .9, .92), Fire.rgb, heat);
  acc = over(acc, warm, clamp(glow * strength * (.4 + .6 * taper), 0., 1.));
  acc = over(acc, hot, lit * strength);
  return acc;
}

void main() {
  uvec2 tile = gl_WorkGroupID.xy;
  if (Tiles.y > 0.) {
    uint t = L[uint(Tiles.x) + gl_WorkGroupID.x];
    tile = uvec2(t % uint(Field.w), t / uint(Field.w));
  }
  uint ti = tile.y * uint(Field.w) + tile.x;
  uint start = L[ti * 2u], count = L[ti * 2u + 1u];
  uint lid = gl_LocalInvocationIndex;
  ivec2 px = ivec2(tile * 16u + gl_LocalInvocationID.xy);
  vec2 p = vec2(px) + .5;
  float inside;
  vec4 acc = glass(p, inside);
  uint base = uint(Size.w);
  // a stroke being laid: lines and rings of one colour one after another are one shape (an arrow, a pencil, an icon) —
  // each pixel takes the most of their cover and lays it once, so where they meet a see-through colour is not doubled
  // into a brighter dot
  bool laying = false;
  float sa = 0.;
  vec4 sc = vec4(0.);
  for (uint b = 0u; b < count; b += 256u) {
    barrier();
    if (b + lid < count) {
      uint i = L[base + start + b + lid] * 6u;
      for (uint k = 0u; k < 6u; k++) S[lid * 6u + k] = P[i + k];
    }
    barrier();
    uint n = min(256u, count - b);
    for (uint j = 0u; j < n; j++) {
      vec4 cl = S[j * 6u + 5u];
      if (p.x < cl.x || p.y < cl.y || p.x >= cl.z || p.y >= cl.w) continue;
      vec4 r = S[j * 6u], c = S[j * 6u + 1u], q = S[j * 6u + 2u];
      int kind = int(S[j * 6u + 3u].x + .5);
      if (laying && (kind != 3 && kind != 7 || c != sc)) {
        acc = over(acc, sc.rgb, sc.a * sa);
        laying = false;
        sa = 0.;
      }
      if (kind == 1) {          // a rounded box: flat, a gradient left to right, or lit from its right edge
        float a = clamp(.5 - box(p, r, q.x), 0., 1.);
        if (a <= 0.) continue;
        vec4 c2 = S[j * 6u + 4u];
        if (q.z == 3.) {
          vec2 cell = floor((p - r.xy) / 5.);
          acc = over(acc, mod(cell.x + cell.y, 2.) < 1. ? vec3(.36) : vec3(.22), a * max(c.a, c2.a > 0. ? 1. : 0.));
          float t = clamp((p.x - r.x) / max(r.z - r.x, 1.), 0., 1.);
          acc = over(acc, mix(c.rgb, c2.rgb, t), mix(c.a, c2.a, t) * a);
        } else if (q.z == 1.) {
          float t = clamp((p.x - r.x) / max(r.z - r.x, 1.), 0., 1.);
          acc = over(acc, mix(c.rgb, c2.rgb, t), mix(c.a, c2.a, t) * a);
        } else if (q.z == 4.) {
          // its edge only, q.y wide, inside it
          float d = box(p, r, q.x);
          acc = over(acc, c.rgb, c.a * a * clamp(.5 + d + q.y, 0., 1.));
        } else {
          acc = over(acc, c.rgb, c.a * a);
          if (q.z == 2. && c2.a > 0.) {
            vec2 h = r.zw - r.xy;
            vec2 o = (p - vec2(r.z, (r.y + r.w) * .5)) / vec2(h.x * .75, h.y * 1.4);
            float g = clamp(1. - length(o), 0., 1.);
            acc = over(acc, c2.rgb, c2.a * g * g * a);
          } else if (q.z == 6. && c2.a > 0.) {
            // a light from the middle of its foot, up into it
            vec2 h = r.zw - r.xy;
            vec2 o = (p - vec2((r.x + r.z) * .5, r.w)) / vec2(h.x * .62, h.y * .9);
            float g = clamp(1. - length(o), 0., 1.);
            acc = over(acc, c2.rgb, c2.a * g * g * a);
          }
        }
      } else if (kind == 4) {   // a glyph from its distance field
        vec2 t = (p - r.xy) / max(r.zw - r.xy, vec2(1e-3));
        if (t.x < 0. || t.y < 0. || t.x > 1. || t.y > 1.) continue;   // past its box the atlas holds other letters
        vec2 at = mix(q.xy, q.zw, t);
        vec4 x = S[j * 6u + 3u];
        float v = x.w > .5 ? textureLod(Letters, at / vec2(textureSize(Letters, 0)), 0.).r : textureLod(Atlas, at / Field.xy, 0.).r;
        float d = (v * 255. - 128.) / 127. * Field.z;
        float k = (r.w - r.y) / max(q.w - q.y, 1.);
        // the menus' faces as the launch draws them (no bias); a soft glow round the letters (the main menu's)
        float a = clamp(.5 + d * k + (x.z > .5 ? 0. : .06), 0., 1.);
        if (x.y > 0.) {
          float g = smoothstep(-Field.z, 0., d);
          g = g * g * x.y * c.a;
          // (each letter's own glow over its neighbours': a little under the launch's .32, which took the brightest)
          if (g > .002) acc = over(acc, vec3(1.), g * .27);
        }
        if (a > 0.) acc = over(acc, c.rgb, c.a * a);
      } else if (kind == 3) {   // a segment, round ends, its glow
        vec2 pa = p - r.xy, ba = r.zw - r.xy;
        float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-4), 0., 1.);
        float d = length(pa - ba * h) - q.x * .5;
        float a = clamp(.5 - d, 0., 1.);
        if (q.y > 0.) a = max(a, exp(-max(d, 0.) / q.y) * .45);
        laying = true;
        sc = c;
        sa = max(sa, a);
      } else if (kind == 2) {   // a soft shadow
        float d = box(p, r, q.x);
        float a = 1. - smoothstep(-q.y * .5, q.y, d);
        if (a > .002) acc = over(acc, c.rgb, c.a * a);
      } else if (kind == 7) {   // a ring
        vec2 m = (r.xy + r.zw) * .5;
        vec2 dv = p - m;
        float d = abs(length(dv) - q.x) - q.y * .5;
        float a = clamp(.5 - d, 0., 1.);
        // an arc: q.z of it from the top, clockwise, its ends round
        if (q.z > 0. && q.z < 1.) {
          float f = fract(atan(dv.x, -dv.y) / 6.2831853);
          vec2 c0 = m + vec2(0., -q.x);
          vec2 c1 = m + q.x * vec2(sin(q.z * 6.2831853), -cos(q.z * 6.2831853));
          float cap = min(length(p - c0), length(p - c1)) - q.y * .5;
          a = f <= q.z ? a : clamp(.5 - cap, 0., 1.);
        }
        laying = true;
        sc = c;
        sa = max(sa, a);
      } else if (kind == 8) {   // soft light round a point
        vec2 m = (r.xy + r.zw) * .5;
        float g = clamp(1. - length(p - m) / max(q.x, 1e-3), 0., 1.);
        if (g > 0.) acc = over(acc, c.rgb, c.a * g * g);
      } else if (kind == 5) {   // her logo
        vec2 t = (p - r.xy) / max(r.zw - r.xy, vec2(1e-3));
        if (t.x < 0. || t.y < 0. || t.x > 1. || t.y > 1.) continue;
        vec2 uv = mix(q.xy, q.zw, t);
        float lod = max(log2(192. / max(r.z - r.x, 1.)), 0.);
        float v = textureLod(Logo, uv, lod).r;
        acc = over(acc, c.rgb, c.a * v);
      } else if (kind == 9) {   // glass: the world behind, blurred, under its tint; its shadow round it
        float d = box(p, r, q.x);
        if (d > 0.) {
          float sh = (1. - smoothstep(-2., 22., d)) * .3 * q.z;
          if (sh > .002) acc = over(acc, vec3(0.), sh * sh * 1.6 * c.a);
          continue;
        }
        float a = clamp(.5 - d, 0., 1.);
        vec2 uv = p / Size.xy;
        vec3 w = mix(textureLod(Sharp, pic(uv), 0.).rgb, glass_blur(pic(uv)), clamp(q.y, 0., 1.));
        // as grey as the world round it (a screen's blocks over the greyed world)
        float drain = S[j * 6u + 3u].z;
        if (drain > .001) {
          float l = dot(w, vec3(.2126, .7152, .0722));
          w = mix(w, vec3(mix(l, l * l * (3. - 2. * l), .35)), drain);
        }
        vec3 g = mix(w, c.rgb, q.w);
        float sheen = S[j * 6u + 3u].y;
        g += vec3(.05) * sheen * (1. - clamp((p.y - r.y) / max((r.w - r.y) * .6, 1.), 0., 1.));
        acc = over(acc, g, a * c.a);
      } else if (kind == 10) {  // the colour wheel: hue round, saturation out
        vec2 m = (r.xy + r.zw) * .5;
        vec2 dv = p - m;
        float rr = length(dv);
        float a = clamp(q.x - rr + .5, 0., 1.);
        if (a <= 0.) continue;
        float h = fract(atan(-dv.y, dv.x) / 6.2831853);
        acc = over(acc, hsv2rgb(h, clamp(rr / q.x, 0., 1.), q.y), a * c.a);
      } else if (kind == 6) {   // interference
        float a = clamp(.5 - box(p, r, q.x), 0., 1.);
        if (a <= 0.) continue;
        acc = over(acc, noise(p, r, q.y, q.z, q.w), a * c.a);
      } else if (kind == 11) {  // fire under a word: x0, x1, run, ui; its line's y
        vec4 x = S[j * 6u + 3u];
        float ui = max(q.w, 1e-3);
        float v = flameLine(vec2(p.x / ui, (x.y - p.y) / ui), q.x / ui, q.y / ui, q.z, c.a, Cur.w);
        if (v > .002) acc = over(acc, vec3(1.), min(v, 1.));
      } else if (kind == 12) {  // a line of light: x0, x1, seen from, to; its y, glow, ui
        vec4 x = S[j * 6u + 3u];
        float w = max(q.y - q.x, 1.);
        float px = (p.x - q.x) / w;
        float dy = abs(p.y - x.y);
        if (px < -.1 || px > 1.1 || dy > 14. * x.w) continue;
        float on = step(q.z, px) * step(px, q.w);
        float grad = mix(1., .75, smoothstep(0., .7, px)) * (1. - smoothstep(.7, 1., px));
        float core = smoothstep(.9, .3, dy) * grad * on;
        float glow = exp(-dy / (4. * x.w)) * .32 * grad * smoothstep(q.z - .02, q.z + .02, px) * smoothstep(q.w + .02, q.w - .02, px) * x.z;
        float v = (core + glow) * c.a;
        if (v > .002) acc = over(acc, vec3(1.), min(v, 1.));
      } else if (kind == 13) {  // a picture from the menus' atlas
        vec4 x = S[j * 6u + 3u];
        float a = clamp(.5 - box(p, r, x.w), 0., 1.);
        if (a <= 0.) continue;
        vec2 t = clamp((p - r.xy) / max(r.zw - r.xy, vec2(1e-3)), 0., 1.);
        vec2 at = mix(q.xy, q.zw, t);
        at = x.y > .5 ? floor(at) + .5 : clamp(at, q.xy + .5, q.zw - .5);
        vec4 col = textureLod(Pics, at / vec2(textureSize(Pics, 0)), 0.);
        float lum = dot(col.rgb, vec3(.2126, .7152, .0722));
        vec3 rgb = mix(vec3(lum), col.rgb, x.z) * c.rgb;
        acc = over(acc, rgb, col.a * c.a * a);
      } else if (kind == 14) {  // an icon
        vec2 u = (p - r.xy) / max(r.zw - r.xy, vec2(1e-3)) * 16.;
        if (u.x < -1. || u.y < -1. || u.x > 17. || u.y > 17.) continue;
        float sd = abs(q.x - 45.) < .5 ? keysIcon(u, q.y) : (q.x > 45.5 && q.x < 48.5) ? tutIcon(u, q.x, q.y) : icon(u, q.x);
        float a = clamp(.5 - sd * (r.z - r.x) / 16., 0., 1.);
        if (a > 0.) acc = over(acc, c.rgb, c.a * a);
      } else if (kind == 15) {  // the music's record
        float R = (r.z - r.x) * .5;
        vec2 dd = vec2(p.x - (r.x + R), (r.y + R) - p.y);
        float rr = length(dd) / R;
        if (rr >= 1.03) continue;
        float cov = clamp((1. - rr) * R + .5, 0., 1.) * c.a;
        float an = atan(dd.y, dd.x);
        float groove = .5 + .5 * sin(rr * R * 1.9);
        float sheen = pow(abs(cos(an - .7)), 14.) * smoothstep(.38, .5, rr) * (1. - smoothstep(.9, .99, rr));
        float v = .045 + .035 * groove * smoothstep(.36, .42, rr) + .5 * sheen + .05 * smoothstep(.97, 1., rr);
        float label = 1. - smoothstep(.335, .35, rr);
        vec2 rot = mat2(cos(q.x), sin(q.x), -sin(q.x), cos(q.x)) * dd / R;
        float mark = (1. - smoothstep(.012, .03, abs(rot.y))) * smoothstep(.13, .15, rot.x) * (1. - smoothstep(.27, .29, rot.x));
        v = mix(v, .8 - .14 * rr - .45 * mark, label);
        v *= smoothstep(.045, .065, rr);
        acc = over(acc, vec3(v), cov);
      } else if (kind == 16) {  // a shade: soft edges, deeper to a side
        float d = box(p, r, 0.);
        float a = 1. - smoothstep(-q.x, 0., d);
        if (a <= 0.) continue;
        vec2 t = clamp((p - r.xy) / max(r.zw - r.xy, vec2(1.)), 0., 1.);
        float s = q.y < .5 ? 1. : q.y < 1.5 ? 1. - t.x : q.y < 2.5 ? t.x : t.y;
        a *= s * c.a;
        if (a > .002) acc = over(acc, c.rgb, a);
      }
    }
  }
  if (laying) acc = over(acc, sc.rgb, sc.a * sa);
  acc = burning(acc, p);
  if (px.x < int(Size.x) && px.y < int(Size.y)) {
    acc *= Look.w;
    // half a step of noise under the last bit (interleaved gradient noise): the dark glass's faint light and its blur
    // without bands
    float dn = fract(52.9829189 * fract(dot(vec2(px), vec2(.06711056, .00583715))));
    acc.rgb += (dn - .5) / 255. * acc.a;
    imageStore(Out, px, acc.a > 1e-4 ? vec4(clamp(acc.rgb / acc.a, 0., 1.), clamp(acc.a, 0., 1.)) : vec4(0.));
  }
}
