// The glass's blur, up: the smaller level spread with a tent of nine taps (in its own texels), in place of this one.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D Src;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D Level;
layout(push_constant) uniform Step {
    vec4 Info;     // the source's texel (x, y), this level's size
    vec4 Area;     // where it is needed (the window): its corner in this level's texels
};
void main(){
  ivec2 q = ivec2(gl_GlobalInvocationID.xy) + ivec2(Area.xy);
  if (q.x >= int(Info.z) || q.y >= int(Info.w)) return;
  vec2 uv = (vec2(q) + .5) / Info.zw; vec2 t = Info.xy;
  vec3 c = textureLod(Src, uv, 0.).rgb * 4.
    + (textureLod(Src, uv + vec2(t.x, 0.), 0.).rgb + textureLod(Src, uv - vec2(t.x, 0.), 0.).rgb + textureLod(Src, uv + vec2(0., t.y), 0.).rgb + textureLod(Src, uv - vec2(0., t.y), 0.).rgb) * 2.
    + textureLod(Src, uv + t, 0.).rgb + textureLod(Src, uv - t, 0.).rgb + textureLod(Src, uv + vec2(t.x, -t.y), 0.).rgb + textureLod(Src, uv + vec2(-t.x, t.y), 0.).rgb;
  imageStore(Level, q, vec4(c / 16., 1.));
}
