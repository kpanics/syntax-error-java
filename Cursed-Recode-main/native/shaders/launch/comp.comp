#define LINES 12
// The picture put together: scene, the light over it (fx.comp), sparks, glow; the title (v12: CURSED rewritten into
// RECODE, crisp; its heat is in the light); the fire under the hovered word and the menu's lines of light; over all,
// the world's frame in blocks (the only colour). Light only otherwise (the menu is black and white).
// From the preview's FS_COMP; sizes in ui px (U: picture px per ui px), positions given in picture px, y up.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D uScene;
layout(set = 0, binding = 2) uniform sampler2D uPart;
layout(set = 0, binding = 3) uniform sampler2D uBloom;
layout(set = 0, binding = 4) uniform sampler2D uAtlas;      // the title's letters (tools/title_atlas.py)
layout(set = 0, binding = 5) uniform sampler2D uRaySrc;
layout(set = 0, binding = 6) uniform sampler2D uTrail;
layout(set = 0, binding = 7, rgba8) uniform writeonly image2D Out;
layout(set = 0, binding = 9, r32ui) uniform uimage2D TextCov;
layout(set = 0, binding = 10, r32ui) uniform uimage2D TextGlow;
layout(set = 0, binding = 11) uniform sampler2D uBlurred;   // the scene blurred (the menus' background blur)
layout(set = 0, binding = 12) uniform sampler2D uFx;        // the light over the world (fx.comp)
layout(set = 0, binding = 13) uniform sampler2D uWorld;     // the world's frame (going into a world, leaving one)
const float CW = 160., CH = 224., BL = 190.;
float glyph(int cell, vec2 p, int i, float drop, float lod){
  float cx = Title.x + (float(i) + .5) * Title2.x;
  float yb = Title.y + Title2.y - drop;
  float ax = (p.x - cx) / Title.z + CW * .5;
  float ay = BL - (p.y - yb) / Title.z;
  if (ax < 0. || ax > CW || ay < 0. || ay > CH) return 0.;
  return textureLod(uAtlas, vec2((float(cell) * CW + ax) / (12. * CW), ay / CH), lod).r;
}
layout(set = 0, binding = 8, std140) uniform Menu {
    vec4 Lines[LINES * 2];   // per line: x0, y, x1, strength; drawn from (of the width), drawn to, glow, -
    vec4 Icons[3];           // the music's buttons: x, y (bottom left, y up), size, kind (0 back, 1 pause, 2 play, 3 next; <0 none)
    vec4 IconLight;          // their brightness, and their strength in w
    vec4 Disc;               // the music's record: x, y (bottom left, y up), size, strength
    vec4 Disc2;              // its turn (rad), whether it plays
};
// The preview's svg icons (16 × 16, y down): the distance to a segment, to a triangle.
float sdSeg(vec2 p, vec2 a, vec2 b){ vec2 pa = p - a, ba = b - a; float h = clamp(dot(pa, ba) / dot(ba, ba), 0., 1.); return length(pa - ba * h); }
float sdTri(vec2 p, vec2 a, vec2 b, vec2 c){
  vec2 e0 = b - a, e1 = c - b, e2 = a - c, v0 = p - a, v1 = p - b, v2 = p - c;
  vec2 q0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0., 1.), q1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0., 1.), q2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0., 1.);
  float s = sign(e0.x * e2.y - e0.y * e2.x);
  vec2 d = min(min(vec2(dot(q0, q0), s * (v0.x * e0.y - v0.y * e0.x)), vec2(dot(q1, q1), s * (v1.x * e1.y - v1.y * e1.x))), vec2(dot(q2, q2), s * (v2.x * e2.y - v2.y * e2.x)));
  return -sqrt(d.x) * sign(d.y);
}
float icon(vec2 u, float kind){
  // u: 0..16, y down
  if (kind < .5) return min(sdSeg(u, vec2(4, 3), vec2(4, 13)) - .6, sdTri(u, vec2(13, 3), vec2(6, 8), vec2(13, 13)) - .6);
  if (kind < 1.5) return min(sdSeg(u, vec2(5, 3), vec2(5, 13)), sdSeg(u, vec2(11, 3), vec2(11, 13))) - 1.1;
  if (kind < 2.5) return sdTri(u, vec2(4, 2.5), vec2(13, 8), vec2(4, 13.5));
  return min(sdSeg(u, vec2(12, 3), vec2(12, 13)) - .6, sdTri(u, vec2(3, 3), vec2(10, 8), vec2(3, 13)) - .6);
}
#define uSqueeze Comp0.x
#define uBloomK Comp0.y
#define uTrailK Comp0.z
#define uMenuShade Comp0.w
#define uCornerShade Comp1.x
#define uFade Comp1.y
#define uRays Comp1.w
#define uStreak Comp2.x
#define uLkA LkA
#define uLkM LkM
#define uHovA HovA

float flameLine(vec2 f, vec4 h, float a){
  // f, h in ui px
  if (a <= 0.) return 0.;
  float px = (f.x - h.x) / max(h.z - h.x, 1.);
  float dy = f.y - h.y;
  if (px < -.05 || px > 1.05 || dy < -4. || dy > 110.) return 0.;
  float rev = smoothstep(h.w + .03, h.w - .1, px) * smoothstep(-.05, .03, px) * smoothstep(1.05, .96, px);
  // tongues of fire, each its own height, narrowing and melting upward, swaying; thin tall threads over them
  float xs = f.x * .045 + 1.1 * fbm2(vec2(f.x * .018, dy * .028 - uTime * 1.7));
  float cell = floor(xs), fx = fract(xs) - .5;
  float hh = 12. + 58. * pow(vn2(vec2(cell * 1.7, uTime * 2.3)), 2.);
  float rise = clamp(dy / hh, 0., 1.);
  float w = .38 * pow(1. - rise, .8) + .04;
  float tongue = smoothstep(w, 0., abs(fx + .16 * sin(dy * .09 - uTime * 6.5 + cell * 2.3))) * pow(1. - rise, 1.3) * step(0., dy);
  float xs2 = f.x * .09 + 1.4 * fbm2(vec2(f.x * .03 + 7., dy * .04 - uTime * 2.4));
  float c2 = floor(xs2), f2 = fract(xs2) - .5;
  float h2 = 24. + 80. * pow(vn2(vec2(c2 * 2.9, uTime * 1.9 + 5.)), 3.);
  float r2 = clamp(dy / h2, 0., 1.);
  float wisp = smoothstep(.1 * (1. - r2) + .02, 0., abs(f2 + .2 * sin(dy * .12 - uTime * 7. + c2))) * pow(1. - r2, 1.6) * step(0., dy) * .55;
  float base = exp(-dy * dy / 3.) * .32 + exp(-max(dy, 0.) / 8.) * .22 * step(-1., dy);
  return (tongue * 1.15 + wisp + base) * rev * a;
}
// A line of light under a word: white, fading out over its last third, with a soft glow round it.
float lightLine(vec2 f, vec4 la, vec4 lb){
  float w = max(la.z - la.x, 1.);
  float px = (f.x - la.x) / w;
  float dy = abs(f.y - la.y);
  if (px < -.1 || px > 1.1 || dy > 14. * Comp1.z) return 0.;
  float on = step(lb.x, px) * step(px, lb.y);
  float grad = mix(1., .75, smoothstep(0., .7, px)) * (1. - smoothstep(.7, 1., px));
  float core = smoothstep(.9, .3, dy) * grad * on;
  float glow = exp(-dy / (4. * Comp1.z)) * .32 * grad * smoothstep(lb.x - .02, lb.x + .02, px) * smoothstep(lb.y + .02, lb.y - .02, px) * lb.z;
  return (core + glow) * la.w;
}
void main(){
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  vec2 uRes = Size.zw;
  if (q.x >= int(uRes.x) || q.y >= int(uRes.y)) return;
  vec2 frag = vec2(float(q.x) + .5, uRes.y - float(q.y) - .5);   // picture px, y up
  vec2 iuv = (vec2(q) + .5) / uRes;                               // where to read the pictures (row 0 at the top)
  vec2 uv = frag / uRes;
  float ar = uRes.x / uRes.y;
  vec3 sc = textureLod(uScene, iuv, 0.).rgb;
  if (uBlurK > 0.) sc = mix(sc, textureLod(uBlurred, iuv, 0.).rgb, uBlurK);
  vec3 c = sc + textureLod(uFx, iuv, 0.).rgb + textureLod(uPart, iuv, 0.).rgb + textureLod(uBloom, iuv, 0.).rgb * .5 * uBloomK + textureLod(uTrail, iuv, 0.).rgb * uTrailK;
  // rays from the light through clouds, ridges and haze
  if (uRays > 0.) c += textureLod(uRaySrc, iuv, 0.).rgb * uRays;
  // a film flare: a horizontal streak through the hottest
  if (uStreak > 0.) {
    vec3 sb = vec3(0.);
    for (int i = -14; i <= 14; i++) { float k = float(i); sb += textureLod(uBloom, iuv + vec2(k * .011, 0.), 0.).rgb * exp(-abs(k) * .2); }
    c += sb * uStreak * .085;
  }
  float l = dot(c, vec3(.299, .587, .114)) * uExpo;
  l = 1. - exp(-l * 1.25);
  l = mix(l, l * l * (3. - 2. * l), .35);
  // the menu on the left and the widgets on the right: the world under them a little darker
  float side = mix(1. - uMenuShade, 1., smoothstep(.04, .48, uv.x));
  vec2 a = uv * vec2(ar, 1.);
  float corner = exp(-pow(length((a - vec2(ar - .16, .12)) * vec2(.85, 1.6)) / .2, 2.)) + exp(-pow(length((a - vec2(ar - .12, .94)) * vec2(.9, 2.)) / .14, 2.));
  float vig = smoothstep(1.3 - .55 * uSqueeze, .35 - .25 * uSqueeze, length((uv - .5) * vec2(1.15, 1.)));
  l *= side * mix(.55 - .5 * uSqueeze, 1., vig) * (1. - uCornerShade * Knob5.y * min(corner, 1.));
  // the menus' screens: the world a little darker, more on the right where their pictures and lists are
  l *= 1. - uDim;
  l *= mix(1., 1. - uRightShade, smoothstep(.3, .7, uv.x));
  // the title: the old letter goes down into the line, the new rises out of it; nothing under the line
  float txt = 0.;
  vec2 fc = frag / Comp1.z;
  if (Title.w > 0. && fc.y >= Title.y && abs(fc.x - (Title.x + Title2.x * 3.)) < Title2.x * 3.4) {
    float lod = max(0., log2(1. / (Title.z * Comp1.z)) - .25);
    for (int i = 0; i < 6; i++) {
      vec4 L = Lt[i];
      float go = glyph(i, fc, i, L.x * Title2.z * 1.15, lod) * (1. - smoothstep(.85, 1., L.x));
      float gn = glyph(6 + i, fc, i, (1. - L.y) * Title2.z * 1.15, lod) * smoothstep(0., .08, L.y);
      txt = max(txt, max(go * (.86 + .14 * L.w), gn * (.86 + .14 * min(L.z * 2., 1.))));
    }
    txt *= Title.w * Knob5.x;
  }
  // the line under the word: thin and crisp
  if (RuleC.w > 0.) {
    float mid = (RuleC.x + RuleC.y) * .5, hw = (RuleC.y - RuleC.x) * .5;
    float drawn = smoothstep(hw * RuleC.w + 1., hw * RuleC.w - 1., abs(fc.x - mid));
    txt = max(txt, drawn * exp(-pow((fc.y - RuleC.z) / .7, 2.)) * .62 * Title.w * Knob5.x);
  }
  // the fire under the word the cursor is on
  txt += flameLine(fc, Hov0 / vec4(Comp1.zzz, 1.), uHovA.x) + flameLine(fc, Hov1 / vec4(Comp1.zzz, 1.), uHovA.y);
  // the menu's lines of light: drawn left to right, gone to the right
  for (int i = 0; i < LINES; i++) {
    vec4 la = Lines[i * 2], lb = Lines[i * 2 + 1];
    if (la.w <= 0.) continue;
    txt += lightLine(frag, la, lb);
  }
  l = 1. - (1. - l) * (1. - min(txt, 1.));
  // the menu's text (text.comp) over all of it, its glow first; the sums are cleared for the next frame
  uint tc = imageLoad(TextCov, q).r, tg = imageLoad(TextGlow, q).r;
  if (tc != 0u || tg != 0u) {
    imageStore(TextCov, q, uvec4(0u));
    imageStore(TextGlow, q, uvec4(0u));
    float cov = float(tc >> 8) / 65535., bright = float(tc & 255u) / 255., glow = float(tg) / 65535.;
    l = 1. - (1. - l) * (1. - glow * .32);
    l = mix(l, bright, cov);
  }
  // the music's buttons
  for (int i = 0; i < 3; i++) {
    vec4 ic = Icons[i];
    if (ic.w < 0. || ic.z <= 0.) continue;
    vec2 u = vec2(frag.x - ic.x, ic.y + ic.z - frag.y) / ic.z * 16.;
    if (u.x < -1. || u.y < -1. || u.x > 17. || u.y > 17.) continue;
    float cov = clamp(.5 - icon(u, ic.w) * ic.z / 16., 0., 1.) * IconLight.w;
    l = mix(l, IconLight[i], cov);
  }
  // the music's record: black vinyl, its grooves, a still sheen sweeping over them as it turns, a pale label with
  // a mark that turns with it, the hole
  if (Disc.w > 0.) {
    float R = Disc.z * .5;
    vec2 dd = frag - (Disc.xy + R);
    float rr = length(dd) / R;
    if (rr < 1.03) {
      float cov = clamp((1. - rr) * R + .5, 0., 1.) * Disc.w;
      float a = atan(dd.y, dd.x);
      float groove = .5 + .5 * sin(rr * R * 1.9);
      float sheen = pow(abs(cos(a - .7)), 14.) * smoothstep(.38, .5, rr) * (1. - smoothstep(.9, .99, rr));
      float v = .045 + .035 * groove * smoothstep(.36, .42, rr) + .5 * sheen + .05 * smoothstep(.97, 1., rr);
      float label = 1. - smoothstep(.335, .35, rr);
      vec2 rot = mat2(cos(Disc2.x), sin(Disc2.x), -sin(Disc2.x), cos(Disc2.x)) * dd / R;
      float mark = (1. - smoothstep(.012, .03, abs(rot.y))) * smoothstep(.13, .15, rot.x) * (1. - smoothstep(.27, .29, rot.x));
      v = mix(v, .8 - .14 * rr - .45 * mark, label);
      v *= smoothstep(.045, .065, rr);
      l = mix(l, v, cov);
    }
  }
  l += (hq(frag, 7.) - .5) / 255.;   // rounding only: half a step of light, still (no grain)
  // hardcore: the glow and all that is bright a deep red (the only colour of the menu's world)
  float lw = max(l, 0.) * uFade;
  vec3 tint = mix(vec3(1.), vec3(1., .26, .2), uHard * smoothstep(.015, .3, lw));
  vec3 rgb = lw * tint;
  // the world's frame in blocks (a block a 16th of the height): put together from the line outward, crumbling to it
  if (WorldA.x > 0.) {
    vec2 view = Tip.zw;
    float lineY = WorldB.x;
    float B = view.y / 16.;
    vec2 cellI = floor((fc - vec2(view.x * .5, lineY)) / B);
    vec2 cc = (cellI + .5) * B + vec2(view.x * .5, lineY);
    float dRow = abs(cc.y - lineY) / view.y;
    float dCol = abs(cc.x - view.x * .5) / view.x;
    float j = hash12(cellI + 7.3);
    float k;
    if (WorldA.z > 0.) k = clamp((WorldA.y - (dRow * 1.35 + dCol * .25 + j * .14)) / .45, 0., 1.);
    else k = 1. - clamp((WorldA.y - ((.62 - dRow) * 1.55 + (.5 - dCol) * .18 + j * .16)) / .4, 0., 1.);
    float sc2 = WorldA.z > 0. ? 1. - pow(1. - k, 3.) : k * k * (3. - 2. * k);
    // a block grows from its middle (moving a little off the line); crumbling, it shrinks and falls toward it
    vec2 toLine = vec2(0., lineY - cc.y) * (1. - sc2) * .18;
    vec2 local = (fc - cc - toLine) / max(sc2, 1e-3);
    float inside = step(abs(local.x), B * .5) * step(abs(local.y), B * .5) * step(.001, sc2);
    vec2 src = cc + local;
    vec2 wuv = vec2(src.x / view.x, 1. - src.y / view.y) * WorldUV.xy + WorldUV.zw;
    vec3 w = textureLod(uWorld, wuv, 0.).rgb;
    float g = dot(w, vec3(.299, .587, .114));
    w = mix(w, vec3(g * .9), WorldA.w);
    w *= .55 + .45 * sc2;
    // its edge glows while it moves
    float edge = 1. - smoothstep(0., B * .06, min(B * .5 - abs(local.x), B * .5 - abs(local.y)));
    w += vec3(edge * sc2 * (1. - sc2) * 1.4);
    rgb = mix(rgb, w, inside * WorldA.x);
  }
  imageStore(Out, q, vec4(rgb, 1.));
}