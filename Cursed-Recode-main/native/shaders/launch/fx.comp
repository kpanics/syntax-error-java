// The light over the world (v12, HDR, added): the wings drawn stroke by stroke from the tip and opening into the
// horizon, the ember in the tip, the horizon's line, the line under the word and the point burning along it, the
// letters' heat. Ui px, y up (the preview's css px). From the preview's FS_FX.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D Fx;
layout(set = 0, binding = 2) uniform sampler2D uScene;
layout(set = 0, binding = 3) uniform sampler2D uLogoBase;
layout(set = 0, binding = 4) uniform sampler2D uAtlas;

const vec2 LB = vec2(.509, .866);
// the logo's fire: its shape and heat are her logo's; the feathers are drawn by strokes out from the tip (st: the
// strokes' seconds)
float logoFire(vec2 uv, float t, float st, float spreadK){
  if (uv.x < -.25 || uv.x > 1.25 || uv.y < -.35 || uv.y > 1.1) return 0.;
  vec2 q = uv - LB;
  float r = length(q);
  float th = atan(q.x, -q.y);
  vec2 w = vec2(gn2(vec2(th * 7., r * 9. - t * 1.7)), gn2(vec2(th * 7. + 9.1, r * 9. - t * 1.7)));
  w += .5 * vec2(gn2(vec2(th * 17., r * 22. - t * 2.6)), gn2(vec2(th * 17. + 3.3, r * 22. - t * 2.6)));
  float B = textureLod(uLogoBase, uv + w * .016 * smoothstep(.02, .25, r) * (1. - .7 * spreadK), 0.).r;
  vec2 fp = vec2(th * 15., r * 3.2 - t * .8);
  fp.x += .9 * gn2(vec2(th * 4., r * 3. - t * .5));
  float fil = 0., amp = 1.;
  for (int k = 0; k < 3; k++) {
    fil += pow(clamp(1. - abs(gn2(fp) * 2.5), 0., 1.), 10.) * amp;
    fp = fp * vec2(1.9, 1.5) + vec2(5.3, 2.9); amp *= .6;
  }
  float body = smoothstep(.03, .95, B);
  float core = smoothstep(.55, 1., B) * (1. - smoothstep(.1, .5, r));
  float e = body * body * 1.55 * (.4 + .95 * fil) + smoothstep(.05, .45, B) * fil * .8 + core * 1.6;
  float band = smoothstep(.0, .08, B) * smoothstep(.45, .1, B);
  e += pow(clamp(1. - abs(gn2(vec2(th * 22., r * 7. - t * 1.2) + w * 3.) * 3.), 0., 1.), 14.) * band * 1.6;
  // the strokes: from the tip along each feather, the inner first, then the outer; a bright head ahead of each
  float a = abs(th);
  float delay = clamp(a - .14, 0., 1.2) * .78 + .1 * vn2(vec2(a * 16., 3.));
  float g = clamp((st - delay) / .55, 0., 1.);
  g = 1. - pow(1. - g, 3.);
  float front = g * .9 - .025 * gn2(vec2(th * 30., t * 3.));
  float alive = smoothstep(front + .012, front - .07, r);
  float head = exp(-pow((r - front) / .02, 2.)) * smoothstep(.04, .5, B) * (1. - g * g) * 3.2 * step(.001, g);
  return e * alive + head;
}
const float CW = 160., CH = 224., BL = 190.;
float glyph(int cell, vec2 p, int i, float drop, float lod){
  float cx = Title.x + (float(i) + .5) * Title2.x;
  float yb = Title.y + Title2.y - drop;
  float ax = (p.x - cx) / Title.z + CW * .5;
  float ay = BL - (p.y - yb) / Title.z;
  if (ax < 0. || ax > CW || ay < 0. || ay > CH) return 0.;
  return textureLod(uAtlas, vec2((float(cell) * CW + ax) / (12. * CW), ay / CH), lod).r;
}
void main(){
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  if (q.x >= int(Size.x) || q.y >= int(Size.y)) return;
  float px = FxA.y;
  vec2 p = vec2(float(q.x) + .5, Size.y - float(q.y) - .5) / px;
  vec2 tip = Tip.xy;
  float e = 0.;
  // the wings: opening, each turns toward the horizontal, stretches and thins
  if (LogoF.y > 0.) {
    vec2 qq = p - tip;
    float sp = LogoF.w;
    float side = qq.x < 0. ? -1. : 1.;
    float rot = side < 0. ? 1.103 : -1.103;                    // to the horizontal: each wing by 63 degrees
    float a = -rot * sp;
    vec2 qr = vec2(qq.x * cos(a) - qq.y * sin(a), qq.x * sin(a) + qq.y * cos(a));
    vec2 ax = normalize(vec2(.332 * side, .657));
    vec2 pe = vec2(-ax.y, ax.x);
    float along = dot(qr, ax), across = dot(qr, pe);
    float stretch = 1. + sp * sp * 7.5, thin = 1. + sp * 4.;
    vec2 q0 = ax * (along / stretch) + pe * (across * thin);
    vec2 uv = vec2(q0.x / LogoF.x + LB.x, LB.y - q0.y / LogoF.x);
    float lf = logoFire(uv, uTime, LogoF.z, sp);
    // opening, the wings burn brighter and evener: they become the line
    e += lf * LogoF.y * (1. + .9 * sin(3.14159 * min(sp * 1.1, 1.)));
  }
  // the ember in the tip: what is left of the spark
  if (FxA.x > 0.) {
    float r = length(p - tip);
    float tw = .82 + .18 * sin(uTime * 19.) * sin(uTime * 5.3 + 1.3);
    e += (exp(-r * r / 3.) * 3. + exp(-r / 5.) * .9 + exp(-r / 26.) * .2) * FxA.x * tw;
  }
  // the horizon's line: out of the wings; then the light goes behind the ridges and becomes the glow
  if (HL.z > 0.) {
    float dy = p.y - tip.y;
    float a = tip.x - HL.x, b = tip.x + HL.y;
    float inside = smoothstep(a - 2., a + 24., p.x) * smoothstep(b + 2., b - 24., p.x);
    float prof = mix(1., exp(-pow((p.x - tip.x) / (Tip.z * .3), 2.)) * 1.3, HL.w);
    float l = exp(-dy * dy / 1.1) * 1.7 + exp(-abs(dy) / 5.) * .32 + exp(-abs(dy) / 36.) * .07;
    float m = smoothstep(9000., 9999., texelFetch(uScene, q, 0).a);   // behind the world it is hidden
    e += l * inside * prof * HL.z * m;
  }
  // the line under the word: drawn out from its middle; behind the burning point a molten trail
  if (RuleF.w > 0.) {
    float dy = p.y - RuleF.z;
    float mid = (RuleF.x + RuleF.y) * .5;
    float hw = (RuleF.y - RuleF.x) * .5;
    float drawn = smoothstep(hw * RuleF.w + 1., hw * RuleF.w - 1., abs(p.x - mid));
    float fresh = (1. - RuleF.w) * 2.;
    e += drawn * (exp(-dy * dy / 1.2) * (.35 + fresh) + exp(-abs(dy) / 4.) * .07);
    if (PointF.y > 0.) {
      float dx = p.x - PointF.x;
      float d2 = dx * dx + dy * dy;
      float fl = .78 + .22 * vn2(vec2(uTime * 11., 3.));
      e += (exp(-d2 / 3.5) * 5.5 + exp(-sqrt(d2) / 7.) * 1.1 + exp(-sqrt(d2) / 34.) * .22) * PointF.y * fl;
      float back = max(-dx, 0.);
      float trail = exp(-back / max(PointF.z, 1.)) * step(dx, 0.) * step(RuleF.x - 1., p.x);
      e += trail * (exp(-dy * dy / 1.4) * 1.6 + exp(-abs(dy) / 3.) * .2) * PointF.w * fl;
    }
  }
  // the letters' heat: the new rise red-hot and cool, the old darken going into the line
  if (Title.w > 0.) {
    float lod = max(0., log2(1. / (Title.z * px))) + 3.2;
    float clipY = Title.y;
    if (p.y > clipY - 2. && abs(p.x - (Title.x + Title2.x * 3.)) < Title2.x * 3.6) {
      for (int i = 0; i < 6; i++) {
        vec4 L = Lt[i];
        if (L.z <= .003 && L.w <= .003) continue;
        float hn = glyph(6 + i, p, i, (1. - L.y) * Title2.z * 1.15, lod) * L.z;
        float ho = glyph(i, p, i, L.x * Title2.z * 1.15, lod) * L.w;
        e += (hn * 1.8 + ho * .9) * step(clipY, p.y);
      }
    }
  }
  imageStore(Fx, q, vec4(vec3(e), 1.));
}
