// The menu's land, once, into a 384 × 768 map (x −192…191, z −64…703): a river down the valley, terraces,
// mountains; past 250 a lake. Heights in blocks / 255 in red.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D Height;

float riverX(float z){ return 7. * sin(z * .012) + 3. * sin(z * .031 + 1.3); }

void main(){
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  if (q.x >= 384 || q.y >= 768) return;
  vec2 p0 = vec2(float(q.x) - 192., float(q.y) - 64.) + .5;
  float dx = p0.x - riverX(p0.y);
  // a new world's terrain (menus/): its features' scale and the seed move what is under the valley
  vec2 p = p0 * uScale + uSeed;
  float vw = 15. + 5. * sin(p0.y * .017 + .7) + max(p0.y - 70., 0.) * .32;   // further on the valley opens to the lake
  float ad = abs(dx);
  float floorH = 7.4 + 1.4 * vn2(p * .11);
  float hills = 11. + 13. * fbm2(p * .021 + 3.1);
  float ridge = 1. - abs(fbm2(p * .015 + 7.7) * 2. - 1.);
  float mount = 9. + (hills - 9.) * mix(1., 1.6, clamp(uAmp - 1., 0., 1.)) + ridge * ridge * 22. * uAmp * smoothstep(vw * .8, vw * 3.2, ad);
  mount = floor(mount / 2.) * 2. + step(.72, vn2(p * .23));
  mount = mix(mount, 9. + (mount - 9.) * .45, smoothstep(80., 210., p0.y));
  float bank = smoothstep(vw * .32, vw * 1.15, ad);
  float h = mix(floorH, mount, bank);
  h = mix(h, 6.5 + 2.5 * vn2(p * .06), smoothstep(225., 285., p0.y));
  h = mix(h, 10., uFlat);                                                       // a flat world: all level, no water
  imageStore(Height, q, vec4(clamp(floor(h), 1., uTop - 1.) / 255., 0., 0., 1.));
}
