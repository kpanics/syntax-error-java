// The entrance's smoke: 30 thousand threads in a divergence-free flow hold the shape of her logo (their homes);
// the hold draws them into the ember in a spiral, the flash throws them off. State: position, velocity (ping-pong).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D State;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D Home;
layout(set = 0, binding = 3, rgba32f) uniform writeonly image2D Next;
#define uDt Sim.x
#define uSimTime Sim.y
#define uHold Sim.z
#define uBurst Sim.w
#define uAr Sim2.x
#define uInit Sim2.y
float h1(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float psi(vec2 p, float t){ return vn2(p * 1.7 + vec2(t * .07, -t * .11)) * .62 + vn2(p * 3.9 - vec2(t * .13, t * .05)) * .26 + vn2(p * 8.3 + vec2(t * .21, t * .17)) * .08; }
vec2 curl(vec2 p, float t){ const float e = .012; return vec2(psi(p + vec2(0., e), t) - psi(p - vec2(0., e), t), psi(p - vec2(e, 0.), t) - psi(p + vec2(e, 0.), t)) / (2. * e); }
void main(){
  ivec2 ij = ivec2(gl_GlobalInvocationID.xy);
  if (ij.x >= 192 || ij.y >= 160) return;
  vec4 st = imageLoad(State, ij), hm = imageLoad(Home, ij);
  vec2 p = st.xy, v = st.zw, home = hm.xy;
  float kind = hm.z, seed = hm.w;
  float rate = kind > .5 ? .16 + .1 * fract(seed * 7.3) : .07;
  float cyc = uSimTime * rate + seed, life = fract(cyc), lifePrev = fract((uSimTime - uDt) * rate + seed);
  if (uInit > .5 || life < lifePrev) {
    float a = h1(vec2(seed, floor(cyc))) * 6.2832, r = h1(vec2(seed * 3.1, floor(cyc)));
    if (uInit > .5) p = vec2(cos(a), sin(a)) * (.3 + 1.5 * sqrt(r)) * vec2(uAr, 1.);        // at the start: dust in the dark
    else if (uHold > .25) p = vec2(cos(a), sin(a)) * (1.2 + .5 * r) * vec2(uAr, 1.);        // drawn in: new ones come from all sides
    else p = home + vec2(cos(a), sin(a)) * .025 * r;
    v = vec2(0.);
  }
  vec2 F = curl(p, uSimTime) * (kind > .5 ? .07 : .16) + (home - p) * (kind > .5 ? 2.4 : .18);
  float rl = length(p) + 1e-4;
  float g = smoothstep(0., .7, uHold);
  // drawn in: a spiral that tightens straight into the ember as the hold grows (no orbits left circling it)
  F = mix(F, (-p / rl * (1.6 + 13. * uHold) + vec2(-p.y, p.x) / rl * (1.3 + .9 * uHold) * (1. - .7 * uHold)) / (.3 + rl), g);
  if (uBurst >= 0.) F += p / rl * 10. * exp(-uBurst * 3.);
  // near the ember a drawn-in thread loses its sideways speed: it goes in, it does not loop round it
  v = v * exp(-uDt * (2.6 - .6 * g + 7. * g * smoothstep(.7, .0, rl))) + F * uDt;
  imageStore(Next, ij, vec4(p + v * uDt, v));
}
