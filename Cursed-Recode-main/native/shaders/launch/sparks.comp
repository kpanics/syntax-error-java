// Sparks, each a soft point added into a fixed-point picture (launch/mod.rs resolves it): sparks off the point that
// burns along the line under the word (v12: they rise where it was, and go out), sparks off the burning line under the
// word the cursor is on. One invocation a spark; from the preview's VS_SP.
layout(local_size_x = 64) in;
layout(set = 0, binding = 1, r32ui) uniform uimage2D Acc;
layout(set = 0, binding = 2) uniform sampler2D Scene;

// Picture px (y up) to the scene's.
float K(){ return Size.x / Size.z; }
float U(){ return Comp1.z; }
float h1(float x){ return fract(sin(x * 127.1) * 43758.5453); }

void splat(vec2 px, float size, float vI, float dist){
  // px: scene px, y up; size: the point's side in scene px
  if (vI <= 0.) return;
  vec2 c = vec2(px.x, Size.y - px.y);
  float r = max(size * .5, .5);
  ivec2 lo = ivec2(floor(c - r)), hi = ivec2(ceil(c + r));
  for (int y = lo.y; y <= hi.y; y++) {
    for (int x = lo.x; x <= hi.x; x++) {
      if (x < 0 || y < 0 || x >= int(Size.x) || y >= int(Size.y)) continue;
      vec2 d = (vec2(x, y) + .5 - c) / r;
      if (abs(d.x) > 1. || abs(d.y) > 1.) continue;
      if (dist > 0. && texelFetch(Scene, ivec2(x, y), 0).a < dist - 1.) continue;   // behind the world
      float v = vI * exp(-dot(d, d) * 2.4);
      imageAtomicAdd(Acc, ivec2(x, y), uint(v * 4096.));
    }
  }
}

bool world(vec3 p, out vec2 px, out float dist){
  vec3 dd = p - uCam;
  float xc = dot(dd, uRight), yc = dot(dd, uUp), zc = dot(dd, uFwd);
  dist = length(dd);
  if (zc < .3) return false;
  vec2 ndc = vec2(xc / (uTanH * uAspect), yc / uTanH) / zc;
  px = (ndc * .5 + .5) * Size.xy;
  return true;
}
vec3 onLogo(vec2 uv){ return uLC + uLR * (uv.x - .5) * uLS + uLU * (.5 - uv.y) * uLS; }

void main(){
  float id = float(gl_GlobalInvocationID.x);
  float r1 = h1(id * 1.17 + .3), r2 = h1(id * 2.31 + .7), r3 = h1(id * 3.77 + .1);
  float uEmbers = Parts.x, uSet = Parts.y, uForge = Parts.z, uForgeA = Parts.w;
  if (id < 90.) {
    // the burning point: each spark born where the point was s seconds ago, rising and going out
    if (Spk.z <= 0.) return;
    float life = .7 + r1 * 1.3;
    float tt = uTime + r2 * life; float k = floor(tt / life), age = fract(tt / life);
    float s = age * life;
    vec2 px = vec2(Spk.x - Spk.w * s + (h1(id * 5.1 + k) - .5) * 6., Spk.y);
    px.x += sin(s * 3. + r3 * 9.) * 6. * s + (r1 - .5) * 30. * s;
    px.y += s * (22. + 60. * r3) - s * s * 14.;
    float vI = sin(age * 3.14159) * (.8 + 1.5 * r1) * Spk.z * smoothstep(0., .08, age);
    splat(px * FxA.y, (1.1 + 1.6 * r3) * FxA.y, vI, 0.);
  } else if (id < 420.) {
    return;   // (the flash scatters no sparks round the logo any more)
  } else if (id < 560.) {
    // (v11: the title forged, sparks off its rule)
    if (uForgeA <= 0.) return;
    vec4 lk = Lk / U();
    float life = .9 + r1 * 1.4;
    float tt = uForge + r2 * life; float k = floor(tt / life), age = fract(tt / life);
    float born = uForge - age * life;
    if (born < 0.) return;
    float spread = clamp(born / .75, 0., 1.) * Parts2.w;
    float x = lk.x + lk.z * (.5 + (h1(id * 5.1 + k) - .5) * 2. * spread);
    float s = age * life;
    vec2 px = vec2(x + sin(s * 3. + r3 * 9.) * 7. * s, lk.y + lk.w * Rule.x + s * (26. + 70. * r3) - s * s * 10.);
    splat(px * U() * K(), (1.2 + 1.8 * r3) * U() * K(), sin(age * 3.14159) * (1. + 1.6 * r1) * uForgeA, 0.);
  } else {
    // under the cursor: sparks rise off the burning line
    if (HovA.z <= 0.) return;
    vec4 hv = Hov0 / U();
    float life = .55 + r1 * .9;
    float tt = uTime + r2 * life; float k = floor(tt / life), age = fract(tt / life);
    float x = hv.x + (hv.z - hv.x) * h1(id * 4.7 + k) * Hov0.w;
    float s = age * life;
    vec2 px = vec2(x + sin(s * 4. + r3 * 7.) * 4., hv.y + s * (16. + 42. * r3));
    splat(px * U() * K(), (1. + 1.4 * r3) * U() * K(), sin(age * 3.14159) * (.5 + 1.1 * r1) * HovA.z, 0.);
  }
}
