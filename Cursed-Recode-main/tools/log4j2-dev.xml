<?xml version="1.0" encoding="UTF-8"?>
<!-- Лог для dev-запуска: цветная консоль (цвет выключается -Dfabric.log.disableAnsi=true) + run\logs\latest.log -->
<Configuration status="WARN">
  <Properties>
    <Property name="line">[%d{HH:mm:ss}] [%t/%level] (%logger{1}) %msg{nolookups}%n</Property>
  </Properties>
  <Appenders>
    <Console name="SysOut" target="SYSTEM_OUT">
      <PatternLayout disableAnsi="${sys:fabric.log.disableAnsi:-true}"
        pattern="%style{[%d{HH:mm:ss}]}{blue} %highlight{[%t/%level]}{FATAL=red, ERROR=red, WARN=yellow, INFO=green, DEBUG=green, TRACE=blue} %style{(%logger{1})}{cyan} %highlight{%msg{nolookups}%n}{FATAL=red, ERROR=red, WARN=normal, INFO=normal, DEBUG=normal, TRACE=normal}" />
    </Console>
    <RollingRandomAccessFile name="LatestFile" fileName="logs/latest.log" filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="${line}" />
      <Policies>
        <TimeBasedTriggeringPolicy />
        <OnStartupTriggeringPolicy />
      </Policies>
      <DefaultRolloverStrategy max="10" />
    </RollingRandomAccessFile>
  </Appenders>
  <Loggers>
    <Root level="all">
      <AppenderRef ref="SysOut" level="info" />
      <AppenderRef ref="LatestFile" level="info" />
    </Root>
  </Loggers>
</Configuration>
